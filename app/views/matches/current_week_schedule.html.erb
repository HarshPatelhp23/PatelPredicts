    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 10px;
  }
  
  .team-flag {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    margin-bottom: 8px;
  }
  
  .team-name {
    font-weight: 600;
    font-size: 0.9rem;
  }
  
  .versus {
    font-size: 0.9rem;
    color: var(--gray);
    padding: 0 10px;
  }
  
  .match-details {
    padding: 0 15px 15px;
    border-top: 1px solid rgba(0,0,0,0.05);
  }
  
  .stadium-info {
    display: flex;
    align-items: center;
    margin-bottom: 12px;
    font-size: 0.9rem;
    color: var(--gray);
  }
  
  .stadium-icon {
    color: var(--primary);
    margin-right: 8px;
  }
  
  .select-owner-btn {
    background-color: var(--secondary);
    color: white;
    border: none;
    border-radius: 30px;
    padding: 8px 20px;
    font-size: 0.9rem;
    font-weight: 500;
    /*width: 100%;*/
    transition: all 0.3s ease;
  }
  
  .select-owner-btn:hover {
    background-color: #e64a19;
  }
  
  .today-badge {
    position: absolute;
    top: 10px;
    right: 10px;
    background-color: var(--success);
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 20px;
    z-index: 5;
  }
  
  .dropdown-menu {
    border-radius: 10px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.1);
