    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
    border-radius: 15px;
    color: white;
    padding: 20px;
    margin-bottom: 20px;
    box-shadow: 0 4px 15px rgba(94, 53, 177, 0.2);
  }
  
