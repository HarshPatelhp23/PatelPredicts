<!-- views/matches/current_week_schedule.html.erb -->
<div class="container mt-5">
  <h1 class="text-center mb-4">Week: <%= @current_week_start_date.strftime('%d/%m/%Y') %> To <%= @current_week_end_date&.strftime('%d/%m/%Y') %></h1>
  <% set_button_name = params[:move_to_next_week] == 'true' ? 'Back to Current-Week' : 'Move to Next-Week Schedule' %>
  <% set_flag = params[:move_to_next_week] == 'true' ? 'false' : 'true' %>
  <center><%= link_to set_button_name, current_week_schedule_path(move_to_next_week: set_flag), class: 'btn theme-btn-color text-white mb-5', style: "text-decoration: none;" %></center>
</div>
<div class="matches-container">
  <% @current_week_matches.each do |match| %>
    <!-- Updated match-card section with enhanced stadium display and city column -->
<div class="match-card <%= match.match_date == Date.current ? 'today-match' : '' %>">
  <% if match.match_date == Date.current %>
    <div class="today-badge">TODAY</div>
  <% end %>
  <div class="match-date"><%= match.match_date.strftime('%d/%m') %></div>
    <div class="match-teams">
      <% teams = match.match_name.split(' vs ') %>
      <div class="team">
        <div class="team-name"><%= teams[0] %></div>
        <div class="team-name"><%= ipl_team_logo(teams[0], min_height: true) %></div>
          <!-- <#%= teams[0] = 'RSA' if teams[0] == 'SA' %> -->
        <!-- <div class="team-name"><#%= wc_team_logo(teams[0]) %></div> -->
      </div>
      <div class="versus">VS</div>
      <div class="team">
        <div class="team-name"><%= teams[1] %></div>
        <div class="team-name"><%= ipl_team_logo(teams[1], min_height: true) %></div>
        <!-- <div class="team-name"><#%= wc_team_logo(teams[1]) %></div> -->
      </div>
    </div>

    <div class="match-details">
      <div class="location-info">
        <div class="stadium-details">
          <div class="stadium-name">
            <i class="fas fa-landmark stadium-icon"></i>
            <span class="stadium-title"><%= match.stadium %></span>
          </div>
          <div class="stadium-city">
            <i class="fas fa-map-marker-alt city-icon"></i>
            <span class="city-name"><%= match.city %></span>
          </div>
        </div>
        <div class="match-time">
          <i class="far fa-clock time-icon"></i>
          <% match_time = match.time&.is_a?(String) ? match.time : match.time.strftime('%I:%M %p') %>
          <span class="time-value"><%= match_time %></span>
        </div>
      </div>

      <button class="select-owner-btn" type="button" data-bs-toggle="modal" data-bs-target="#ownerModal<%= match.id %>">
        Select Owner <i class="fas fa-users ms-1"></i>
      </button>
    </div>
  </div>
  <% end %>
</div> <!-- Closing matches-container properly -->

<!-- Match Modals -->
<% @current_week_matches.each do |match| %>
  <div class="modal fade" id="ownerModal<%= match.id %>" tabindex="-1" aria-labelledby="ownerModalLabel<%= match.id %>" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content shadow-lg border-0 rounded-4">

        <!-- Modal Header -->
        <div class="modal-header bg-dark text-white">
          <h5 class="modal-title" id="ownerModalLabel<%= match.id %>">
            <i class="fas fa-users me-2"></i> Select Owner for <span class="text-warning">
              <% team1, team2 = match.match_name.split(' vs ') %>
              <%= "#{match_country_code[team1]} vs #{match_country_code[team2]}" %></span>
          </h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <!-- Modal Body -->
        <div class="modal-body p-4">
          <div class="list-group custom-scroll">
            <% @pool_users.each do |user| %>
              <%= link_to match_players_path(match_name: match.match_name, user_id: user.id, auction_id: @auction&.id), 
                          class: "list-group-item list-group-item-action d-flex align-items-center p-3 shadow-sm rounded-3 user-item" do %>
                <img src="https://ui-avatars.com/api/?name=<%= user.username %>&size=50&background=random&rounded=true" 
                     alt="User Avatar" class="rounded-circle me-3 border" width="50">
                <div>
                  <div class="fw-bold fs-5"><%= user.username %></div>
                  <small class="text-muted">Click to view team details</small>
                </div>
                <i class="fas fa-chevron-right ms-auto text-muted"></i>
              <% end %>
            <% end %>
          </div>
        </div>

        <!-- Modal Footer -->
        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times"></i> Close
          </button>
        </div>

      </div>
    </div>
  </div>
<% end %>

<script>
  // Simple dropdown toggle function that doesn't rely on Bootstrap JS
  function toggleDropdown(id) {
    const dropdown = document.getElementById('dropdown-' + id);
    
    // Close all other dropdowns first
    document.querySelectorAll('.custom-dropdown-menu.show').forEach(function(menu) {
      if (menu.id !== 'dropdown-' + id) {
        menu.classList.remove('show');
      }
    });
    
    // Toggle current dropdown
    dropdown.classList.toggle('show');
  }
  
  // Close dropdowns when clicking outside
  document.addEventListener('click', function(event) {
    if (!event.target.matches('.select-owner-btn') && !event.target.closest('.select-owner-btn')) {
      document.querySelectorAll('.custom-dropdown-menu.show').forEach(function(dropdown) {
        dropdown.classList.remove('show');
      });
    }
  });
</script>
<style>
