<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fantasy Cricket - Points Table</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <style>
    :root {
      --primary: #2563eb;
      --primary-dark: #1d4ed8;
      --secondary: #4f46e5;
      --accent: #8b5cf6;
      --background: #f8fafc;
      --card-bg: #ffffff;
      --text-primary: #1e293b;
      --text-secondary: #64748b;
      --success: #10b981;
      --warning: #f59e0b;
      --danger: #ef4444;
      --border-light: #e2e8f0;
    }
    
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: var(--background);
      color: var(--text-primary);
      margin: 0;
      padding: 0;
      line-height: 1.6;
    }
    
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1rem;
    }
    
    .header {
      margin-bottom: 2.5rem;
    }
    
    .header h1, .header h2 {
      position: relative;
      display: inline-block;
      color: var(--text-primary);
      font-weight: 700;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
    }
    
    .header h1::after, .header h2::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 60%;
      height: 4px;
      background: linear-gradient(90deg, var(--primary) 0%, var(--accent) 100%);
      border-radius: 5px;
    }
    
    .page-title {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
    }
    
    .page-title i {
      color: var(--primary);
      font-size: 1.75rem;
    }
    
    .card {
      background-color: var(--card-bg);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      height: 100%;
    }
    
    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }
    
    .card-header {
      padding: 1rem;
      font-weight: 600;
      font-size: 1.1rem;
    }
    
    .theme-light-color {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    }
    
    .card-body {
      padding: 1.5rem;
    }
    
    .card-title {
      margin-top: 0;
      margin-bottom: 1rem;
      font-size: 1.25rem;
      color: var(--text-primary);
    }
    
    .points-table-container {
      background-color: var(--card-bg);
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
      margin-bottom: 3rem;
    }
    
    .table-wrapper {
      overflow-x: auto;
      border-radius: 12px;
    }
    
    .table {
      width: 100%;
      border-collapse: collapse;
    }
    
    .table thead {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      color: white;
    }
    
    .table th {
      padding: 1rem;
      font-weight: 600;
      text-transform: uppercase;
      font-size: 0.875rem;
      letter-spacing: 0.05em;
      border: none;
      white-space: nowrap;
    }
    
    .table td {
      padding: 1rem;
      vertical-align: middle;
      border-bottom: 1px solid var(--border-light);
      font-size: 1rem;
    }
    
    .table tbody tr {
      transition: background-color 0.3s ease;
    }
    
    .table tbody tr:hover {
      background-color: rgba(37, 99, 235, 0.05);
    }
    
    .table-primary {
      background-color: rgba(37, 99, 235, 0.1);
      position: relative;
    }
    
    .table-primary::after {
      content: 'Your Team';
      position: absolute;
      top: 0;
      right: 0;
      background-color: var(--primary);
      color: white;
      font-size: 0.7rem;
      padding: 0.2rem 0.5rem;
      border-bottom-left-radius: 5px;
      transform: translateY(-2px);
    }
    
    .rank-pill {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 35px;
      height: 35px;
      border-radius: 50%;
      background-color: #e5e7eb;
      color: var(--text-primary);
      font-weight: 600;
    }
    
    .rank-pill.top-4 {
      background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
      color: white;
    }
    
    .team-name {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 0.5rem;
    }
    
    .team-avatar {
      width: 40px;
      height: 40px;
      background-color: #e5e7eb;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      color: var(--text-primary);
    }
    
    .points-pill {
      display: inline-block;
      padding: 0.5rem 1rem;
      border-radius: 9999px;
      font-weight: 600;
      background-color: rgba(37, 99, 235, 0.1);
      color: var(--primary);
    }
    
    .penalty-pill {
      display: inline-block;
      padding: 0.35rem 0.75rem;
      border-radius: 9999px;
      font-weight: 600;
      font-size: 0.875rem;
    }
    
    .penalty-pill.none {
      background-color: #e5e7eb;
      color: var(--text-secondary);
    }
    
    .penalty-pill.penalty {
      background-color: rgba(239, 68, 68, 0.1);
      color: var(--danger);
    }
    
    .top-teams-heading {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      margin-bottom: 2rem;
    }
    
    .top-teams-heading i {
      color: var(--warning);
      font-size: 1.5rem;
    }
    
    .top-teams-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
    
    .podium-card {
      position: relative;
      overflow: hidden;
    }
    
    .position-badge {
      position: absolute;
      top: 10px;
      right: 10px;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-weight: 700;
      font-size: 1rem;
      z-index: 1;
    }
    
    .position-1 {
      background-color: #fbbf24;
      box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.3);
    }
    
    .position-2 {
      background-color: #9ca3af;
      box-shadow: 0 0 0 3px rgba(156, 163, 175, 0.3);
    }
    
    .position-3 {
      background-color: #d97706;
      box-shadow: 0 0 0 3px rgba(217, 119, 6, 0.3);
    }
    
    .position-4 {
      background-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.3);
    }
    
    .podium-card-body {
      position: relative;
      z-index: 0;
      padding: 2rem 1.5rem;
      text-align: center;
    }
    
    .podium-card-body::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-image: radial-gradient(circle at top right, rgba(79, 70, 229, 0.1) 0%, transparent 60%);
      z-index: -1;
    }
    
    .team-avatar-large {
      width: 80px;
      height: 80px;
      margin: 0 auto 1rem;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--primary) 0%, var(--accent) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 2rem;
      font-weight: 700;
    }
    
    .podium-team-name {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
      color: var(--text-primary);
    }
    
    .podium-team-points {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
      color: var(--primary-dark);
    }
    
    .points-ahead {
      background-color: rgba(16, 185, 129, 0.1);
      color: var(--success);
    }
    
    .points-behind {
      background-color: rgba(239, 68, 68, 0.1);
      color: var(--danger);
    }
    
    .btn {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      border-radius: 9999px;
      font-weight: 600;
      text-decoration: none;
      text-align: center;
      transition: all 0.3s ease;
      border: none;
      cursor: pointer;
    }
    
    .btn-primary {
      background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
      color: white;
      box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.5), 0 2px 4px -1px rgba(37, 99, 235, 0.06);
    }
    
    .btn-primary:hover {
      box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3), 0 4px 6px -2px rgba(37, 99, 235, 0.05);
      transform: translateY(-2px);
    }
    
    .back-button {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    
    .login-message {
      text-align: center;
      padding: 3rem 1rem;
      background-color: var(--card-bg);
      border-radius: 12px;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
    }
    
    .login-message h3 {
      margin-bottom: 1.5rem;
      color: var(--text-primary);
    }
    
    .animation-pulse {
      animation: pulse 2s infinite;
    }
    
    @keyframes pulse {
      0% {
        transform: scale(1);
      }
      50% {
        transform: scale(1.05);
      }
      100% {
        transform: scale(1);
      }
    }
    
    @keyframes podium-rise {
      0% {
        transform: translateY(20px);
        opacity: 0;
      }
      100% {
        transform: translateY(0);
        opacity: 1;
      }
    }
    
    .podium-card {
      animation: podium-rise 0.6s ease-out;
      animation-fill-mode: backwards;
    }
    
    .podium-card:nth-child(1) { animation-delay: 0.1s; }
    .podium-card:nth-child(2) { animation-delay: 0.2s; }
    .podium-card:nth-child(3) { animation-delay: 0.3s; }
    .podium-card:nth-child(4) { animation-delay: 0.4s; }
    
    .current-user-highlight {
      border: 2px solid var(--primary);
      box-shadow: 0 0 15px rgba(37, 99, 235, 0.3);
      position: relative;
      overflow: hidden;
    }
    
    .current-user-highlight::before {
      content: 'Your Team';
      position: absolute;
      top: 10px;
      right: -40px;
      background-color: var(--primary);
      color: white;
      transform: rotate(45deg);
      padding: 0.3rem 3rem;
      font-size: 0.7rem;
      text-align: center;
      z-index: 10;
    }
    
    .points-difference {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      white-space: nowrap;
    }
    
    /*.points-difference i {
      margin-right: 0.25rem;
    }*/
    
    @media (max-width: 768px) {
      .container {
        padding: 1rem;
      }
      
      .top-teams-row {
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1rem;
      }
      
      .team-avatar {
        width: 48px;
        height: 48px;
      }
      
      .table th, .table td {
        padding: 0.75rem 0.5rem;
      }
      
      .points-pill, .penalty-pill {
        padding: 0.3rem 0.6rem;
        font-size: 0.8rem;
      }
      
      .position-badge {
        width: 25px;
        height: 25px;
        font-size: 0.8rem;
      }
      
      .team-avatar-large {
        width: 60px;
        height: 60px;
        font-size: 1.5rem;
      }
      
      .podium-team-name {
        font-size: 1rem;
      }
      
      .podium-team-points {
        font-size: 1.2rem;
      }
      
      .points-difference {
        padding: 0.3rem 0.7rem;
        font-size: 0.8rem;
      }
    }
    
    @media (max-width: 480px) {
      .top-teams-row {
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      }
      
      .btn {
        padding: 0.6rem 1.2rem;
        font-size: 0.9rem;
      }
    }
  </style>
</head>
<body>
  <div class="container">
    <% if current_user %>
      <div class="header">
        <div class="page-title">
          <i class="fas fa-trophy"></i>
          <h1>Points Table</h1>
        </div>
      </div>
      
      <div class="points-table-container">
        <div class="table-wrapper">
          <table class="table">
            <thead>
              <tr>
                <th class="text-center">Rank</th>
                <th class="text-center">Team</th>
                <th class="text-center">Grand Total</th>
              </tr>
            </thead>
            <tbody>
              <% @filtered_teams.each_with_index do |team, index| %>
                <% if current_user.teams.include?(team) %>
                  <tr class='table-primary'>
                <% else %>
                  <tr>
                <% end %>
                  <td class="text-center">
                    <div class="rank-pill <%= index < 4 ? 'top-4' : '' %>">
                      <%= index + 1 %>
                    </div>
                  </td>
                  <td>
                    <div class="team-name">
                      <div class="team-avatar">
                        <%= team.team_name[0..1].upcase %>
                      </div>
                      <b><i><span><%= team.team_name.truncate(12) %></span></i><b>
                    </div>
                  </td>
                  <td class="text-center">
                    <% if team.penalty_points > 0 %>
                      <span class="points-pill"><%= team.grand_total - team.penalty_points %></span>
                    <% else %>
                      <span class="points-pill"><%= team.grand_total %></span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
      
      <% if @filtered_teams.length >= 4 && @current_user_team.matches.count > 0 %>
        <div class="header">
          <div class="top-teams-heading">
            <i class="fas fa-medal"></i>
            <h2>Top 4 Teams</h2>
          </div>
        </div>
        
        <div class="top-teams-row">
          <% (0..3).each do |i| %>
            <% team = @filtered_teams[i] %>
            <div class="podium-card card <%= 'current-user-highlight' if team == @current_user_team %>">
              <div class="position-badge position-<%= i+1 %>"><%= i+1 %></div>
              <div class="podium-card-body">
                <div class="team-avatar-large">
                  <%= team.team_name[0..1].upcase %>
                </div>
                <h3 class="podium-team-name"><%= team.team_name %></h3>
                <div class="podium-team-points"><%= team.grand_total - team.penalty_points %> pts</div>
                
                <% if current_user %>
                  <% diff = show_point_difference(team, @current_user_team) %>
                  <% if team != @current_user_team %>
                    <% if diff.include?("+") %>
                      <span class="points-difference points-ahead">
                        <i class="fas fa-arrow-up"></i> <%= diff %>
                      </span>
                    <% elsif diff.include?("-") %>
                      <span class="points-difference points-behind">
                        <i class="fas fa-arrow-down"></i> <%= diff %>
                      </span>
                    <% else %>
                      <span class="points-difference">
                        <i class="fas fa-equals"></i> <% diff %>
                      </span>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
      
    <% else %>
      <div class="login-message">
        <h3 class="animation-pulse"><i class="fas fa-lock"></i> Please Login to View Points Table</h3>
        <a href="/login" class="btn btn-primary">Login Now</a>
      </div>
    <% end %>
    
    <div class="text-center mt-3">
      <a href="<%= after_login_path %>" class="btn btn-primary back-button">
        <i class="fas fa-arrow-left"></i> Back to Dashboard
      </a>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const tableRows = document.querySelectorAll('.table tbody tr');
      tableRows.forEach(row => {
        row.addEventListener('mouseenter', () => {
          if (!row.classList.contains('table-primary')) {
            row.style.backgroundColor = 'rgba(37, 99, 235, 0.05)';
          }
        });
        row.addEventListener('mouseleave', () => {
          if (!row.classList.contains('table-primary')) {
            row.style.backgroundColor = '';
          }
        });
      });
      
      const cards = document.querySelectorAll('.card');
      cards.forEach(card => {
        card.addEventListener('mouseenter', () => {
          card.style.transform = 'translateY(-5px)';
          card.style.boxShadow = '0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04)';
        });
        card.addEventListener('mouseleave', () => {
          card.style.transform = '';
          card.style.boxShadow = '';
        });
      });
      
      const podiumCards = document.querySelectorAll('.podium-card');
      podiumCards.forEach(card => {
        card.addEventListener('mouseenter', () => {
          card.style.transform = 'scale(1.05)';
          card.style.zIndex = '10';
        });
        card.addEventListener('mouseleave', () => {
          card.style.transform = '';
          card.style.zIndex = '';
        });
      });
    });
  </script>
</body>
</html>
