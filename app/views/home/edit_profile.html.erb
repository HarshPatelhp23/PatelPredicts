<div class="container mt-5">
  <div class="header">
    <h1 class="text-center mb-4"><%= "#{current_user.username}'s Profile" %></h1>
  </div>
  <div class="row justify-content-center">
    <div class="col-md-6">
      <%= form_with(url: update_profile_path, method: :post, class: "edit-profile-form") do |form| %>
        <div class="form-group">
          <label for="username" class="form-label">Username:</label>
          <%= form.text_field :username, value: current_user.username, class: "form-control username-input", required: true %>
        </div>
        <%= form.submit "Update Profile", class: "btn btn-primary update-profile-btn" %>
      <% end %>
    </div>
  </div>
</div>
