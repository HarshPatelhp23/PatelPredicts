<!-- Add these custom styles to your application.css or create a new stylesheet -->
<style>

  :root {
      --primary: #4834d4;
      --primary-dark: #3525b0;
      --secondary: #ff7b25;
      --secondary-dark: #e66b1c;
      --white: #ffffff;
      --light-gray: #f5f6fa;
      --mid-gray: #dcdde1;
      --dark-gray: #718093;
      --text-dark: #2f3640;
      --success: #4cd137;
      --danger: #eb4d4b;
    }
  .table th, .table td {
    vertical-align: middle;
  }
  
  .table-primary {
    --bs-table-bg: rgba(13, 110, 253, 0.1);
    --bs-table-color: #0d6efd;
  }
  
  .card {
    border-radius: 0.5rem;
    transition: transform 0.2s;
  }
  
  .card:hover {
    transform: translateY(-3px);
  }
  
  .card-header {
    border-top-left-radius: 0.5rem !important;
    border-top-right-radius: 0.5rem !important;
  }
  
  /* Avatar circle for top scorer */
  .avatar-circle {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    font-weight: bold;
    font-size: 16px;
  }
  
  /* Redesigned team details button */
  .btn-team-details {
    background-color: #0D6EFD;
    color: var(--white);
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 500;
    /*display: flex;*/
    align-items: center;
    transition: background-color 0.2s;
    text-decoration: none;
    margin-left: 5px;
  }
  
  .btn-team-details:hover {
    background-color: #0d6efd;
    color: white;
    transform: scale(1.05);
  }
  
  .btn-team-details i {
    font-size: 1.1rem;
  }
  
  .btn-team-details .btn-text {
    font-size: 0.6rem;
    font-weight: 600;
  }
  /* Countdown Timer Styles */
.bg-gradient-primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-dark));
}

.bg-gradient-info {
  background: linear-gradient(135deg, #17a2b8, #138496);
}

#countdown-timer {
  font-family: 'Courier New', monospace;
  letter-spacing: 2px;
  transition: all 0.3s ease;
}

.text-warning {
  color: #ffc107 !important;
}

.text-danger {
  color: var(--danger) !important;
}

.text-success {
  color: var(--success) !important;
}

.pulse {
  animation: pulse 1s infinite;
}

.pulse-fast {
  animation: pulse 0.5s infinite;
}

@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.7; }
  100% { opacity: 1; }
}

/* Next Match Styles */
#next-match {
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .display-4 {
    font-size: 2rem;
  }
  
  .display-6 {
    font-size: 1.1rem;
  }
}
  
  @media (max-width: 768px) {
    .table {
      font-size: 0.85rem;
    }
    
    /* Keep the stats cards in a horizontal row with reduced padding */
    .card-body {
      padding: 0.75rem;
    }
    
    /* Make sure the cards don't shrink too much on very small screens */
    .row.d-flex.flex-nowrap {
      min-width: 300px;
    }
  }
  
  /* For very small screens */
  @media (max-width: 380px) {
    .table {
      font-size: 0.75rem;
    }
    
    .avatar-circle {
      width: 28px;
      height: 28px;
      font-size: 14px;
    }
    
  }

  /* Fireworks Animation for Top Rankings */
  .ranking-container {
    position: relative;
  }
  
  .firework {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    box-shadow: 0 0 6px 2px rgba(255, 255, 255, 0.8);
    animation: explode 1s ease-out forwards;
    opacity: 0;
    z-index: 2;
    pointer-events: none;
  }
  
  @keyframes explode {
    0% {
      transform: translateY(0) scale(0.1);
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    50% {
      opacity: 0.8;
    }
    100% {
      transform: translateY(-50px) scale(1);
      opacity: 0;
    }
  }
  
  .top-rank-glow {
    position: relative;
    animation: pulse-glow 2s infinite;
  }
  
  .trophy-badge {
    position: absolute;
    top: -10px;
    right: -10px;
    background: linear-gradient(135deg, #ffd700, #ffaa00);
    border-radius: 50%;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 10px 2px rgba(255, 215, 0, 0.6);
    z-index: 2;
  }
  
  .trophy-badge i {
    font-size: 14px;
    color: white;
  }
  
  .confetti-container {
    pointer-events: none;
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    overflow: hidden;
    z-index: 1;
  }
  
  .confetti {
    position: absolute;
    width: 8px;
    height: 8px;
    opacity: 0;
    animation: fall 3s linear infinite;
  }
  
  @keyframes fall {
    0% {
      top: -10%;
      transform: translateX(0) rotate(0deg);
      opacity: 1;
    }
    100% {
      top: 100%;
      transform: translateX(100px) rotate(360deg);
      opacity: 0;
    }
  }
  
  @keyframes pulse-glow {
    0% {
      box-shadow: 0 0 5px 0 rgba(255, 215, 0, 0.5);
    }
    50% {
      box-shadow: 0 0 15px 5px rgba(255, 215, 0, 0.7);
    }
    100% {
      box-shadow: 0 0 5px 0 rgba(255, 215, 0, 0.5);
    }
  }
  
  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .trophy-badge {
      width: 20px;
      height: 20px;
    }
    
    .trophy-badge i {
      font-size: 12px;
    }
    
    .firework {
      width: 4px;
      height: 4px;
    }
  }

  /*OVERALL RANKINGS CSS*/

  @import url('https://fonts.googleapis.com/css2?family=Exo+2:wght@700&display=swap');

  .celebration-active {
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    z-index: 10;
  }

  .celebration-active h3 {
    font-family: 'Exo 2', sans-serif;
    text-shadow: 0 0 10px rgba(255, 215, 0, 0.8);
    animation: number-pop 1.5s ease-in-out infinite;
    transition: all 0.3s ease;
  }

  /* Golden particle effect container */
  .particles-container {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: -1;
  }

  /* Individual golden particles */
  .particle {
    position: absolute;
    width: 8px;
    height: 8px;
    background: radial-gradient(circle, rgba(255,215,0,1) 0%, rgba(255,215,0,0) 70%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9;
  }

  /* Spotlight effect behind number */
  .spotlight {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle, rgba(255,215,0,0.3) 0%, rgba(255,215,0,0) 70%);
    opacity: 0;
    animation: spotlight-pulse 2s ease-in-out infinite;
    z-index: -1;
    pointer-events: none;
  }

  /* 3D rotating crown for top rank */
  .crown-3d {
    position: absolute;
    top: -30px;
    left: 50%;
    transform: translateX(-50%) rotate(0deg);
    width: 60px;
    height: 40px;
    z-index: 20;
    animation: crown-rotate 6s infinite linear;
    transform-style: preserve-3d;
    pointer-events: none;
  }

  .crown-front, .crown-left, .crown-right, .crown-back, .crown-top {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
  }

  .crown-front {
    background: linear-gradient(135deg, #ffd700, #ff8c00);
    clip-path: polygon(50% 0%, 75% 50%, 100% 25%, 100% 100%, 0% 100%, 0% 25%, 25% 50%);
    transform: translateZ(10px);
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.8);
  }

  .crown-back {
    background: linear-gradient(135deg, #ffaa00, #ff6f00);
    clip-path: polygon(50% 0%, 75% 50%, 100% 25%, 100% 100%, 0% 100%, 0% 25%, 25% 50%);
    transform: translateZ(-10px) rotateY(180deg);
  }

  .crown-left {
    background: linear-gradient(90deg, #ffc700, #ff8800);
    width: 20px;
    transform: rotateY(-90deg) translateZ(30px);
  }

  .crown-right {
    background: linear-gradient(90deg, #ff8800, #ffc700);
    width: 20px;
    transform: rotateY(90deg) translateZ(30px);
  }

  .crown-top {
    height: 20px;
    background: radial-gradient(circle, #ffe100, #ffaa00);
    transform: rotateX(90deg) translateZ(10px);
    box-shadow: 0 0 30px 10px rgba(255, 215, 0, 0.6);
  }

  /* Rank ribbon */
  .rank-ribbon {
    position: absolute;
    top: -15px;
    right: -15px;
    width: 80px;
    height: 80px;
    overflow: hidden;
    z-index: 15;
    pointer-events: none;
  }

  .rank-ribbon-content {
    position: absolute;
    display: block;
    width: 120px;
    background: linear-gradient(135deg, #ff0000, #ffcc00);
    padding: 10px 0;
    box-shadow: 0 5px 10px rgba(0,0,0,0.2);
    color: white;
    font-size: 14px;
    font-weight: bold;
    text-align: center;
    transform: rotate(45deg);
    top: 15px;
    right: -30px;
    text-shadow: 0 1px 1px rgba(0,0,0,0.3);
    animation: ribbon-shine 3s infinite linear;
  }

  /* Lightning effect */
  .lightning {
    position: absolute;
    background: white;
    opacity: 0;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 30;
    pointer-events: none;
    mix-blend-mode: overlay;
  }

  /* Sparkle stars around the number */
  .sparkle {
    position: absolute;
    width: 12px;
    height: 12px;
    z-index: 20;
    pointer-events: none;
  }

  .sparkle:before, .sparkle:after {
    content: "";
    position: absolute;
    background-color: gold;
    height: 100%;
    width: 2px;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
  }

  .sparkle:after {
    transform: translateX(-50%) rotate(90deg);
  }

  .sparkle .diagonal {
    position: absolute;
    width: 2px;
    height: 100%;
    background-color: gold;
    transform-origin: center;
  }

  .sparkle .diagonal:nth-child(1) {
    transform: rotate(45deg);
  }

  .sparkle .diagonal:nth-child(2) {
    transform: rotate(-45deg);
  }

  /* Wave effect for card */
  .wave {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 40%;
    background: linear-gradient(to top, rgba(255,215,0,0.2), rgba(255,215,0,0));
    border-radius: 50%;
    transform: scale(1.5, 0.3) translateY(70%);
    animation: wave 2s infinite ease-in-out;
    pointer-events: none;
    z-index: -1;
  }

  /* Animation keyframes */
  @keyframes number-pop {
    0% { transform: scale(1); }
    50% { transform: scale(1.2); }
    100% { transform: scale(1); }
  }

  @keyframes float-up {
    0% { transform: translateY(100px); opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { transform: translateY(-100px); opacity: 0; }
  }

  @keyframes spotlight-pulse {
    0% { opacity: 0.2; transform: scale(0.8); }
    50% { opacity: 0.6; transform: scale(1.2); }
    100% { opacity: 0.2; transform: scale(0.8); }
  }

  @keyframes crown-rotate {
    0% { transform: translateX(-50%) rotateY(0deg); }
    100% { transform: translateX(-50%) rotateY(360deg); }
  }

  @keyframes ribbon-shine {
    0% { background-position: -120px; }
    100% { background-position: 120px; }
  }

  @keyframes lightning-flash {
    0% { opacity: 0; }
    5% { opacity: 0.8; }
    10% { opacity: 0; }
    15% { opacity: 0.4; }
    20% { opacity: 0; }
    100% { opacity: 0; }
  }

  @keyframes wave {
    0% { transform: scale(1.5, 0.3) translateY(70%) translateX(0); }
    50% { transform: scale(1.5, 0.3) translateY(70%) translateX(5%); }
    100% { transform: scale(1.5, 0.3) translateY(70%) translateX(0); }
  }

  @keyframes sparkle-rotate {
