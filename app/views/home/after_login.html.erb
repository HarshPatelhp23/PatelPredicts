    const confettiColors = [
      '#ffd700', '#ffaa00', '#ff8800', '#ff4400', 
      '#4834d4', '#3525b0', '#ffffff', '#00aaff'
    ];
    
    for (let i = 0; i < 80; i++) {
      const confetti = document.createElement('div');
      confetti.style.position = 'absolute';
      confetti.style.width = `${Math.random() * 10 + 5}px`;
      confetti.style.height = `${Math.random() * 6 + 3}px`;
      confetti.style.backgroundColor = confettiColors[Math.floor(Math.random() * confettiColors.length)];
      confetti.style.top = '-5%';
      confetti.style.left = `${Math.random() * 100}%`;
      confetti.style.opacity = Math.random() * 0.8 + 0.2;
      confetti.style.transform = `rotate(${Math.random() * 360}deg)`;
      confetti.style.borderRadius = Math.random() > 0.5 ? '50%' : '0';
      
      // Set animation properties
      const duration = Math.random() * 3 + 2;
      const delay = Math.random() * 2;
      
      confetti.style.animation = `
        fall ${duration}s linear ${delay}s infinite,
        sway ${duration * 0.5}s ease-in-out ${delay}s infinite alternate
      `;
      
      // Add keyframe animations dynamically
      const styleSheet = document.styleSheets[0];
      
      // Fall animation
      if (!document.querySelector('style[data-animation="fall"]')) {
        const fallKeyframes = `
          @keyframes fall {
            0% { transform: translateY(0) rotate(0deg); opacity: 1; }
            70% { opacity: 1; }
            100% { transform: translateY(${window.innerHeight}px) rotate(360deg); opacity: 0; }
          }
        `;
        const styleElement = document.createElement('style');
        styleElement.setAttribute('data-animation', 'fall');
        styleElement.textContent = fallKeyframes;
        document.head.appendChild(styleElement);
      }
      
      // Sway animation
      if (!document.querySelector('style[data-animation="sway"]')) {
        const swayKeyframes = `
          @keyframes sway {
            0% { transform: translateX(-20px) rotate(-10deg); }
            100% { transform: translateX(20px) rotate(10deg); }
          }
        `;
        const styleElement = document.createElement('style');
        styleElement.setAttribute('data-animation', 'sway');
        styleElement.textContent = swayKeyframes;
        document.head.appendChild(styleElement);
      }
      
      confettiContainer.appendChild(confetti);
    }
    
    // Create fireworks function
    const createFirework = (baseElement) => {
      // Rocket rising animation
      baseElement.style.animation = 'firework-rise 1s ease-out forwards';
      
      // When rocket reaches top height, create explosion
      setTimeout(() => {
        // Create explosion particles
        for (let i = 0; i < 30; i++) {
          const particle = document.createElement('div');
          particle.className = 'firework-particle';
          particle.style.position = 'absolute';
          particle.style.width = '4px';
          particle.style.height = '4px';
          particle.style.borderRadius = '50%';
          
          // Calculate position (where the rocket ended)
          const rect = baseElement.getBoundingClientRect();
          const modalRect = modal.getBoundingClientRect();
          
          particle.style.left = `${rect.left - modalRect.left + rect.width/2}px`;
          particle.style.top = `${rect.top - modalRect.top}px`;
          
          // Random color for particles
          const hue = Math.floor(Math.random() * 60 + 30); // Golden-ish color range
          particle.style.backgroundColor = `hsl(${hue}, 100%, 50%)`;
          particle.style.boxShadow = `0 0 6px 2px hsl(${hue}, 100%, 60%)`;
          
          // Random direction
          const angle = Math.random() * Math.PI * 2;
          const distance = Math.random() * 100 + 50;
          const tx = Math.cos(angle) * distance;
          const ty = Math.sin(angle) * distance;
          
          // Set CSS variables for the animation
          particle.style.setProperty('--tx', `${tx}px`);
          particle.style.setProperty('--ty', `${ty}px`);
          
          // Apply animation
          particle.style.animation = `explode 1s ease-out forwards`;
          
          fireworksLeft.parentNode.appendChild(particle);
          
          // Remove particle after animation
          setTimeout(() => {
            if (particle.parentNode) {
              particle.parentNode.removeChild(particle);
            }
          }, 1000);
        }
        
        // Reset the rocket for next launch
        baseElement.style.animation = 'none';
        setTimeout(() => {
          if (baseElement.isConnected) {
            createFirework(baseElement);
          }
        }, Math.random() * 2000 + 1000);
        
      }, 1000); // Match the duration of the rise animation
    };
    
    // Function to create trophy particle
    const createTrophyParticle = () => {
      const trophyParticles = document.querySelector('.trophy-particles');
      if (!trophyParticles || !trophyParticles.isConnected) return;
      
      const particle = document.createElement('div');
      particle.style.position = 'absolute';
      particle.style.width = '6px';
      particle.style.height = '6px';
      particle.style.backgroundColor = 'rgba(255, 215, 0, 0.7)';
      particle.style.borderRadius = '50%';
      
      // Random position around the trophy
      const angle = Math.random() * Math.PI * 2;
      const distance = Math.random() * 30 + 40;
      const x = 50 + Math.cos(angle) * distance;
      const y = 50 + Math.sin(angle) * distance;
      
      particle.style.left = `${x}%`;
      particle.style.top = `${y}%`;
      
      // Animate the particle
      particle.style.animation = 'trophy-particle 1.5s ease-out forwards';
      
      // Add keyframe animations dynamically if not already added
      if (!document.querySelector('style[data-animation="trophy-particle"]')) {
        const keyframes = `
          @keyframes trophy-particle {
            0% { transform: scale(0); opacity: 0; }
            20% { opacity: 1; }
            100% { transform: scale(2); opacity: 0; }
          }
        `;
        const styleElement = document.createElement('style');
        styleElement.setAttribute('data-animation', 'trophy-particle');
        styleElement.textContent = keyframes;
        document.head.appendChild(styleElement);
      }
      
      trophyParticles.appendChild(particle);
      
      // Remove particle after animation
      setTimeout(() => {
        if (particle.parentNode) {
          particle.parentNode.removeChild(particle);
        }
      }, 1500);
    };
    
    // Show modal with animation after a short delay
    setTimeout(() => {
      modal.classList.add('show');
      
      // Start fireworks
      createFirework(fireworksLeft);
      setTimeout(() => createFirework(fireworksRight), 300);
      
      // Start trophy particles
      const trophyParticleInterval = setInterval(createTrophyParticle, 200);
      
      // Close button event
      closeButton.addEventListener('click', () => {
        modal.classList.remove('show');
        clearInterval(trophyParticleInterval);
        
        // Store in session storage to not show again in this session
        sessionStorage.setItem('celebrationShown', 'true');
        
        // Remove modal after animation completes
        setTimeout(() => {
          if (modal.parentNode) {
            modal.parentNode.removeChild(modal);
          }
        }, 500);
      });
      
      // Also close when clicking outside
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeButton.click();
        }
      });
      
    }, 1000); // Delay before showing modal
  }
  
  // Show only once per session
  if (sessionStorage.getItem('celebrationShown')) {
    const modal = document.getElementById('celebration-modal');
    if (modal && modal.parentNode) {
      modal.parentNode.removeChild(modal);
    }
  }
});
</script>