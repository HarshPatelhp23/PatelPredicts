<!-- Scripts -->
<script>
  document.addEventListener('DOMContentLoaded', function () {

    // ── Countdown Timer ───────────────────────────────────────────────
    function updateCountdown() {
      try {
        const now = new Date();
        const target = new Date();
        target.setHours(23, 40, 0, 0);
        if (now >= target) target.setDate(target.getDate() + 1);
        const total = Math.max(0, Math.floor((target - now) / 1000));
        const h = Math.floor(total / 3600).toString().padStart(2, '0');
        const m = Math.floor((total % 3600) / 60).toString().padStart(2, '0');
        const s = (total % 60).toString().padStart(2, '0');
        const el = document.getElementById('countdown-timer');
        if (el) el.textContent = `${h}:${m}:${s}`;
      } catch (e) { console.error(e); }
    }
    updateCountdown();
    const timerInterval = setInterval(updateCountdown, 1000);
    window.addEventListener('beforeunload', () => clearInterval(timerInterval));

    // ── Helpers ───────────────────────────────────────────────────────
    function showEl(el)  { if (el) el.style.display = 'block'; }
    function hideEl(el)  { if (el) el.style.display = 'none'; }
    function closeModal(modal) { if (modal) modal.classList.remove('show'); }

    // ── Rails rank ────────────────────────────────────────────────────
    const currentRank = <%= @current_rank || 0 %>;

    // ════════════════════════════════════════════════════════════════
    // VICTORY MODAL  (ranks 1–4)
    // Flow: modal opens → tap screen → user taps → video plays with
    //       sound (tap = user gesture) → video ends → victory content
    // ════════════════════════════════════════════════════════════════
    const victoryModal    = document.getElementById('victory-modal');
    const victoryTapScreen = document.getElementById('victory-tap-screen');
    const memeVideoWrap   = document.getElementById('meme-video-container');
    const memeVideo       = document.getElementById('meme-video');
    const victoryContent  = document.getElementById('victory-content');
    const closeVictory    = document.getElementById('close-victory');
    const continueVictory = document.getElementById('continue-victory');
    const skipVictoryBtn  = document.getElementById('skip-victory-video');

    function playVictoryVideo() {
      hideEl(victoryTapScreen);
      showEl(memeVideoWrap);
      memeVideo.muted = false;
      memeVideo.play().catch(() => {
        // Very old iOS fallback — muted play if truly blocked
        memeVideo.muted = true;
        memeVideo.play().catch(console.error);
      });
    }

    function showVictoryContent() {
      hideEl(memeVideoWrap);
      showEl(victoryContent);
    }

    if (currentRank >= 1 && currentRank <= 4 && !sessionStorage.getItem('victoryShown')) {
      sessionStorage.setItem('victoryShown', 'true');
      setTimeout(() => { if (victoryModal) victoryModal.classList.add('show'); }, 800);
    }

    // Tap screen click → play video (this tap IS the user gesture)
    if (victoryTapScreen) {
      victoryTapScreen.addEventListener('click', playVictoryVideo);
    }

    // Video ends → show victory content
    if (memeVideo) {
      memeVideo.addEventListener('ended', showVictoryContent);
    }

    // Skip button → jump straight to victory content
    if (skipVictoryBtn) {
      skipVictoryBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        memeVideo.pause();
        showVictoryContent();
      });
    }

    // Close / continue buttons
    if (closeVictory)    closeVictory.addEventListener('click',    () => { memeVideo && memeVideo.pause(); closeModal(victoryModal); });
    if (continueVictory) continueVictory.addEventListener('click', () => closeModal(victoryModal));

    // Overlay click closes
    document.getElementById('victory-overlay')?.addEventListener('click', () => {
      memeVideo && memeVideo.pause();
      closeModal(victoryModal);
    });

    // Share button
    const shareBtn = document.querySelector('.btn-share-victory');
    if (shareBtn) {
      shareBtn.addEventListener('click', () => {
        const text = `🎉 I'm ranked #${currentRank} in our Patel-Predicts! 🏆`;
        if (navigator.share) {
          navigator.share({ title: 'Fantasy Cricket Achievement', text }).catch(() => {});
        } else {
          window.open(`https://wa.me/?text=${encodeURIComponent(text)}`, '_blank');
        }
      });
    }

    // ════════════════════════════════════════════════════════════════
    // LOSER MODAL  (ranks 7–10)
    // Flow: modal opens → tap screen → user taps → video plays with
    //       sound → video ends → loser content stays open
    // ════════════════════════════════════════════════════════════════
    const loserModal      = document.getElementById('loser-modal');
    const loserTapScreen  = document.getElementById('loser-tap-screen');
    const loserVideoWrap  = document.getElementById('loser-video-container');
    const loserVideo      = document.getElementById('loser-video');
    const loserContent    = document.getElementById('loser-content');
    const closeLoser      = document.getElementById('close-loser');
    const continueLoser   = document.getElementById('continue-loser');
    const skipLoserBtn    = document.getElementById('skip-loser-video');

    function playLoserVideo() {
      hideEl(loserTapScreen);
      showEl(loserVideoWrap);
      loserVideo.muted = false;
      loserVideo.play().catch(() => {
        loserVideo.muted = true;
        loserVideo.play().catch(console.error);
      });
    }

    function showLoserContent() {
      hideEl(loserVideoWrap);
      showEl(loserContent);
    }

    if (currentRank >= 7 && currentRank <= 10 && !sessionStorage.getItem('loserShown')) {
      sessionStorage.setItem('loserShown', 'true');
      setTimeout(() => { if (loserModal) loserModal.classList.add('show'); }, 800);
    }

    if (loserTapScreen) {
      loserTapScreen.addEventListener('click', playLoserVideo);
    }

    if (loserVideo) {
      loserVideo.addEventListener('ended', showLoserContent);
    }

    if (skipLoserBtn) {
      skipLoserBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        loserVideo.pause();
        showLoserContent();
      });
    }

    if (closeLoser) closeLoser.addEventListener('click', () => { loserVideo && loserVideo.pause(); closeModal(loserModal); });
    if (continueLoser) continueLoser.addEventListener('click', () => closeModal(loserModal));

    document.getElementById('loser-overlay')?.addEventListener('click', () => {
      // Don't close on overlay during video — intentional, user should watch or skip
    });

    // ── Row click ─────────────────────────────────────────────────────
    document.querySelectorAll('.match-row').forEach(row => {
      row.style.cursor = 'pointer';
      row.addEventListener('click', function (e) {
        if (!e.target.closest('.btn-view-compact')) {
          const btn = this.querySelector('.btn-view-compact');
          if (btn) window.location.href = btn.href;
        }
      });
    });

    // ── Notification toggle ───────────────────────────────────────────
    document.getElementById('notification-toggle')?.addEventListener('click', () => {
    });

  });
</script>
