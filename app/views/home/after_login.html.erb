<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Countdown timer functionality
    function updateCountdown() {
      const now = new Date();
      let updateTime = new Date();
      
      // Set the target time to 11:55 PM
      updateTime.setHours(23, 56, 0, 0);
      
      // If it's already past 11:55 PM today, set for tomorrow
      if (now > updateTime) {
        updateTime.setDate(updateTime.getDate() + 1);
      }
      
      const diff = updateTime - now;
      
      // Calculate hours, minutes, seconds
      const hours = Math.floor(diff / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);
      
      // Format and display
      const timerElement = document.getElementById('countdown-timer');
      timerElement.innerHTML = `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
      
      // Add visual effects when under 1 hour
      if (hours === 0) {
        timerElement.classList.add('text-warning');
        if (minutes < 5) {
          timerElement.classList.remove('text-warning');
          timerElement.classList.add('text-danger', 'pulse');
        }
      } else {
        timerElement.classList.remove('text-warning', 'text-danger', 'pulse');
      }
    }
    
    // Initial call and set interval
    updateCountdown();
    setInterval(updateCountdown, 1000);
    
    // Optional: Add animation when points are updating (simulate)
    function simulatePointsUpdate() {
      const timerElement = document.getElementById('countdown-timer');
      timerElement.innerHTML = "Updating...";
      timerElement.classList.add('text-success', 'pulse-fast');
      
      setTimeout(() => {
        timerElement.classList.remove('text-success', 'pulse-fast');
        updateCountdown(); // Reset the timer
      }, 5000); // Simulate 5 second update process
    }
    
    // For demo purposes - would be triggered by your actual cron job
    // document.getElementById('countdown-timer').addEventListener('click', simulatePointsUpdate);
  });
