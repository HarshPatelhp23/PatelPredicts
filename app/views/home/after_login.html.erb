<!-- app/views/after_login.html.erb -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
<div class="container mt-4">
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-primary text-white py-3">
      <% if current_user.auctions.count > 1 %>
        <div class="row align-items-center">
          <div class="col-md-12">
            <%= form_with url: after_login_path, method: :get, local: true, class: "d-flex flex-column flex-md-row align-items-center" do |form| %>
              <div class="me-md-3 mb-2 mb-md-0 flex-grow-1">
                <%= form.label :auction_id, "Select Auction", class: "text-white fw-bold mb-1" %>
                <%= form.select :auction_id, 
                             options_from_collection_for_select(current_user.auctions, :id, :name, params[:auction_id]), 
                             { prompt: "Choose an auction" }, 
                             { class: "form-select" } %>
              </div>
              <%= form.submit "Get Updates", class: "btn btn-light px-4" %>
            <% end %>
          </div>
        </div>
      <% else %>
        <h4 class="mb-0 text-center fw-bold"><%= "#{current_user.auctions.last.name} Updates" %></h4>
      <% end %>
    </div>
    
    <div class="card-body">
      <!-- Stats Summary Row - Modified to stay horizontal on mobile -->
      <div class="row mb-4 d-flex flex-nowrap overflow-auto">
        <div class="col-4 mb-3 px-1">
          <div class="card h-100 border-0 bg-light">
            <div class="card-body text-center p-2 p-md-3">
              <div class="d-flex align-items-center justify-content-center mb-2">
                <i class="bi bi-trophy fs-3 text-warning"></i>
              </div>
              <h3 class="mb-1"><%= @default_team.grand_total %></h3>
              <p class="text-muted mb-0 small">Total Points</p>
            </div>
          </div>
        </div>
        <div class="col-4 mb-3 px-1">
          <div class="card h-100 border-0 bg-light">
            <div class="card-body text-center p-2 p-md-3">
              <div class="d-flex align-items-center justify-content-center mb-2">
                <i class="bi bi-award fs-3 text-success"></i>
              </div>
              <h3 class="mb-1"><%= @current_rank %></h3>
              <p class="text-muted mb-0 small">Overall Ranking</p>
            </div>
          </div>
        </div>
        <div class="col-4 mb-3 px-1">
          <div class="card h-100 border-0 bg-light">
            <div class="card-body text-center p-2 p-md-3">
              <div class="d-flex align-items-center justify-content-center mb-2">
                <i class="bi bi-calendar-check fs-3 text-primary"></i>
              </div>
              <h3 class="mb-1"><%= @user_data&.keys&.count %></h3>
              <p class="text-muted mb-0 small">Matches Played</p>
            </div>
          </div>
        </div>
      </div>
      <!-- Countdown and Next Match Section -->
      <div class="row mb-4">
        <div class="col-md-6 mb-3">
          <div class="card h-100 border-0 bg-gradient-primary text-white">
            <div class="card-body p-3">
              <div class="d-flex align-items-center">
                <div class="flex-shrink-0 me-3">
                  <i class="fas fa-clock fa-2x"></i>
                </div>
                <div class="flex-grow-1">
                  <h5 class="card-title mb-1">Next Points Update</h5>
                  <div id="countdown-timer" class="display-4 fw-bold"></div>
                  <small class="opacity-75">Updates daily at 11:56 PM</small>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="col-md-6 mb-3">
          <div class="card h-100 border-0 bg-gradient-info text-white">
            <div class="card-body p-3">
              <div class="d-flex align-items-center">
                <div class="flex-shrink-0 me-3">
                  <i class="fas fa-calendar-alt fa-2x"></i>
                </div>
                <div class="flex-grow-1">
                  <h5 class="card-title mb-1">Today's Match</h5>
                  <div id="next-match" class="display-6 fw-bold">
                    <% @today_matches.each_with_index do |match, index| %>
                      <% t1,t2 = match.match_name.split(' vs ') %>
                      <% u_t1 = match_country_code[t1].upcase %>
                      <% u_t2 = match_country_code[t2].upcase %>
                      <% if index <= 0 %>
                        <%= u_t1 %> vs <%= u_t2 %>
                      <% else %>
                        <%= ", #{u_t1}" %> vs <%= u_t2 %>
                      <% end %>

                      <!-- <#%= display_match_name_with_flags(match.match_name) %> -->
                    <% end %>
                  </div>
                  <small class="opacity-75">Points will update after match completion</small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Match Table -->
      <div class="table-responsive">
        <table class="table table-hover">
          <thead class="table-primary">
            <tr>
              <th class="text-center">Match</th>
              <th class="text-center">Top Scorer</th>
              <th class="text-center">Your Score</th>
              <th class="text-center">Position</th>
              <th class="text-center">Details</th>
            </tr>
          </thead>
          <tbody>
            <% @match_points.each do |match| %>
              <% user_data = @user_data[match.match_name][0] %>
              <% is_top_3 = (1..4).include?(user_data) %>
              <% is_bottom_3 = (8..10).include?(user_data) %>
              <% top_scorer = MatchPoint.leader_of_match(match.match_name, @current_auction, current_user) %>
              <% top_scorer_initial = top_scorer.first %>
              <% top_scorer_points = MatchPoint.leader_points_of_match(match.match_name, @current_auction, current_user) %>
              
              <% if is_top_3 %>
                <% row_class = 'table-success' %>
                <% text_class = 'text-success' %>
                <% display_text = 'Top-3' %>
              <% elsif is_bottom_3 %> 
                <% row_class = 'table-danger' %>
                <% text_class = 'text-danger' %>
                <% display_text = 'Bottom-3' %>
              <% else %>
                <% row_class = 'table-light' %>
                <% text_class = 'text-dark' %>
                <% display_text = '' %>
              <% end %>
              
              <tr class="<%= row_class %>">
                <td class="text-center align-middle">
                  <span class="fw-medium"><%= display_match_name_with_flags(match.match_name) %></span>
                </td>
                <td class="text-center align-middle">
                  <div class="d-flex flex-column align-items-center justify-content-center">
                    <!-- Avatar circle with initial letter -->
                    <div class="avatar-circle bg-primary d-flex align-items-center justify-content-center text-white mb-1">
                      <%= top_scorer_initial %>
                    </div>
                    <!-- Points shown below the avatar -->
                    <span class="fw-bold"><%= top_scorer_points %></span>
                  </div>
                </td>
                <td class="text-center align-middle fw-bold"><%= @user_data[match.match_name][1] %></td>
                <td class="text-center align-middle">
                  <div class="d-flex flex-column align-items-center">
                    <% if user_data <= 9 %>
                      <h4 class="mb-0"><i class="bi bi-<%= user_data %>-circle <%= text_class %>"></i></h4>
                    <% else %>
                      <h4 class="mb-0">
                        <i class="bi bi-1-circle <%= text_class %>"></i>
                        <i class="bi bi-0-circle <%= text_class %>"></i>
                      </h4>
                    <% end %>
                    <small class="<%= text_class %> fw-medium"><%= display_text %></small>
                  </div>
                </td>
                <td class="text-center align-middle">
                  <%= link_to one_match_scorecard_path(match.match_name, auction_id: @current_auction.id), 
                          class: 'btn-team-details' do %>
                    <!-- <div class="d-flex flex-column align-items-center"> -->
                      <!-- <i class="fas fa-eye"></i> -->
                      <span class="btn-text">Open</span>
                    <!-- </div> -->
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      
      <!-- Pagination -->
      <div class="d-flex justify-content-center mt-4">
        <%== pagy_bootstrap_nav(@pagy) %>
      </div>
    </div>
  </div>
</div>

<div id="celebration-modal" class="celebration-modal">
  <div class="modal-content">
    <div class="modal-inner">
      <div class="confetti-container"></div>
      
      <div class="trophy-container">
        <div class="trophy">
          <div class="trophy-cup">
            <div class="cup-top"></div>
            <div class="cup-middle"></div>
            <div class="cup-bottom"></div>
            <div class="cup-handle left"></div>
            <div class="cup-handle right"></div>
          </div>
          <div class="trophy-base"></div>
          <div class="trophy-plaque">
            <span id="user-rank-display">1</span>
          </div>
        </div>
        
        <div class="trophy-shine"></div>
        <div class="trophy-particles"></div>
      </div>
      
      <div class="celebration-text">
        <h2 class="main-title">Congratulations!</h2>
        <p class="rank-message">You're in the <span class="highlight">Winning Zone</span></p>
        <div class="rank-details">
          <span class="rank-label">Current Position:</span>
          <span class="rank-value" id="modal-rank-value">1</span>
          <span class="rank-suffix" id="rank-suffix">st</span>
        </div>
        <p class="bonus-message">Stay in the top ranks to win exclusive rewards!</p>
      </div>
      
      <div class="action-buttons">
        <button class="share-button">
          <i class="fas fa-share-alt"></i> Share
        </button>
        <button class="close-button" id="close-celebration">
          Continue
        </button>
      </div>
      
      <div class="fireworks-container">
        <div class="firework-base left"></div>
        <div class="firework-base right"></div>
      </div>
    </div>
  </div>
</div>

