<style>
  /* Sidebar Styles */
  .sidebar {
    width: 250px;
    height: 100vh;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 100;
    background-color: #343a40; /* Bootstrap dark theme */
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  
  .sidebar-header {
    padding: 1rem;
    border-bottom: 1px solid #495057;
  }
  
  .sidebar-logo {
    width: 40px;
    height: 40px;
    margin-left: 80px;
  }
  
  .sidebar-content {
    padding: 1rem;
    flex: 1;
  }
  
  .sidebar-content .nav-link {
    padding: 0.75rem 1rem;
    margin-bottom: 0.5rem;
    border-radius: 0.375rem;
    transition: all 0.3s ease;
  }
  
  .sidebar-content .nav-link:hover {
    background-color: #495057;
  }
  
  .sidebar-content .nav-link.active {
    background-color: #0d6efd;
  }
  
  .sidebar-footer {
    padding: 1rem;
    border-top: 1px solid #495057;
  }
  
  .avatar-container {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: #0d6efd;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: bold;
  }
  
  .avatar-text {
    font-size: 1.2rem;
  }
  
  /* Main content adjustment for sidebar */
  .main-content {
    margin-left: 250px !important;
    width: calc(100% - 250px);
  }
  
  /* Mobile Styles */
  @media (max-width: 992px) {
    body {
      padding-top: 56px; /* Height of mobile navbar */
    }
    
    .main-content {
      margin-left: 0;
      width: 100%;
    }
    
    /* Offcanvas Styles */
    .offcanvas.theme-dark-color {
      background-color: #343a40;
    }
    
    .mobile-menu-content .nav-link {
      padding: 0.75rem 1rem;
      margin-bottom: 0.25rem;
      border-radius: 0.375rem;
      transition: all 0.3s ease;
      cursor: pointer;
    }
    
    .mobile-menu-content .nav-link:hover {
      background-color: #495057;
    }
    
    .mobile-menu-content .nav-link.active {
      background-color: #0d6efd;
    }
    
    .btn-close-white {
      filter: invert(1) grayscale(100%) brightness(200%);
    }
    
    /* Mobile navbar button with badge */
    .navbar-toggler {
      position: relative;
    }
    
    .badge-new {
      background-color: #dc3545;
      color: white;
      font-size: 0.6rem;
      padding: 0.15rem 0.4rem;
      border-radius: 0.375rem;
    }
  }
  
  /* Badge styles */
  .badge-new {
    background-color: #dc3545;
    color: white;
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 0.375rem;
  }
  
  /* Mobile specific improvements */
  @media (max-width: 768px) {
    .mobile-menu-content .nav-link {
      padding: 0.5rem 0.75rem;
      font-size: 0.9rem;
    }
    
    .mobile-menu-content .nav-link i {
      font-size: 0.9rem;
    }
  }
</style>

<script>
  // Add active class to current page link and close offcanvas when clicked
  document.addEventListener('DOMContentLoaded', function() {
    const currentPath = window.location.pathname;
    
    // Desktop sidebar links
    const desktopLinks = document.querySelectorAll('.sidebar-content .nav-link');
    desktopLinks.forEach(link => {
      if (link.getAttribute('href') === currentPath) {
        link.classList.add('active');
      }
    });
    
    // Mobile sidebar links
    const mobileLinks = document.querySelectorAll('.mobile-menu-content .nav-link');
    mobileLinks.forEach(link => {
      if (link.getAttribute('href') === currentPath) {
        link.classList.add('active');
      }
      
      // Add click handler to close offcanvas and navigate
      link.addEventListener('click', function(e) {
        // Close offcanvas if it's open
        const offcanvas = document.getElementById('mobileSidebar');
        if (offcanvas && offcanvas.classList.contains('show')) {
          const bsOffcanvas = bootstrap.Offcanvas.getInstance(offcanvas);
          if (bsOffcanvas) {
            bsOffcanvas.hide();
          }
        }
        
        // If it's a Turbo link, let Turbo handle it
        // Otherwise, the normal link behavior will work
      });
    });
    
    // Handle Edit Profile and Logout buttons separately
    const editProfileBtn = document.querySelector('.btn-outline-light');
    const logoutBtn = document.querySelector('.btn-danger');
    
    if (editProfileBtn) {
      editProfileBtn.addEventListener('click', function() {
        const offcanvas = document.getElementById('mobileSidebar');
        if (offcanvas && offcanvas.classList.contains('show')) {
          const bsOffcanvas = bootstrap.Offcanvas.getInstance(offcanvas);
          if (bsOffcanvas) {
            bsOffcanvas.hide();
          }
        }
      });
    }
    
    if (logoutBtn) {
      logoutBtn.addEventListener('click', function() {
        const offcanvas = document.getElementById('mobileSidebar');
        if (offcanvas && offcanvas.classList.contains('show')) {
          const bsOffcanvas = bootstrap.Offcanvas.getInstance(offcanvas);
          if (bsOffcanvas) {
            bsOffcanvas.hide();
          }
        }
      });
    }
  });
</script>
