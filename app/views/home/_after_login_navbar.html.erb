            <% end %>
          </li>
          <li class="nav-item" data-turbo="false">
            <%= link_to chatbot_path, class: "nav-link text-white" do %>
              <i class="fas fa-robot me-2"></i>
              <span>AI Assistant</span>
              <span class="badge badge-new ms-2">New</span>
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to team_performance_path(auction_id: auction.id), class: 'nav-link text-white' do %>
              <i class="fas fa-chart-line me-2"></i>
              <span>Search Player</span>
            <% end %>
          </li>
          <li class="nav-item" data-turbo="false">
            <%= link_to points_table_path(auction_id: auction.id), class: 'nav-link text-white' do %>
              <i class="fas fa-table me-2"></i>
              <span>Points Table</span>
            <% end %>
          </li>
          <li class="nav-item" data-turbo="false">
            <%= link_to bench_points_table_path(auction_id: auction.id), class: 'nav-link text-white' do %>
              <i class="fas fa-table me-2"></i>
              <span>Bench- Points Table</span>
            <% end %>
          </li>
          <li class="nav-item">
            <% user_team = current_user.teams.where(auction: auction).first || current_user.teams.last %>
            <%= link_to team_new_team_path(user_team.slug, auction_id: auction.id), class: 'nav-link text-white' do %>
