            <%= link_to other_players_team_path(auction_id: auction.id), class: 'nav-link text-white' do %>
              <i class="fas fa-list-ul me-2"></i>
              <span>All Teams</span>
            <% end %>
          </li>
          <li class="nav-item">
            <%= link_to team_analysis_path(auction_id: auction.id), class: 'nav-link text-white' do %>
