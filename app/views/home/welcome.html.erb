<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Patel-Predicts - Fantasy Cricket</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      width: 100%;
      height: 100%;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      overflow: hidden;
    }

    /* Full-screen background using a pseudo element so it never gaps */
    .hero-section {
      position: fixed;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    /* Background layer — sits behind everything, truly fullscreen */
    .hero-section::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image:
        linear-gradient(rgba(0,0,0,0.55), rgba(0,0,0,0.55)),
        url('<%= image_url("pp_home.png") %>');
      background-repeat: no-repeat;
      background-size: 200% 100%;      /* 2 panels side by side, each fills 100% height */
      background-position: 0% 0%;      /* left panel for desktop */
      z-index: -1;
    }

    /* Mobile: show right panel */
    @media (max-width: 768px) {
      .hero-section::before {
        background-size: 200% 100%;
        background-position: 100% 0%;
      }
    }

    /* Scrollable inner content */
    .hero-inner {
      width: 100%;
      max-width: 500px;
      padding: 60px 24px 48px;
      display: flex;
      flex-direction: column;
      align-items: center;
      /* min-height ensures content is centred even on tall screens */
      min-height: 100%;
      justify-content: center;
    }

    @media (max-width: 768px) {
      .hero-inner {
        max-width: 100%;
        padding: 72px 20px 48px;
        justify-content: flex-start;
      }
    }

    /* App badge */
    .app-badge {
      width: 84px; height: 84px;
      border-radius: 22px;
      background: linear-gradient(145deg, #7c4ef5, #6741ea);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 20px;
      box-shadow: 0 16px 48px rgba(103,65,234,0.55);
      flex-shrink: 0;
    }
    .app-badge span { font-size: 40px; line-height: 1; }

    .app-name {
      font-size: 34px; font-weight: 800;
      color: #fff;
      letter-spacing: -0.5px;
      margin-bottom: 6px;
      text-align: center;
      text-shadow: 0 2px 16px rgba(0,0,0,0.6);
    }

    .app-sub {
      font-size: 14px;
      color: rgba(255,255,255,0.48);
      margin-bottom: 44px;
      text-align: center;
    }

    .section-label {
      font-size: 10px; font-weight: 700;
      letter-spacing: 2px; text-transform: uppercase;
      color: rgba(255,255,255,0.3);
      width: 100%; margin-bottom: 14px;
    }

    /* Tiles */
    .module-tile {
      width: 100%;
      border-radius: 20px;
      padding: 20px 18px;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 16px;
      text-decoration: none;
      border: 1px solid rgba(255,255,255,0.12);
      position: relative;
      overflow: hidden;
      transition: transform 0.15s ease, filter 0.15s ease;
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
    }
    .module-tile:hover  { transform: translateY(-2px); filter: brightness(1.12); }
    .module-tile:active { transform: scale(0.97); filter: brightness(0.95); }

    .module-tile::after {
      content: '';
      position: absolute; top: -50px; right: -30px;
      width: 130px; height: 130px; border-radius: 50%;
      pointer-events: none;
    }

    .tile-intl {
      background: linear-gradient(135deg, rgba(103,65,234,0.6) 0%, rgba(80,40,200,0.25) 100%);
    }
    .tile-intl::after { background: rgba(103,65,234,0.3); }

    .tile-spl {
      background: linear-gradient(135deg, rgba(17,153,142,0.6) 0%, rgba(10,110,100,0.25) 100%);
    }
    .tile-spl::after { background: rgba(17,153,142,0.3); }

    .tile-icon {
      width: 56px; height: 56px;
      border-radius: 14px;
      display: flex; align-items: center; justify-content: center;
      font-size: 28px; flex-shrink: 0;
    }
    .tile-icon-intl { background: rgba(103,65,234,0.55); }
    .tile-icon-spl  { background: rgba(17,153,142,0.55); }

    .tile-body { flex: 1; min-width: 0; position: relative; z-index: 1; }

    .tile-name {
      font-size: 17px; font-weight: 700;
      color: #fff; margin-bottom: 4px;
    }

    .tile-desc {
      font-size: 12px;
      color: rgba(255,255,255,0.48);
      line-height: 1.4;
    }

    .tile-arrow {
      width: 38px; height: 38px; border-radius: 50%;
      background: rgba(255,255,255,0.13);
      border: 1px solid rgba(255,255,255,0.18);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; z-index: 1;
      color: #fff; font-size: 20px; line-height: 1;
    }

    .tile-badge {
      position: absolute; top: 11px; right: 13px;
      background: #6741ea; color: #fff;
      font-size: 9px; font-weight: 800; letter-spacing: 0.8px;
      padding: 3px 9px; border-radius: 20px;
      text-transform: uppercase; z-index: 2;
    }

    .terms-note {
      margin-top: 28px;
      font-size: 11px;
      color: rgba(255,255,255,0.22);
      text-align: center; line-height: 1.7;
    }
    .terms-note a {
      color: rgba(255,255,255,0.45);
      text-decoration: underline;
    }

    /* Desktop tweaks */
    @media (min-width: 769px) {
      .app-name   { font-size: 40px; }
      .tile-icon  { width: 62px; height: 62px; font-size: 30px; }
      .tile-name  { font-size: 18px; }
      .tile-arrow { width: 42px; height: 42px; }
      .module-tile { padding: 22px 22px; }
    }
  </style>
</head>
<body>
  <section class="hero-section">
    <div class="hero-inner">

      <div class="app-badge"><span>🏏</span></div>
      <h1 class="app-name">Patel-Predicts</h1>
      <p class="app-sub">Choose your league to continue</p>

      <p class="section-label">Select module</p>

      <%= link_to (user_signed_in? ? dashboard_path : new_user_session_path), class: 'module-tile tile-intl' do %>
        <div class="tile-icon tile-icon-intl">🌍</div>
        <div class="tile-body">
          <div class="tile-name">International Cricket</div>
          <div class="tile-desc">Global tournaments &amp; matches worldwide</div>
        </div>
        <div class="tile-arrow">›</div>
      <% end %>

      <%= link_to (spl_user_signed_in? ? spl_dashboard_path : new_spl_user_session_path), class: 'module-tile tile-spl' do %>
        <div class="tile-icon tile-icon-spl">🏆</div>
        <div class="tile-body">
          <div class="tile-name">Sugam Premier League</div>
          <div class="tile-desc">Society-exclusive SPL tournament</div>
        </div>
        <div class="tile-arrow">›</div>
        <div class="tile-badge">SPL, SVL</div>
      <% end %>

      <p class="terms-note">
        By continuing you agree to our
        <a href="#">Terms of Service</a> &amp; <a href="#">Privacy Policy</a>
      </p>

    </div>
  </section>
</body>
</html>
