<!-- one_match_scorecard.html.erb - Modern Redesign -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Match Scorecard - <%= "#{@team1} vs #{@team2}" %></title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
  <style>
    /* CSS Variables */
    :root {
      --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      --success-gradient: linear-gradient(135deg, #48c6ef 0%, #6f86d6 100%);
      --warning-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
      --gold-gradient: linear-gradient(135deg, #ffd700 0%, #ff8c00 100%);
      --dark-bg: #0f0f23;
      --card-bg: #1a1a2e;
      --card-bg-light: #242438;
      --text-primary: #ffffff;
      --text-secondary: #b3b3cc;
      --border-color: rgba(255, 255, 255, 0.1);
      --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.1);
      --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.2);
      --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.3);
      --radius-sm: 8px;
      --radius-md: 12px;
      --radius-lg: 16px;
      --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      background: var(--dark-bg);
      color: var(--text-primary);
      line-height: 1.6;
    }

    .scorecard-app {
      min-height: 100vh;
      padding-bottom: 40px;
      background: linear-gradient(180deg, #0f0f23 0%, #1a1a2e 100%);
    }

    /* Header Section */
    .scorecard-header {
      background: var(--primary-gradient);
      padding: 20px 16px 32px;
      position: relative;
      overflow: hidden;
    }

    .scorecard-header::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
      opacity: 0.1;
    }

    .header-content {
      position: relative;
      z-index: 1;
    }

    .back-button-header {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: white;
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      margin-bottom: 16px;
      padding: 8px 12px;
      border-radius: var(--radius-sm);
      background: rgba(255, 255, 255, 0.1);
      transition: var(--transition);
    }

    .back-button-header:active {
      background: rgba(255, 255, 255, 0.2);
    }

    .match-title-header {
      font-size: 20px;
      font-weight: 700;
      margin-bottom: 8px;
      text-align: center;
    }

    .match-date-header {
      font-size: 13px;
      opacity: 0.9;
      text-align: center;
    }

    /* Teams Container */
    .teams-vs-section {
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      padding: 24px 16px;
      margin: -20px 16px 20px;
      border: 1px solid var(--border-color);
      position: relative;
      z-index: 2;
    }

    .teams-display {
      display: flex;
      justify-content: space-around;
      align-items: center;
      gap: 16px;
    }

    .team-side {
      flex: 1;
      text-align: center;
    }

    .team-flag-circle {
      width: 70px;
      height: 70px;
      border-radius: 50%;
      background: var(--card-bg-light);
      border: 3px solid rgba(102, 126, 234, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 12px;
      font-size: 32px;
    }

    .team-name-label {
      font-size: 8px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .vs-divider {
      font-size: 16px;
      font-weight: 700;
      color: var(--text-secondary);
      flex-shrink: 0;
    }

    /* Match Summary Stats */
    .summary-stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      padding: 0 16px;
      margin-bottom: 24px;
    }

    .summary-stat-card {
      background: var(--card-bg);
      border-radius: var(--radius-md);
      padding: 16px;
      text-align: center;
      border: 1px solid var(--border-color);
    }

    .summary-stat-value {
      font-size: 24px;
      font-weight: 700;
      background: var(--gold-gradient);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 4px;
    }

    .summary-stat-label {
      font-size: 11px;
      color: var(--text-secondary);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* Tabs Navigation */
    .tabs-container {
      padding: 0 16px;
      margin-bottom: 20px;
    }

    .tabs-nav {
      display: flex;
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-color);
      padding: 4px;
      gap: 4px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .tabs-nav::-webkit-scrollbar {
      display: none;
    }

    .tab-button {
      flex: 1;
      padding: 12px 16px;
      border: none;
      background: transparent;
      color: var(--text-secondary);
      font-size: 13px;
      font-weight: 600;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: var(--transition);
      white-space: nowrap;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    .tab-button.active {
      background: var(--primary-gradient);
      color: white;
    }

    .tab-button:active {
      transform: scale(0.98);
    }

    /* Tab Content */
    .tab-content {
      display: none;
      animation: fadeIn 0.3s ease;
    }

    .tab-content.active {
      display: block;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Rankings Table */
    .rankings-section {
      padding: 0 16px;
    }

    .rankings-table-wrapper {
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-color);
      overflow: hidden;
    }

    .rankings-table {
      width: 100%;
      border-collapse: collapse;
    }

    .rankings-table thead {
      background: var(--card-bg-light);
      border-bottom: 1px solid var(--border-color);
    }

    .rankings-table th {
      padding: 12px 8px;
      font-size: 11px;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      text-align: left;
    }

    .rankings-table th:first-child {
      padding-left: 16px;
      width: 60px;
      text-align: center;
    }

    .rankings-table th:last-child {
      padding-right: 16px;
      width: 60px;
      text-align: center;
    }

    .rankings-table tbody tr {
      border-bottom: 1px solid var(--border-color);
      transition: var(--transition);
    }

    .rankings-table tbody tr:last-child {
      border-bottom: none;
    }

    .rankings-table tbody tr:active {
      background: rgba(255, 255, 255, 0.02);
    }

    .rankings-table td {
      padding: 12px 8px;
      vertical-align: middle;
    }

    .rankings-table td:first-child {
      padding-left: 16px;
      text-align: center;
    }

    .rankings-table td:last-child {
      padding-right: 16px;
      text-align: center;
    }

    .rank-position {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 700;
    }

    .rank-position.gold {
      background: var(--gold-gradient);
      color: #1a1a2e;
    }

    .rank-position.silver {
      background: linear-gradient(135deg, #c0c0c0 0%, #a8a8a8 100%);
      color: #1a1a2e;
    }

    .rank-position.bronze {
      background: linear-gradient(135deg, #cd7f32 0%, #b87333 100%);
      color: white;
    }

    .rank-position.other {
      background: var(--card-bg-light);
      color: var(--text-secondary);
      border: 2px solid var(--border-color);
    }

    .team-user-info {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .user-avatar-small {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--primary-gradient);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 700;
      color: white;
      flex-shrink: 0;
    }

    .team-name-text {
      font-size: 12px;
      font-weight: 500;
      color: var(--text-primary);
    }

    .points-value {
      font-size: 16px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .btn-view-user {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: rgba(102, 126, 234, 0.1);
      color: #667eea;
      text-decoration: none;
      transition: var(--transition);
      font-size: 12px;
    }

    .btn-view-user:active {
      background: rgba(102, 126, 234, 0.2);
      transform: scale(0.95);
    }

    /* Player Cards Section */
    .players-grid {
      padding: 0 16px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .player-card-modern {
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-color);
      overflow: hidden;
      transition: var(--transition);
    }

    .player-card-modern:active {
      transform: translateY(-2px);
    }

    .player-card-header {
      background: var(--primary-gradient);
      padding: 16px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .player-avatar-large {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
      border: 3px solid rgba(255, 255, 255, 0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      overflow: hidden;
    }

    .player-avatar-large img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .player-header-info h3 {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .player-header-info p {
      font-size: 13px;
      opacity: 0.9;
    }

    .player-card-body {
      padding: 16px;
    }

    .player-highlight-stat {
      font-size: 32px;
      font-weight: 700;
      background: var(--gold-gradient);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 16px;
      display: flex;
      align-items: baseline;
      gap: 8px;
    }

    .player-highlight-stat .unit {
      font-size: 14px;
      color: var(--text-secondary);
    }

    .player-stats-row {
      display: flex;
      justify-content: space-between;
      padding: 8px 0;
      border-bottom: 1px solid var(--border-color);
    }

    .player-stats-row:last-child {
      border-bottom: none;
    }

    .stat-label-text {
      font-size: 13px;
      color: var(--text-secondary);
    }

    .stat-value-text {
      font-size: 14px;
      font-weight: 700;
      color: var(--text-primary);
    }

    .player-badges {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 12px;
    }

    .player-badge {
      padding: 4px 10px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 600;
      background: rgba(102, 126, 234, 0.15);
      color: #667eea;
      border: 1px solid rgba(102, 126, 234, 0.3);
    }

    .player-card-footer {
      background: var(--card-bg-light);
      padding: 12px 16px;
      display: flex;
      justify-content: space-around;
      border-top: 1px solid var(--border-color);
    }

    .mini-stat-item {
      text-align: center;
    }

    .mini-stat-value {
      font-size: 16px;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 2px;
    }

    .mini-stat-label {
      font-size: 10px;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* Match Stats Cards */
    .stats-cards-grid {
      padding: 0 16px;
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .stat-category-card {
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-color);
      overflow: hidden;
    }

    .stat-category-header {
      background: var(--card-bg-light);
      padding: 12px 16px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .stat-category-header h3 {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .stat-category-header i {
      color: #667eea;
    }

    .stat-category-body {
      padding: 12px 16px;
    }

    .stat-player-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid var(--border-color);
    }

    .stat-player-item:last-child {
      border-bottom: none;
    }

    .stat-player-info {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .stat-player-avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--primary-gradient);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      color: white;
      overflow: hidden;
      flex-shrink: 0;
    }

    .stat-player-avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .stat-player-name {
      font-size: 14px;
      font-weight: 600;
      color: var(--text-primary);
    }

    .stat-player-value {
      font-size: 14px;
      font-weight: 700;
      color: #667eea;
    }

    .no-data-message {
      text-align: center;
      padding: 24px 16px;
      color: var(--text-secondary);
      font-size: 14px;
    }

    /* Footer */
    .scorecard-footer {
      padding: 24px 16px;
    }

    .btn-back-main {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      padding: 14px;
      border-radius: var(--radius-md);
      background: var(--primary-gradient);
      color: white;
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
      border: none;
      cursor: pointer;
      transition: var(--transition);
    }

    .profile-pic {
      width: 100%;
      height: 100%;
    }

    .profile-pic-overlay {
      position: absolute;
      bottom: 10px;
      right: 10px;
      width: 50px;
      height: 50px;
      background: var(--cricket-gold);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.3s ease;
      border: 3px solid white;
    }
      
    .profile-pic-overlay:hover {
      transform: scale(1.1);
      background: var(--cricket-light-green);
    }
      
    .profile-pic-overlay i {
      color: var(--cricket-green);
      font-size: 20px;
    }

    .btn-back-main:active {
      transform: scale(0.98);
    }

    /* Responsive Design */
    @media (min-width: 640px) {
      .summary-stats-grid {
        gap: 16px;
      }

      .summary-stat-card {
        padding: 20px;
      }

      .summary-stat-value {
        font-size: 28px;
      }

      .summary-stat-label {
        font-size: 12px;
      }
    }

    @media (min-width: 768px) {
      .scorecard-app {
        max-width: 1200px;
        margin: 0 auto;
      }

      .scorecard-header {
        padding: 32px 24px 48px;
        border-radius: 0 0 24px 24px;
      }

      .teams-vs-section {
        margin: -20px 24px 20px;
        padding: 32px 24px;
      }

      .team-flag-circle {
        width: 90px;
        height: 90px;
        font-size: 40px;
      }

      .team-name-label {
        font-size: 16px;
      }

      .summary-stats-grid {
        padding: 0 24px;
      }

      .tabs-container {
        padding: 0 24px;
      }

      .rankings-section,
      .players-grid,
      .stats-cards-grid {
        padding: 0 24px;
      }

      .players-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .stats-cards-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .scorecard-footer {
        padding: 24px 24px;
      }
    }

    @media (min-width: 1024px) {
      .players-grid {
        grid-template-columns: repeat(3, 1fr);
      }

      .stats-cards-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }
  </style>
</head>
<body>
  <div class="scorecard-app">
    <!-- Header -->
    <div class="scorecard-header">
      <div class="header-content">
        <%= link_to after_login_path, class: 'back-button-header' do %>
          <i class="fas fa-arrow-left"></i>
          <span>Back to Overview</span>
        <% end %>
        <h1 class="match-title-header"><%= "#{@team1} vs #{@team2}" %></h1>
        <div class="match-date-header">
          Match Scorecard & Performance Analysis
        </div>
      </div>
    </div>

    <!-- Teams Display -->
    <div class="teams-vs-section">
      <div class="teams-display">
        <div class="team-side">
          <div class="team-logo-mobile"><%= wc_team_logo(@team1, size: :small) %></div>
          <div class="team-name-label"><%= @team1 %></div>
        </div>
        <div class="vs-divider">VS</div>
        <div class="team-side">
          <div class="team-logo-mobile"><%= wc_team_logo(@team2, size: :small) %></div>
          <div class="team-name-label"><%= @team2 %></div>
        </div>
      </div>
    </div>

    <!-- Summary Stats -->
    <div class="summary-stats-grid">
      <div class="summary-stat-card">
        <div class="summary-stat-value"><%= @current_auction_teams.count %></div>
        <div class="summary-stat-label">Teams</div>
      </div>
      <div class="summary-stat-card">
        <div class="summary-stat-value"><%= @highest_score %></div>
        <div class="summary-stat-label">Top Score</div>
      </div>
      <div class="summary-stat-card">
        <div class="summary-stat-value"><%= @avg_score %></div>
        <div class="summary-stat-label">Avg Score</div>
      </div>
    </div>

    <!-- Tabs Navigation -->
    <div class="tabs-container">
      <div class="tabs-nav">
        <button class="tab-button active" data-tab="rankings">
          <i class="fas fa-trophy"></i>
          <span>Rankings</span>
        </button>
        <button class="tab-button" data-tab="top-players">
          <i class="fas fa-star"></i>
          <span>Top Players</span>
        </button>
        <button class="tab-button" data-tab="match-stats">
          <i class="fas fa-chart-bar"></i>
          <span>Stats</span>
        </button>
      </div>
    </div>

    <!-- Rankings Tab -->
    <div id="rankings-tab" class="tab-content active">
      <div class="rankings-section">
        <div class="rankings-table-wrapper">
          <table class="rankings-table">
            <thead>
              <tr>
                <th>Rank</th>
                <th>Team</th>
                <th>XI/Bench</th>
                <th>VIEW</th>
              </tr>
            </thead>
            <tbody>
              <% @team_points.each_with_index do |(team_name, match_points), index| %>
                <tr>
                  <td>
                    <% if index == 0 %>
                      <span class="rank-position gold"><%= index + 1 %></span>
                    <% elsif index == 1 %>
                      <span class="rank-position silver"><%= index + 1 %></span>
                    <% elsif index == 2 %>
                      <span class="rank-position bronze"><%= index + 1 %></span>
                    <% else %>
                      <span class="rank-position other"><%= index + 1 %></span>
                    <% end %>
                  </td>
                  <td>
                    <div class="team-user-info">
                      <div class="user-avatar-small">
                        <% team = @auction.teams.where(team_name:)&.first %>
                        <% if current_user.profile_picture.attached? %>
                          <%= image_tag team.user.profile_picture, class: "profile-pic", id: "profileImage" %>
                        <% else %>
                          <%= team_name.first&.first %>
                          <!-- <#%= current_user.username.first.upcase %> -->
                          <!--   <img src="https://ui-avatars.com/api/?name=<#%= current_user.username %>&background=1B5E20&color=fff&size=200&font-size=0.5" 
                                 alt="Profile Picture" class="profile-pic" id="profileImage"> -->
                        <% end %>
                      </div>
                      <span class="team-name-text"><%= team_name.split(' ').first.truncate(20, omission: '...') %></span>
                    </div>
                  </td>
                  <td>
                    <span class="points-value"><%= match_points %>/<%= @team_bench_points[team_name] %></span>
                  </td>
                  <td>
                    <%= link_to compute_match_team_points_path(auction_id: @auction.id, match_name: @match, user: @auction.teams.where(team_name:)&.first&.user&.username), class: "btn-view-user", data: { turbo: false } do %>
                      <i class="fas fa-chevron-right"></i>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Top Players Tab -->
    <div id="top-players-tab" class="tab-content">
      <div class="players-grid">
        <!-- Man of the Match -->
        <% if @best_player_pp_record.present? %>
          <div class="player-card-modern">
            <div class="player-card-header">
              <div class="player-avatar-large">
                <i class="fas fa-trophy"></i>
              </div>
              <div class="player-header-info">
                <h3><%= @best_player_pp_record.player.name %></h3>
                <p>🏆 Man of the Match</p>
              </div>
            </div>
            <div class="player-card-body">
              <div class="player-highlight-stat">
                <span><%= @best_player_pp_record.runs %> + <%= @best_player_pp_record.wickets %></span>
                <span class="unit">runs + wickets</span>
              </div>
              <div class="player-stats-row">
                <span class="stat-label-text">Strike Rate</span>
                <span class="stat-value-text"><%= @best_player_pp_record.strike_rate %></span>
              </div>
              <div class="player-stats-row">
                <span class="stat-label-text">Economy</span>
                <span class="stat-value-text"><%= @best_player_pp_record.eco %></span>
              </div>
              <div class="player-stats-row">
                <span class="stat-label-text">Fantasy Points</span>
                <span class="stat-value-text"><%= @best_player_total_points || 0 %></span>
              </div>
              <div class="player-badges">
                <span class="player-badge">Power Performer</span>
                <span class="player-badge">Impact Player</span>
              </div>
            </div>
            <div class="player-card-footer">
              <div class="mini-stat-item">
                <div class="mini-stat-value">64%</div>
                <div class="mini-stat-label">Picked</div>
              </div>
              <div class="mini-stat-item">
                <div class="mini-stat-value">3.0</div>
                <div class="mini-stat-label">Overs</div>
              </div>
              <div class="mini-stat-item">
                <div class="mini-stat-value">86.7</div>
                <div class="mini-stat-label">Rating</div>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Top Batsman -->
        <% if @best_batsman.present? %>
          <div class="player-card-modern">
            <div class="player-card-header">
              <div class="player-avatar-large">
                <%= player_image(@best_batsman) %>
                <% if !player_image_tag(@best_batsman) %>
                  <i class="fas fa-baseball-ball"></i>
                <% end %>
              </div>
              <div class="player-header-info">
                <h3><%= @best_batsman.name %></h3>
                <p>🏏 Top Scorer</p>
              </div>
            </div>
            <div class="player-card-body">
              <div class="player-highlight-stat">
                <span><%= @best_batsman_pp_record&.runs %></span>
                <span class="unit">runs</span>
              </div>
              <div class="player-stats-row">
                <span class="stat-label-text">Strike Rate</span>
                <span class="stat-value-text"><%= @best_batsman_pp_record&.strike_rate %></span>
              </div>
              <div class="player-stats-row">
                <span class="stat-label-text">4s / 6s</span>
                <span class="stat-value-text"><%= @best_batsman_pp_record&.fours %> / <%= @best_batsman_pp_record&.sixes %></span>
              </div>
              <div class="player-stats-row">
                <span class="stat-label-text">Fantasy Points</span>
                <span class="stat-value-text"><%= @best_batsman_total_points || 0 %></span>
              </div>
              <div class="player-badges">
                <span class="player-badge">Match Winner</span>
                <span class="player-badge">Most Valuable</span>
              </div>
            </div>
            <div class="player-card-footer">
              <div class="mini-stat-item">
                <div class="mini-stat-value">87%</div>
                <div class="mini-stat-label">Picked</div>
              </div>
              <div class="mini-stat-item">
                <div class="mini-stat-value">32</div>
                <div class="mini-stat-label">Balls</div>
              </div>
              <div class="mini-stat-item">
                <div class="mini-stat-value">95.6</div>
                <div class="mini-stat-label">Rating</div>
              </div>
            </div>
          </div>
        <% end %>

        <!-- Top Bowler -->
        <% if @best_bowler.present? %>
          <div class="player-card-modern">
            <div class="player-card-header">
              <div class="player-avatar-large">
                <%= player_image(@best_bowler) %>
                <% if !player_image_tag(@best_bowler) %>
                  <i class="fas fa-bowling-ball"></i>
                <% end %>
              </div>
              <div class="player-header-info">
                <h3><%= @best_bowler.name %></h3>
                <p>🎯 Top Bowler</p>
              </div>
            </div>
            <div class="player-card-body">
              <div class="player-highlight-stat">
                <span><%= @best_bowler_pp_record&.wickets %></span>
                <span class="unit">wickets</span>
              </div>
              <div class="player-stats-row">
                <span class="stat-label-text">Economy</span>
                <span class="stat-value-text"><%= @best_bowler_pp_record&.eco %></span>
              </div>
              <div class="player-stats-row">
                <span class="stat-label-text">Overs</span>
                <span class="stat-value-text"><%= @best_bowler_pp_record&.overs_bowled %></span>
              </div>
              <div class="player-stats-row">
                <span class="stat-label-text">Fantasy Points</span>
                <span class="stat-value-text"><%= @best_bowler_total_points || 0 %></span>
              </div>
              <div class="player-badges">
                <span class="player-badge">Best Economy</span>
                <span class="player-badge">Death Over Specialist</span>
              </div>
            </div>
            <div class="player-card-footer">
              <div class="mini-stat-item">
                <div class="mini-stat-value">76%</div>
                <div class="mini-stat-label">Picked</div>
              </div>
              <div class="mini-stat-item">
                <div class="mini-stat-value">24</div>
                <div class="mini-stat-label">Runs</div>
              </div>
              <div class="mini-stat-item">
                <div class="mini-stat-value">92.3</div>
                <div class="mini-stat-label">Rating</div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <!-- Match Stats Tab -->
    <div id="match-stats-tab" class="tab-content">
      <div class="stats-cards-grid">
        <!-- Batting Form -->
        <div class="stat-category-card">
          <div class="stat-category-header">
            <i class="fas fa-baseball-ball"></i>
            <h3>Batting Form</h3>
          </div>
          <div class="stat-category-body">
            <% if @current_user_batsmans.present? %>
              <% @current_user_batsmans.each do |player| %>
                <div class="stat-player-item">
                  <div class="stat-player-info">
                    <div class="stat-player-avatar">
                      <%= player_image(player) %>
                      <% if !player_image_tag(player) %>
                        <i class="fas fa-user"></i>
                      <% end %>
                    </div>
                    <span class="stat-player-name"><%= player.name %></span>
                  </div>
                  <span class="stat-player-value"><%= player.player_perfomace_points.where(match: @match)&.last&.runs %> runs</span>
                </div>
              <% end %>
            <% else %>
              <div class="no-data-message">
                <i class="fas fa-info-circle"></i> No batting data available
              </div>
            <% end %>
          </div>
        </div>

        <!-- Bowling Form -->
        <div class="stat-category-card">
          <div class="stat-category-header">
            <i class="fas fa-bowling-ball"></i>
            <h3>Bowling Form</h3>
          </div>
          <div class="stat-category-body">
            <% if @current_user_bowlers.present? %>
              <% @current_user_bowlers.each do |player| %>
                <div class="stat-player-item">
                  <div class="stat-player-info">
                    <div class="stat-player-avatar">
                      <%= player_image(player) %>
                      <% if !player_image_tag(player) %>
                        <i class="fas fa-user"></i>
                      <% end %>
                    </div>
                    <span class="stat-player-name"><%= player.name %></span>
                  </div>
                  <span class="stat-player-value"><%= player.player_perfomace_points.where(match: @match)&.last&.wickets %> wickets</span>
                </div>
              <% end %>
            <% else %>
              <div class="no-data-message">
                <i class="fas fa-info-circle"></i> No bowling data available
              </div>
            <% end %>
          </div>
        </div>

        <!-- Fielding Form -->
        <div class="stat-category-card">
          <div class="stat-category-header">
            <i class="fas fa-hand-paper"></i>
            <h3>Fielding Form</h3>
          </div>
          <div class="stat-category-body">
            <% if @current_user_fielders.present? %>
              <% @current_user_fielders.each do |player| %>
                <div class="stat-player-item">
                  <div class="stat-player-info">
                    <div class="stat-player-avatar">
                      <%= player_image(player) %>
                      <% if !player_image_tag(player) %>
                        <i class="fas fa-user"></i>
                      <% end %>
                    </div>
                    <span class="stat-player-name"><%= player.name %></span>
                  </div>
                  <span class="stat-player-value">
                    <%= player.player_perfomace_points.where(match: @match)&.last&.catches %> catches
                    (<%= player.player_perfomace_points.where(match: @match)&.last&.run_outs %> r/o)
                  </span>
                </div>
              <% end %>
            <% else %>
              <div class="no-data-message">
                <i class="fas fa-info-circle"></i> No fielding data available
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="scorecard-footer">
      <%= link_to after_login_path, class: 'btn-back-main' do %>
        <i class="fas fa-arrow-left"></i>
        <span>Back to Overview</span>
      <% end %>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Tab switching functionality
      const tabButtons = document.querySelectorAll('.tab-button');
      const tabContents = document.querySelectorAll('.tab-content');

      tabButtons.forEach(button => {
        button.addEventListener('click', function() {
          const targetTab = this.dataset.tab;

          // Remove active class from all buttons and contents
          tabButtons.forEach(btn => btn.classList.remove('active'));
          tabContents.forEach(content => content.classList.remove('active'));

          // Add active class to clicked button
          this.classList.add('active');

          // Add active class to corresponding content
          const targetContent = document.getElementById(targetTab + '-tab');
          if (targetContent) {
            targetContent.classList.add('active');
          }
        });
      });
    });
  </script>
</body>
</html>
