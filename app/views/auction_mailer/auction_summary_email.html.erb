<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Auction Results</title>
  <style>
    body {
      font-family: 'Helvetica Neue', Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .header {
      background: linear-gradient(135deg, #4472C4, #2b4c8a);
      color: white;
      padding: 30px;
      border-radius: 12px 12px 0 0;
      text-align: center;
    }
    .content {
      background-color: #ffffff;
      padding: 30px;
      border-radius: 0 0 12px 12px;
      box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }
    .team-card {
      border: 1px solid #eaeaea;
      border-radius: 8px;
      padding: 15px;
      margin-bottom: 20px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }
    .team-header {
      display: flex;
      align-items: center;
      margin-bottom: 15px;
    }
    .team-logo {
      width: 50px;
      height: 50px;
      margin-right: 15px;
    }
    .team-name {
      font-size: 18px;
      font-weight: bold;
      color: #2b4c8a;
    }
    .player-table {
      width: 100%;
      border-collapse: collapse;
    }
    .player-table th {
      background-color: #edf2fa;
      padding: 10px;
      text-align: left;
    }
    .player-table td {
      padding: 8px 10px;
      border-bottom: 1px solid #eaeaea;
    }
    .highlight {
      color: #4472C4;
      font-weight: bold;
    }
    .footer {
      text-align: center;
      margin-top: 30px;
      color: #999;
      font-size: 13px;
    }
    .button {
      display: inline-block;
      background-color: #4472C4;
      color: white;
      text-decoration: none;
      padding: 12px 25px;
      border-radius: 6px;
      font-weight: bold;
      margin-top: 20px;
    }
    @media (max-width: 480px) {
      .header, .content {
        padding: 15px;
      }
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>SPL-9 Teams</h1>
  </div>
  <div class="content">
    <p>Hello SPL-Management,</p>
    <p>Here are the results for all teams:</p>
    
    <% @teams_data.each do |team| %>
      <div class="team-card">
        <div class="team-header">
          <% if team[:logo].present? %>
            <img src="<%= team[:logo] %>" alt="<%= team[:name] %> Logo" class="team-logo">
          <% end %>
          <div>
            <div class="team-name"><%= team[:name] %></div>
            <div>Owner: <%= team[:captain] %></div>
            <div>Budget: <span class="highlight"><%= format_currency(team[:budget_remaining]) %></span></div>
          </div>
        </div>
        
        <table class="player-table">
          <thead>
            <tr>
              <th>Player</th>
              <th>Price</th>
            </tr>
          </thead>
          <tbody>
            <% team[:players].each do |player| %>
              <tr>
                <td><%= player[:name] %></td>
                <td class="highlight"><%= player[:price] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
    
    <p>For more details, please check the attached PDF document with comprehensive auction results.</p>
    
    <div style="text-align: center;">
      <a href="<%= auction_table_url %>" class="button">View Full Results Online</a>
    </div>
    
    <div class="footer">
      <p>This email was sent by PatelPredicts. &copy; <%= Date.today.year %> All rights reserved.</p>
    </div>
  </div>
</body>
</html>
