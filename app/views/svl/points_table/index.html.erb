<!-- ════ HERO ════ -->
<div class="pt-hero">
  <div class="pt-hero-inner">
    <div>
      <div class="pt-hero-badge">
        <div class="pt-live-dot"></div>
        <%= @season&.name || "Season" %>
      </div>
      <div class="pt-hero-title">POINTS<br>TABLE</div>
      <div class="pt-hero-season">Sugam Volleyball League &nbsp;·&nbsp; <%= @teams.size %> Teams</div>
    </div>
    <div class="pt-hero-ball"></div>
  </div>

  <!-- Patel-Predicts marketing strip -->
  <div class="pt-pp-strip">
    <div class="pt-pp-strip-left">
      <div class="pt-pp-logo-circle">PP</div>
      <div class="pt-pp-strip-text">
        <div class="pt-pp-strip-name">Patel-Predicts</div>
        <div class="pt-pp-strip-sub">Official Partner · SVL <%= @season&.name %></div>
      </div>
    </div>
    <div class="pt-pp-strip-badges">
      <div class="pt-pp-role-badge pt-pp-auction">Auction</div>
      <div class="pt-pp-role-badge pt-pp-tech">Tech</div>
    </div>
  </div>
</div>

<!-- ════ PODIUM (top 3) ════ -->
<% if @teams.size >= 3 %>
<div class="pt-podium-wrap">
  <div class="pt-podium-title">Top 3 Teams</div>
  <div class="pt-podium">
    <%
      pod_order   = [1, 0, 2]
      pod_sizes   = { 0 => 72, 1 => 60, 2 => 52 }
      pod_heights = { 0 => 60, 1 => 44, 2 => 34 }
      pod_border  = { 0 => '#FFD700', 1 => '#C0C0C0', 2 => '#CD7F32' }
    %>
    <% pod_order.each do |idx| %>
      <% t = @teams[idx]; next unless t %>
      <% sz = pod_sizes[idx]; ht = pod_heights[idx]; bc = pod_border[idx]; tc = team_color(idx) %>
      <% slug = t.name.to_s.downcase.gsub(/\s+/, '_') %>
      <div class="pt-pod-item">
        <div class="pt-pod-rank-lbl" style="color:<%= idx == 0 ? '#FFD700' : '#64748b' %>">#<%= idx + 1 %></div>
        <div class="pt-pod-img-wrap">
          <% if idx == 0 %><div class="pt-pod-crown">👑</div><% end %>
          <div class="pt-pod-av" style="width:<%= sz %>px;height:<%= sz %>px;background:<%= tc %>;border-color:<%= bc %>;border-width:3px;border-style:solid">
            <% img = svl_team_image(t.name, style: "width:100%;height:100%;object-fit:cover;border-radius:13px", alt: t.name) %>
            <% if img %>
              <%= img %>
            <% else %>
              <%= team_initials(t.name) %>
            <% end %>
          </div>
        </div>
        <div class="pt-pod-name"><%= t.name %></div>
        <div class="pt-pod-pts-row">
          <div class="pt-pod-pts"><%= t.points %></div>
          <div class="pt-pod-pts-lbl">pts</div>
        </div>
        <div class="pt-pod-block" style="height:<%= ht %>px;background:<%= bc %>18;border:1px solid <%= bc %>35">
          <%= idx + 1 %>
        </div>
      </div>
    <% end %>
  </div>
</div>
<% end %>

<!-- ════ STATS STRIP ════ -->
<% if @season %>
<div class="pt-stats-strip">
  <div class="pt-stat-pill">
    <div class="pt-stat-val"><%= @teams.size %></div>
    <div class="pt-stat-lbl">Teams</div>
  </div>
  <div class="pt-stat-pill">
    <div class="pt-stat-val"><%= @all_matches.count rescue 0 %></div>
    <div class="pt-stat-lbl">Matches</div>
  </div>
  <div class="pt-stat-pill">
    <div class="pt-stat-val" style="color:#34d399"><%= @teams.max_by(&:points)&.points || 0 %></div>
    <div class="pt-stat-lbl">Top Pts</div>
  </div>
  <div class="pt-stat-pill">
    <div class="pt-stat-val" style="color:#fbbf24"><%= @teams.max_by { |t| t.set_diff }&.set_diff || 0 %></div>
    <div class="pt-stat-lbl">Best SD</div>
  </div>
  <div class="pt-stat-pill">
    <div class="pt-stat-val" style="color:#60a5fa"><%= @teams.sum(&:no_of_matches_played) / 2 rescue 0 %></div>
    <div class="pt-stat-lbl">Played</div>
  </div>
</div>
<% end %>

<!-- ════ TEAM FILTER BAR ════ -->
<div class="pt-filter-bar">
  <%= link_to svl_points_table_path, class: "pt-filter-chip #{@filter_team.nil? ? 'active' : ''}" do %>
    All Teams
  <% end %>
  <% @teams.each_with_index do |t, i| %>
    <% slug = t.name.to_s.downcase.gsub(/\s+/, '_'); tc = team_color(i) %>
    <%= link_to svl_points_table_path(team_id: t.id), class: "pt-filter-chip #{@filter_team&.id == t.id ? 'active' : ''}" do %>
      <div class="pt-filter-chip-av" style="background:<%= tc %>">
        <%= image_tag "v_#{slug}.png", onerror: "this.style.display='none';this.nextElementSibling.style.display='flex'", style: "width:100%;height:100%;object-fit:cover;border-radius:50%" rescue '' %>
        <span style="display:flex;align-items:center;justify-content:center;font-size:8px;font-weight:700;color:#fff"><%= team_initials(t.name) %></span>
      </div>
      <%= t.name.split(' ').last %>
    <% end %>
  <% end %>
</div>

<!-- ════ MAIN CONTENT ════ -->
<div class="pt-main">

  <!-- TABLE SECTION -->
  <div class="pt-table-section">
    <div class="pt-section-hdr">
      <div class="pt-section-title">
        <% if @filter_team %>
          <%= @filter_team.name %> — Matches
        <% else %>
          Standings
        <% end %>
      </div>
      <div style="font-size:9px;color:var(--text3);letter-spacing:.5px">Updated live</div>
    </div>

    <!-- Column headers -->
    <div class="pt-col-hdr">
      <div class="pt-ch">#</div>
      <div class="pt-ch" style="text-align:left">Team</div>
      <div class="pt-ch">P</div>
      <div class="pt-ch">W</div>
      <div class="pt-ch">L</div>
      <div class="pt-ch">PTS D</div>
      <div class="pt-ch">SET D</div>
      <div class="pt-ch">PTS</div>
    </div>

    <% if @teams.empty? %>
      <div class="pt-empty">
        <div class="pt-empty-icon">🏐</div>
        <div class="pt-empty-title">No teams yet</div>
        <div class="pt-empty-sub">Teams appear once the season begins.</div>
      </div>
    <% else %>
      <% @teams.each_with_index do |team, i| %>
        <%
          rank     = i + 1
          rank_cls = rank == 1 ? 'gold' : rank == 2 ? 'silver' : rank == 3 ? 'bronze' : ''
          row_cls  = rank <= 3 ? "rank-#{rank}" : ''
          row_cls  += ' filtered' if @filter_team&.id == team.id
          tc       = team_color(i)
          played   = team.no_of_matches_played
          won      = team.no_of_matches_won
          lost     = team.no_of_matches_lost
          pd       = team.points_diff
          sd       = team.set_diff
          pts      = team.points
          pd_cls   = pd > 0 ? 'pos' : pd < 0 ? 'neg' : 'zero'
          sd_cls   = sd > 0 ? 'pos' : sd < 0 ? 'neg' : 'zero'
          w_pct    = played > 0 ? (won.to_f / played * 100).round : 0
          slug     = team.name.to_s.downcase.gsub(/\s+/, '_')
          filter_url = @filter_team&.id == team.id ? svl_points_table_path : svl_points_table_path(team_id: team.id)
        %>
        <%= link_to filter_url, class: "pt-team-row #{row_cls}", style: "--row-accent:#{tc};animation-delay:#{i * 0.055}s" do %>

          <!-- Rank -->
          <div class="pt-rank <%= rank_cls %>"><%= rank %></div>

          <!-- Team: image on top, name below (mobile) / side by side (desktop) -->
          <div class="pt-team-cell">
            <%# In the standings table rows — replace the pt-team-av content %>
            <div class="pt-team-av" style="background:<%= tc %>">
              <% img = svl_team_image(team.name, style: "width:100%;height:100%;object-fit:cover;border-radius:12px", alt: team.name) %>
              <% if img %>
                <%= img %>
              <% else %>
                <span style="font-family:'Rajdhani',sans-serif;font-size:12px;font-weight:700;color:#fff">
                  <%= team_initials(team.name) %>
                </span>
              <% end %>
            </div>
            <div class="pt-team-name"><%= format_svl_team_name(team.name) %></div>
          </div>

          <!-- Stats -->
          <div class="pt-cell"><%= played %></div>
          <div class="pt-cell" style="color:#34d399"><%= won %></div>
          <div class="pt-cell" style="color:#f87171"><%= lost %></div>
          <div class="pt-cell <%= pd_cls %>"><%= pd > 0 ? "+#{pd}" : pd %></div>
          <div class="pt-cell <%= sd_cls %>"><%= sd > 0 ? "+#{sd}" : sd %></div>
          <div class="pt-pts-cell">
            <div class="pt-pts-badge <%= rank <= 3 ? 'top' : '' %>"><%= pts %></div>
          </div>

        <% end %>
      <% end %>
    <% end %>
  </div><!-- /table-section -->

  <!-- MATCHES SECTION -->
  <div class="pt-matches-section">
    <% if @filter_team %>
      <div class="pt-filter-banner">
        <div class="pt-filter-banner-text">🏐 <%= @filter_team.name %></div>
        <%= link_to "✕ All Teams", svl_points_table_path, class: "pt-filter-clear" %>
      </div>
    <% end %>
    <div class="pt-section-hdr">
      <div class="pt-section-title">
        <%= @filter_team ? "#{@filter_team.name} Matches" : "Recent Matches" %>
      </div>
    </div>

    <div class="pt-matches-list">
      <% if @matches.empty? %>
        <div style="padding:24px 0;text-align:center;color:var(--text3);font-size:12px">
          No matches yet
        </div>
      <% else %>
        <% @matches.each_with_index do |match, mi| %>
          <%
            wt      = match.winning_team
            lt      = match.losing_team
            sets    = match.match_sets.order(:set_number)
            w_pts   = match.winning_team_points
            l_pts   = match.losing_team_points
            pts_diff = w_pts - l_pts   # winner's points diff for this match
            # Set diff for this match: winner always has positive set diff
            w_sets_won = match.winning_team_sets
            l_sets_won = match.losing_team_sets
            set_diff_val = w_sets_won - l_sets_won  # e.g. +2 for 2-0, +1 for 2-1
            pts_diff_cls = pts_diff > 0 ? 'pos' : pts_diff < 0 ? 'neg' : 'zero'
            sd_cls = set_diff_val > 0 ? 'pos' : set_diff_val < 0 ? 'neg' : 'zero'
            highlight_winner = @filter_team && @filter_team.id == wt&.id
            highlight_loser  = @filter_team && @filter_team.id == lt&.id
          %>
          <div class="pt-match-card" style="animation-delay:<%= mi * 0.06 %>s">
            <div class="pt-match-date"><%= match.played_on&.strftime('%d %b') || '—' %></div>
            <div class="pt-match-teams">

              <!-- Winner -->
              <div class="pt-match-team-row">
                <div class="pt-match-team-name winner <%= 'highlight' if highlight_winner %>">
                  🏆 <%= wt&.name || '—' %>
                </div>
                <div class="pt-match-sets">
                  <% sets.each do |s| %>
                    <span class="pt-match-set-chip win"><%= s.winning_team_score %></span>
                  <% end %>
                </div>
                <div class="pt-match-total"><%= w_pts %></div>
              </div>

              <div class="pt-match-divider"></div>

              <!-- Loser -->
              <div class="pt-match-team-row">
                <div class="pt-match-team-name <%= 'highlight' if highlight_loser %>">
                  <%= lt&.name || '—' %>
                </div>
                <div class="pt-match-sets">
                  <% sets.each do |s| %>
                    <span class="pt-match-set-chip"><%= s.losing_team_score %></span>
                  <% end %>
                </div>
                <div class="pt-match-total" style="color:var(--text3)"><%= l_pts %></div>
              </div>

              <!-- Diff row -->
              <div class="pt-match-diffs">
                <div class="pt-match-diff-chip">
                  <span class="pt-match-diff-lbl">SET D</span>
                  <span class="pt-match-diff-val <%= sd_cls %>">
                    <%= set_diff_val > 0 ? "+#{set_diff_val}" : set_diff_val %>
                    /
                    <%= set_diff_val < 0 ? "+#{set_diff_val.abs}" : "-#{set_diff_val.abs}" %>
                  </span>
                </div>
                <div class="pt-match-diff-chip">
                  <span class="pt-match-diff-lbl">PTS D</span>
                  <span class="pt-match-diff-val <%= pts_diff_cls %>">
                    +<%= pts_diff %> / -<%= pts_diff %>
                  </span>
                </div>
                <div class="pt-match-diff-chip" style="margin-left:auto">
                  <span class="pt-match-diff-lbl">SETS</span>
                  <span class="pt-match-diff-val" style="color:var(--text2)">
                    <%= w_sets_won %>–<%= l_sets_won %>
                  </span>
                </div>
              </div>

            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div><!-- /matches-section -->

</div><!-- /pt-main -->

<!-- ════ KNOCKOUT BRACKET ════ -->
<% if @semi_matches.present? || @final_matches.present?  %>
<div class="pt-knockout-wrap" style="border-top: 2px solid rgba(167,139,250,0.15); background: linear-gradient(180deg, rgba(167,139,250,0.03) 0%, transparent 60%); padding-bottom: 8px;">

  <!-- Stage flow bar -->
  <%
    league_done    = @league_matches.any?
    semi_played    = @semi_matches.any?(&:winning_team_id?)
    final_played   = @final_matches.any?(&:winning_team_id?)
    league_class   = 'stage-done'
    semi_class     = semi_played ? 'stage-done' : (league_done ? 'stage-live' : 'stage-locked')
    final_class    = final_played ? 'stage-done' : (semi_played ? 'stage-live' : 'stage-locked')
    league_badge   = 'badge-ko-done'
    semi_badge     = semi_played ? 'badge-ko-done' : (league_done ? 'badge-ko-live' : 'badge-ko-next')
    final_badge    = final_played ? 'badge-ko-done' : (semi_played ? 'badge-ko-live' : 'badge-ko-next')
    league_badge_t = 'Done'
    semi_badge_t   = semi_played ? 'Done' : (league_done ? 'Live' : 'TBD')
    final_badge_t  = final_played ? 'Done' : (semi_played ? 'Live' : 'TBD')
  %>
  <div class="ko-flow">
    <div class="ko-flow-step <%= league_class %>">
      <div class="ko-flow-icon">🏐</div>
      <div class="ko-flow-name">League</div>
      <div class="ko-flow-badge <%= league_badge %>"><%= league_badge_t %></div>
    </div>
    <div class="ko-flow-step <%= semi_class %>">
      <div class="ko-flow-icon">⚡</div>
      <div class="ko-flow-name">Semi</div>
      <div class="ko-flow-badge <%= semi_badge %>"><%= semi_badge_t %></div>
    </div>
    <div class="ko-flow-step <%= final_class %>">
      <div class="ko-flow-icon">🏆</div>
      <div class="ko-flow-name">Final</div>
      <div class="ko-flow-badge <%= final_badge %>"><%= final_badge_t %></div>
    </div>
  </div>

  <!-- Section header -->
  <div class="pt-section-hdr" style="padding-top:16px">
    <div class="pt-section-title" style="color:#c4b5fd">
      ⚡ Knockout Stage
    </div>
    <div style="font-size:9px;color:var(--text3)">Points table unaffected</div>
  </div>

  <!-- Advancement tracker (top 3) -->
  <% if @teams.size >= 3 %>
  <div class="ko-advance-strip">
    <% @teams.first(3).each_with_index do |t, i| %>
      <% tc = team_color(i) %>
      <% adv_cls = i == 0 ? 'direct-final' : '' %>
      <div class="ko-adv-card <%= adv_cls %>">
        <div class="ko-adv-rank"><%= i == 0 ? '👑' : "##{i+1}" %></div>
        <div class="ko-adv-av" style="background:<%= tc %>">
          <% img = svl_team_image(t.name, style: "width:100%;height:100%;object-fit:cover;border-radius:8px", alt: t.name) %>
          <% if img %><%= img %><% else %><%= team_initials(t.name) %><% end %>
        </div>
        <div class="ko-adv-name"><%= t.name.split(' ').last %></div>
        <div class="ko-adv-label"><%= i == 0 ? 'Direct Final' : 'Semi-Final' %></div>
      </div>
    <% end %>
  </div>
  <% end %>

  <!-- Eliminated teams -->
  <% @eliminated_teams.each_with_index do |t, i| %>
    <% tc = team_color(i + 3) %>
    <div class="ko-elim-strip">
      <div class="ko-elim-av" style="background:<%= tc %>">
        <% img = svl_team_image(t.name, style: "width:100%;height:100%;object-fit:cover;border-radius:10px", alt: t.name) %>
        <% if img %><%= img %><% else %><%= team_initials(t.name) %><% end %>
      </div>
      <div>
        <div class="ko-elim-name">⛔ <%= t.name %></div>
        <div class="ko-elim-sub">Eliminated · #{i + 4}th place · League stage</div>
      </div>
    </div>
  <% end %>

  <!-- SEMI-FINAL MATCHES -->
  <% if @semi_matches.any? %>
    <div class="ko-stage-lbl lbl-semi">Semi-Final</div>
    <div class="ko2-cards">
      <% @semi_matches.each do |match| %>
        <% wt = match.winning_team; lt = match.losing_team %>
        <% played = wt.present? && lt.present? %>
        <% sets = match.match_sets.order(:set_number) %>
        <div class="ko2-card semi <%= 'played' if played %>">
          <div class="ko2-card-head">
            <div class="badge-ko-semi">⚡ Semi-Final</div>
            <div class="ko2-card-date"><%= match.played_on&.strftime('%d %b') || 'TBD' %></div>
          </div>
          <div class="ko2-match-body">
            <!-- Winner / Team A -->
            <div class="ko2-team-side <%= 'ko2-loser-dim' if played && wt.nil? %>">
              <% if wt %>
                <% idx = @teams.index { |t| t.id == wt.id } || 0 %>
                <div class="ko2-team-av" style="background:<%= team_color(idx) %>">
                  <% img = svl_team_image(wt.name, style: "width:100%;height:100%;object-fit:cover;border-radius:12px", alt: wt.name) %>
                  <% if img %><%= img %><% else %><%= team_initials(wt.name) %><% end %>
                </div>
                <div class="ko2-team-name"><%= wt.name.split(' ').last %></div>
                <div class="ko2-winner-tag">WIN →</div>
              <% else %>
                <div class="ko2-team-av tbd">?</div>
                <div class="ko2-team-name" style="color:var(--text3)">TBD</div>
              <% end %>
            </div>
            <!-- Score -->
            <div class="ko2-score-mid">
              <% if played %>
                <div class="ko2-sets">
                  <span class="ko2-ss win"><%= match.winning_team_sets %></span>
                  <span class="ko2-ss-sep">–</span>
                  <span class="ko2-ss"><%= match.losing_team_sets %></span>
                </div>
                <div class="ko2-pts">
                  <span style="color:#34d399"><%= match.winning_team_points %></span>
                  <span style="color:var(--text3);margin:0 2px">·</span>
                  <span><%= match.losing_team_points %></span>
                </div>
                <div class="ko2-set-chips">
                  <% sets.each do |s| %>
                    <div class="ko2-set-row">
                      <span class="ko2-chip win"><%= s.winning_team_score %></span>
                      <span class="ko2-chip-sep">–</span>
                      <span class="ko2-chip"><%= s.losing_team_score %></span>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="ko2-vs">VS</div>
              <% end %>
            </div>
            <!-- Loser / Team B -->
            <div class="ko2-team-side <%= 'ko2-loser-dim' if played %>">
              <% if lt %>
                <% idx = @teams.index { |t| t.id == lt.id } || 1 %>
                <div class="ko2-team-av" style="background:<%= team_color(idx) %>">
                  <% img = svl_team_image(lt.name, style: "width:100%;height:100%;object-fit:cover;border-radius:12px", alt: lt.name) %>
                  <% if img %><%= img %><% else %><%= team_initials(lt.name) %><% end %>
                </div>
                <div class="ko2-team-name"><%= lt.name.split(' ').last %></div>
              <% else %>
                <div class="ko2-team-av tbd">?</div>
                <div class="ko2-team-name" style="color:var(--text3)">TBD</div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- FINAL MATCH -->
  <% if @final_matches.any? %>
    <div class="ko-stage-lbl lbl-final">Final</div>
    <div class="ko2-cards">
      <% @final_matches.each do |match| %>
        <% wt = match.winning_team; lt = match.losing_team %>
        <% played = wt.present? && lt.present? %>
        <% sets = match.match_sets.order(:set_number) %>
        <div class="ko2-card final <%= 'played' if played %>">
          <div class="ko2-card-head">
            <div class="badge-ko-final">🏆 Final</div>
            <div class="ko2-card-date"><%= match.played_on&.strftime('%d %b') || 'TBD' %></div>
          </div>
          <div class="ko2-match-body">
            <div class="ko2-team-side">
              <% if wt %>
                <% idx = @teams.index { |t| t.id == wt.id } || 0 %>
                <div class="ko2-team-av" style="background:<%= team_color(idx) %>">
                  <% img = svl_team_image(wt.name, style: "width:100%;height:100%;object-fit:cover;border-radius:12px", alt: wt.name) %>
                  <% if img %><%= img %><% else %><%= team_initials(wt.name) %><% end %>
                </div>
                <div class="ko2-team-name"><%= wt.name.split(' ').last %></div>
                <% if played %><div class="ko2-winner-tag ko2-final-winner-tag">🏆 Champion</div><% end %>
              <% else %>
                <!-- Show rank-1 team as placeholder if not yet played -->
                <% r1 = @league_rank_1 %>
                <% if r1 %>
                  <% idx = @teams.index { |t| t.id == r1.id } || 0 %>
                  <div class="ko2-team-av" style="background:<%= team_color(idx) %>">
                    <% img = svl_team_image(r1.name, style: "width:100%;height:100%;object-fit:cover;border-radius:12px", alt: r1.name) %>
                    <% if img %><%= img %><% else %><%= team_initials(r1.name) %><% end %>
                  </div>
                  <div class="ko2-team-name"><%= r1.name.split(' ').last %></div>
                  <div style="font-size:9px;color:rgba(245,158,11,0.6);letter-spacing:.5px;">#1 · Direct</div>
                <% end %>
              <% end %>
            </div>
            <div class="ko2-score-mid">
              <% if played %>
                <div class="ko2-sets">
                  <span class="ko2-ss win"><%= match.winning_team_sets %></span>
                  <span class="ko2-ss-sep">–</span>
                  <span class="ko2-ss"><%= match.losing_team_sets %></span>
                </div>
                <div class="ko2-pts">
                  <span style="color:#34d399"><%= match.winning_team_points %></span>
                  <span style="color:var(--text3);margin:0 2px">·</span>
                  <span><%= match.losing_team_points %></span>
                </div>
                <div class="ko2-set-chips">
                  <% sets.each do |s| %>
                    <div class="ko2-set-row">
                      <span class="ko2-chip win"><%= s.winning_team_score %></span>
                      <span class="ko2-chip-sep">–</span>
                      <span class="ko2-chip"><%= s.losing_team_score %></span>
                    </div>
                  <% end %>
                </div>
              <% else %>
                <div class="ko2-vs">VS</div>
                <div class="badge-ko-tbd" style="margin-top:4px;font-size:8px;font-weight:800;letter-spacing:1px;text-transform:uppercase;padding:3px 9px;border-radius:20px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:var(--text3)">Upcoming</div>
              <% end %>
            </div>
            <div class="ko2-team-side">
              <% if lt %>
                <% idx = @teams.index { |t| t.id == lt.id } || 1 %>
                <div class="ko2-team-av" style="background:<%= team_color(idx) %>">
                  <% img = svl_team_image(lt.name, style: "width:100%;height:100%;object-fit:cover;border-radius:12px", alt: lt.name) %>
                  <% if img %><%= img %><% else %><%= team_initials(lt.name) %><% end %>
                </div>
                <div class="ko2-team-name"><%= lt.name.split(' ').last %></div>
                <% if played %><div style="opacity:.4;font-size:9px;color:var(--text3)">Runner-up</div><% end %>
              <% else %>
                <div class="ko2-team-av tbd">⚡</div>
                <div class="ko2-team-name" style="color:var(--text3)">Semi winner</div>
                <div style="font-size:9px;color:var(--text3);letter-spacing:.5px;">From semi</div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% elsif @semi_matches.any? %>
    <%# Show a placeholder Final card if semi exists but final not created yet %>
    <div class="ko-stage-lbl lbl-final">Final</div>
    <div class="ko2-cards">
      <div class="ko2-card final">
        <div class="ko2-card-head">
          <div class="badge-ko-final">🏆 Final</div>
          <div class="ko2-card-date">TBD</div>
        </div>
        <div class="ko2-match-body">
          <div class="ko2-team-side">
            <% r1 = @league_rank_1 %>
            <% if r1 %>
              <% idx = @teams.index { |t| t.id == r1.id } || 0 %>
              <div class="ko2-team-av" style="background:<%= team_color(idx) %>">
                <% img = svl_team_image(r1.name, style: "width:100%;height:100%;object-fit:cover;border-radius:12px", alt: r1.name) %>
                <% if img %><%= img %><% else %><%= team_initials(r1.name) %><% end %>
              </div>
              <div class="ko2-team-name"><%= r1.name.split(' ').last %></div>
              <div style="font-size:9px;color:rgba(245,158,11,0.6);letter-spacing:.5px;">#1 · Direct</div>
            <% end %>
          </div>
          <div class="ko2-score-mid">
            <div class="ko2-vs">VS</div>
            <div style="font-size:8px;font-weight:800;letter-spacing:1px;text-transform:uppercase;padding:3px 9px;border-radius:20px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);color:var(--text3);margin-top:4px">Upcoming</div>
          </div>
          <div class="ko2-team-side">
            <div class="ko2-team-av tbd">⚡</div>
            <div class="ko2-team-name" style="color:var(--text3)">Semi winner</div>
            <div style="font-size:9px;color:var(--text3)">From semi</div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Legend -->
  <div class="ko2-legend">
    <div class="ko2-legend-row">
      <div class="ko2-legend-dot" style="background:var(--gold)"></div>
      <span><strong>#1</strong> advances directly to the Final — no semi needed</span>
    </div>
    <div class="ko2-legend-row">
      <div class="ko2-legend-dot" style="background:#a78bfa"></div>
      <span><strong>#2 vs #3</strong> play a semi-final — winner reaches the Final</span>
    </div>
    <div class="ko2-legend-row">
      <div class="ko2-legend-dot" style="background:var(--red)"></div>
      <span><strong>#4</strong> is eliminated after the league stage</span>
    </div>
  </div>

</div>
<% end %>

