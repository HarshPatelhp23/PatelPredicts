<script>
/* ══════════════════════════════════════════
   SVL SCORER — State & Logic
══════════════════════════════════════════ */

const TEAMS = SVL_TEAMS;
let teamA = null, teamB = null;

// Match state
let currentSet = 1;
let scoreA = 0, scoreB = 0;
let historyA = [], historyB = []; // per-current-set undo stacks
let completedSets = []; // [{a, b, winner}]


/* ─── Match type ─── */
let selectedMatchType = 'league';

function selectMatchType(type, btn) {
  selectedMatchType = type;
  document.querySelectorAll('.svl-type-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
}

// Show knockout badge on scorer screen when not a league match
function updateKnockoutBadge() {
  const badge = document.getElementById('knockout-badge');
  const label = document.getElementById('knockout-badge-label');
  if (selectedMatchType !== 'league') {
    const labels = { semi_fnal: 'Semi-Final', eliminator: 'ELIMINATOR', final: 'FINAL' };
    label.textContent = labels[selectedMatchType] || selectedMatchType.toUpperCase();
    badge.classList.add('show');
  } else {
    badge.classList.remove('show');
  }
}

/* ─── Team selection ─── */
function buildTeamGrids() {
  ['a','b'].forEach(side => {
    const grid = document.getElementById(`team-grid-${side}`);
    grid.innerHTML = '';
    TEAMS.forEach(t => {
      const btn = document.createElement('div');
      btn.className = 'svl-team-btn';
      btn.dataset.id   = t.id;
      btn.dataset.name = t.name;

      const avatarHtml = t.image
        ? `<div class="svl-team-av svl-team-av-img">
             <img src="${t.image}" alt="${t.name}"
               onerror="this.parentElement.innerHTML='<span>${initials(t.name)}</span>'"
               style="width:100%;height:100%;object-fit:cover;border-radius:10px">
           </div>`
        : `<div class="svl-team-av">${initials(t.name)}</div>`;

      btn.innerHTML = `
        ${avatarHtml}
        <div class="svl-team-btn-name">${t.name}</div>
        <div class="svl-team-check">✓</div>`;
      btn.onclick = () => selectTeam(side, t, btn);
      grid.appendChild(btn);
    });
  });
}

function selectTeam(side, team, btn) {
  // Deselect all in this grid
  document.querySelectorAll(`#team-grid-${side} .svl-team-btn`).forEach(b => {
    b.classList.remove('selected-a', 'selected-b');
  });
  btn.classList.add(side === 'a' ? 'selected-a' : 'selected-b');
  if (side === 'a') teamA = team;
  else              teamB = team;
  checkStartReady();
}

function checkStartReady() {
  const btn = document.getElementById('start-match-btn');
  const ready = teamA && teamB && teamA.id !== teamB.id;
  btn.classList.toggle('ready', ready);
  if (teamA && teamB && teamA.id === teamB.id) {
    showToast('Pick two different teams', 'err');
  }
}

function startMatch() {
  if (!teamA || !teamB || teamA.id === teamB.id) return;
  document.getElementById('score-name-a').textContent = teamA.name.toUpperCase();
  document.getElementById('score-name-b').textContent = teamB.name.toUpperCase();
  document.getElementById('undo-a-name').textContent  = teamA.name.split(' ')[0];
  document.getElementById('undo-b-name').textContent  = teamB.name.split(' ')[0];
  document.getElementById('scorer-subtitle').textContent = `${teamA.name} vs ${teamB.name}`;
  updateKnockoutBadge();
  resetCurrentSet();
  showScreen('screen-scorer');
}

/* ─── Scoring ─── */
function addPoint(side, event) {
  if (side === 'a') {
    scoreA++;
    historyA.push(1);
    animateScore('score-a', event, '#34d399');
  } else {
    scoreB++;
    historyB.push(1);
    animateScore('score-b', event, '#fbbf24');
  }
  updateScoreDisplay();
  updateUndoBtns();
}

function undoPoint(side) {
  if (side === 'a' && historyA.length > 0) {
    historyA.pop(); scoreA = Math.max(0, scoreA - 1);
  } else if (side === 'b' && historyB.length > 0) {
    historyB.pop(); scoreB = Math.max(0, scoreB - 1);
  }
  updateScoreDisplay();
  updateUndoBtns();
}

function updateScoreDisplay() {
  document.getElementById('score-a').textContent = scoreA;
  document.getElementById('score-b').textContent = scoreB;
}

function updateUndoBtns() {
  document.getElementById('undo-a').disabled = historyA.length === 0;
  document.getElementById('undo-b').disabled = historyB.length === 0;
}

function animateScore(elId, event, color) {
  const el = document.getElementById(elId);
  el.classList.remove('bump');
  void el.offsetWidth; // reflow
  el.classList.add('bump');

  // Ripple
  const half = el.closest('.svl-score-half');
  const rect = half.getBoundingClientRect();
  const ripple = document.createElement('div');
  ripple.className = 'svl-score-ripple';
  const size = 80;
  const x = (event?.clientX ?? rect.left + rect.width/2) - rect.left - size/2;
  const y = (event?.clientY ?? rect.top  + rect.height/2) - rect.top  - size/2;
  ripple.style.cssText = `width:${size}px;height:${size}px;left:${x}px;top:${y}px;background:${color};`;
  half.appendChild(ripple);
  setTimeout(() => ripple.remove(), 500);

  // +1 float
  const float = document.createElement('div');
  float.className = 'svl-plus-float';
  float.style.cssText = `left:${x+size/2}px;top:${y}px;color:${color};`;
  float.textContent = '+1';
  half.appendChild(float);
  setTimeout(() => float.remove(), 700);

  // Remove bump class after animation
  setTimeout(() => el.classList.remove('bump'), 200);
}

/* ─── Set management ─── */
function resetCurrentSet() {
  scoreA = 0; scoreB = 0;
  historyA = []; historyB = [];
  updateScoreDisplay();
  updateUndoBtns();
}

function openEndSetSheet() {
  const setDoc = document.getElementById('end-set-title');
  const setSub = document.getElementById('end-set-sub');
  setDoc.textContent = `End Set ${currentSet}?`;

  const aName = teamA?.name || 'Team A';
  const bName = teamB?.name || 'Team B';

  if (scoreA === scoreB) {
    setSub.textContent = `Score is tied ${scoreA} – ${scoreB}. You can still end the set.`;
  } else {
    const winner = scoreA > scoreB ? aName : bName;
    setSub.textContent = `Current score: ${aName} ${scoreA} – ${scoreB} ${bName}. ${winner} wins this set.`;
  }
  openSheet('end-set-overlay');
}

function confirmEndSet() {
  closeSheet('end-set-overlay');
  const winner = scoreA > scoreB ? 'a' : scoreB > scoreA ? 'b' : null;
  completedSets.push({ a: scoreA, b: scoreB, winner });

  // Update pip
  const pip = document.getElementById(`pip-${currentSet - 1}`);
  if (winner === 'a') pip.classList.add('done-a');
  else if (winner === 'b') pip.classList.add('done-b');
  else { pip.classList.remove('active'); pip.style.background = 'rgba(255,255,255,0.25)'; }

  renderSetScoresBar();

  // Check if match is decided (best of 3: first to 2 set wins)
  const setsWonA = completedSets.filter(s => s.winner === 'a').length;
  const setsWonB = completedSets.filter(s => s.winner === 'b').length;
  const matchDecided = setsWonA === 2 || setsWonB === 2;

  if (currentSet < 3 && !matchDecided) {
    currentSet++;
    document.getElementById('set-label').textContent = `SET ${currentSet}`;
    const nextPip = document.getElementById(`pip-${currentSet - 1}`);
    if (nextPip) nextPip.classList.add('active');
    resetCurrentSet();
    showToast(`Set ${currentSet - 1} done! Starting Set ${currentSet}`);
  } else {
    // Go to result
    showResult();
  }
}

function openEndMatchSheet() {
  const aName = teamA?.name || 'Team A';
  const bName = teamB?.name || 'Team B';
  const setsWonA = completedSets.filter(s => s.winner === 'a').length;
  const setsWonB = completedSets.filter(s => s.winner === 'b').length;
  document.getElementById('end-match-sub').textContent =
    `${completedSets.length} set(s) completed. ${aName}: ${setsWonA} sets, ${bName}: ${setsWonB} sets.`;
  openSheet('end-match-overlay');
}

function confirmEndMatch() {
  closeSheet('end-match-overlay');
  // Save current set if there are any points
  if (scoreA > 0 || scoreB > 0) {
    const winner = scoreA > scoreB ? 'a' : scoreB > scoreA ? 'b' : null;
    completedSets.push({ a: scoreA, b: scoreB, winner });
    renderSetScoresBar();
  }
  showResult();
}

/* ─── Result screen ─── */
function showResult() {
  const aName = teamA?.name || 'Team A';
  const bName = teamB?.name || 'Team B';
  const setsWonA = completedSets.filter(s => s.winner === 'a').length;
  const setsWonB = completedSets.filter(s => s.winner === 'b').length;
  const totalA   = completedSets.reduce((sum, s) => sum + s.a, 0);
  const totalB   = completedSets.reduce((sum, s) => sum + s.b, 0);

  // Determine match winner
  let matchWinner = null;
  if (setsWonA > setsWonB)       matchWinner = 'a';
  else if (setsWonB > setsWonA)  matchWinner = 'b';

  document.getElementById('result-winner-name').textContent =
    matchWinner === 'a' ? aName : matchWinner === 'b' ? bName : 'Match Tied';
  document.getElementById('result-sub').textContent =
    matchWinner ? `wins the match ${setsWonA > setsWonB ? setsWonA+'-'+setsWonB : setsWonB+'-'+setsWonA}` : 'No winner';

  // Set breakdown
  const setsList = document.getElementById('result-sets-list');
  setsList.innerHTML = '';
  completedSets.forEach((s, i) => {
    const winnerName = s.winner === 'a' ? aName : s.winner === 'b' ? bName : 'Tied';
    const row = document.createElement('div');
    row.className = 'svl-result-set-row';
    row.innerHTML = `
      <div class="svl-result-set-num">SET ${i+1}</div>
      <div class="svl-result-set-score">
        <span class="svl-rss-a">${s.a}</span>
        <span class="svl-rss-sep">–</span>
        <span class="svl-rss-b">${s.b}</span>
      </div>
      <div class="svl-result-set-winner" style="color:${s.winner==='a'?'#34d399':s.winner==='b'?'#fbbf24':'#64748b'}">${winnerName}</div>`;
    setsList.appendChild(row);
  });

  // Totals
  document.getElementById('rtc-a-name').textContent = aName;
  document.getElementById('rtc-b-name').textContent = bName;
  document.getElementById('rtc-a-pts').textContent  = totalA;
  document.getElementById('rtc-b-pts').textContent  = totalB;
  document.getElementById('rtc-a-sets').textContent = `${setsWonA} set${setsWonA!==1?'s':''} won`;
  document.getElementById('rtc-b-sets').textContent = `${setsWonB} set${setsWonB!==1?'s':''} won`;

  // Highlight winner card
  const rtcA = document.getElementById('rtc-a');
  const rtcB = document.getElementById('rtc-b');
  rtcA.classList.toggle('winner', matchWinner === 'a');
  rtcB.classList.toggle('winner', matchWinner === 'b');

  showScreen('screen-result');
}

/* ─── Save to server ─── */
function saveMatch() {
  const btn = document.getElementById('save-match-btn');
  btn.disabled = true;
  btn.textContent = 'Saving…';

  const setsWonA = completedSets.filter(s => s.winner === 'a').length;
  const setsWonB = completedSets.filter(s => s.winner === 'b').length;
  const winningTeamId  = setsWonA > setsWonB ? teamA.id : teamB.id;
  const losingTeamId   = setsWonA > setsWonB ? teamB.id : teamA.id;

  // Build sets array: scores from winner's perspective
  const setsPayload = completedSets.map(s => {
    if (setsWonA >= setsWonB) {
      // teamA is winner
      return { winning_score: s.a, losing_score: s.b };
    } else {
      // teamB is winner
      return { winning_score: s.b, losing_score: s.a };
    }
  });

  fetch(SVL_SAVE_URL, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': SVL_CSRF },
    body: JSON.stringify({
      season_id:       SVL_SEASON.id,
      winning_team_id: winningTeamId,
      losing_team_id:  losingTeamId,
      match_type:      selectedMatchType,
      sets:            setsPayload
    })
  })
  .then(r => r.json())
  .then(data => {
    if (data.success) {
      showToast('✓ Match saved!');
      setTimeout(() => window.location.href = '/spl/dashboard', 1200);
    } else {
      showToast(data.error || 'Save failed', 'err');
      btn.disabled = false;
      btn.textContent = '💾 Save Match';
    }
  })
  .catch(() => {
    showToast('Network error', 'err');
    btn.disabled = false;
    btn.textContent = '💾 Save Match';
  });
}

function discardMatch() {
  teamA = null; teamB = null;
  currentSet = 1;
  completedSets = [];
  scoreA = 0; scoreB = 0;
  historyA = []; historyB = [];

  // Reset pips
  [0,1,2].forEach(i => {
    const pip = document.getElementById(`pip-${i}`);
    pip.className = 'svl-set-pip';
    pip.style.background = '';
    if (i === 0) pip.classList.add('active');
  });
  document.getElementById('set-label').textContent = 'SET 1';
  document.getElementById('set-scores-bar').innerHTML =
    '<div style="font-size:11px;color:#475569;display:flex;align-items:center;padding:0 4px">No completed sets yet</div>';
  document.getElementById('scorer-subtitle').textContent = 'Sugam Volleyball League';

  // Deselect teams
  document.querySelectorAll('.svl-team-btn').forEach(b => b.classList.remove('selected-a','selected-b'));
  document.getElementById('start-match-btn').classList.remove('ready');

  showScreen('screen-select');
}

/* ─── Set scores bar ─── */
function renderSetScoresBar() {
  const bar = document.getElementById('set-scores-bar');
  if (!completedSets.length) {
    bar.innerHTML = '<div style="font-size:11px;color:#475569;display:flex;align-items:center;padding:0 4px">No completed sets yet</div>';
    return;
  }
  bar.innerHTML = '';
  completedSets.forEach((s, i) => {
    const chip = document.createElement('div');
    const wonClass = s.winner === 'a' ? 'won-a' : s.winner === 'b' ? 'won-b' : '';
    chip.className = `svl-set-score-chip ${wonClass}`;
    chip.innerHTML = `
      <div class="svl-set-chip-label">SET ${i+1}</div>
      <div class="svl-set-chip-score">
        <span>${s.a}</span><span class="sep">–</span><span>${s.b}</span>
      </div>`;
    bar.appendChild(chip);
  });
}

/* ─── Helpers ─── */
function showScreen(id) {
  document.querySelectorAll('.svl-screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}
function openSheet(id)  { document.getElementById(id).classList.add('open'); }
function closeSheet(id) { document.getElementById(id).classList.remove('open'); }
function initials(n) { return n.split(' ').map(w => w[0]).join('').slice(0,2).toUpperCase(); }
function showToast(msg, type) {
  const t = document.getElementById('svl-toast');
  t.textContent = msg;
  t.className = 'svl-toast show' + (type ? ' '+type : '');
  clearTimeout(t._t);
  t._t = setTimeout(() => t.classList.remove('show'), 2400);
}

