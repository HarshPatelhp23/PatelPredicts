<%# app/views/svl/matches/score_match.html.erb %>
<% provide(:title, "SVL Scorer") %>

<script>
  const SVL_TEAMS = <%= raw @teams.map { |t|
    slug = t.name.to_s.downcase.gsub(/\s+/, '_')
    image_url = %w[png jpg jpeg webp svg].lazy.map { |ext|
      path = Rails.root.join("app", "assets", "images", "v_#{slug}.#{ext}")
      File.exist?(path) ? asset_path("v_#{slug}.#{ext}") : nil
    }.find(&:itself)
    { id: t.id, name: t.name, image: image_url }
  }.to_json %>;
  const SVL_SEASON   = <%= raw({ id: @season&.id, name: @season&.name }.to_json) %>;
  const SVL_SAVE_URL = "<%= svl_save_match_path %>";
  const SVL_CSRF     = "<%= form_authenticity_token %>";
</script>

<style>
/* ─── SVL Scorer — scoped styles ─── */
.svl-scorer-wrap {
  min-height: 100dvh;
  background: #0a0f1a;
  font-family: 'Nunito', sans-serif;
  color: #f1f5f9;
  display: flex;
  flex-direction: column;
  max-width: 480px;
  margin: 0 auto;
  position: relative;
  overflow: hidden;
}

/* ── TOP BAR ── */
.svl-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px 10px;
  background: rgba(10,15,26,0.95);
  border-bottom: 1px solid rgba(255,255,255,0.07);
  position: sticky; top: 0; z-index: 50;
  backdrop-filter: blur(12px);
  flex-shrink: 0;
}
.svl-topbar-back {
  width: 36px; height: 36px; border-radius: 50%;
  background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1);
  display: flex; align-items: center; justify-content: center;
  color: #94a3b8; cursor: pointer; text-decoration: none;
  transition: background .15s;
}
.svl-topbar-back:hover { background: rgba(255,255,255,0.1); }
.svl-topbar-title { font-family: 'Rajdhani', sans-serif; font-size: 18px; font-weight: 700; color: #f59e0b; letter-spacing: .5px; }
.svl-topbar-sub { font-size: 9px; color: #64748b; letter-spacing: 1.5px; text-transform: uppercase; text-align: center; margin-top: 1px; }
.svl-topbar-right { width: 36px; }

/* ── SCREENS ── */
.svl-screen { display: none; flex: 1; flex-direction: column; }
.svl-screen.active { display: flex; }

/* ════════════════════════
   SCREEN 1 — TEAM SELECT
════════════════════════ */
.svl-select-body {
  flex: 1; padding: 24px 16px;
  display: flex; flex-direction: column; gap: 20px;
}
.svl-select-label {
  font-size: 11px; font-weight: 700; color: #64748b;
  letter-spacing: 1.5px; text-transform: uppercase;
  margin-bottom: 8px;
}
.svl-team-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
}
.svl-team-btn {
  display: flex; flex-direction: column; align-items: center;
  justify-content: center; gap: 8px;
  padding: 18px 12px;
  background: rgba(255,255,255,0.04);
  border: 2px solid rgba(255,255,255,0.08);
  border-radius: 16px; cursor: pointer;
  transition: all .18s; color: #f1f5f9;
  font-family: 'Rajdhani', sans-serif;
  font-size: 15px; font-weight: 600; letter-spacing: .3px;
  text-align: center; min-height: 80px;
  position: relative;
}
.svl-team-btn:active { transform: scale(.97); }
.svl-team-btn.selected-a {
  background: rgba(16,185,129,0.12);
  border-color: #10b981;
  color: #34d399;
}
.svl-team-btn.selected-b {
  background: rgba(245,158,11,0.12);
  border-color: #f59e0b;
  color: #fbbf24;
}
.svl-team-av {
  width: 40px; height: 40px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: 'Rajdhani', sans-serif; font-size: 14px; font-weight: 700;
  background: rgba(255,255,255,0.08); color: #94a3b8;
}
.svl-team-av-img {
  background: rgba(255,255,255,0.06) !important;
  border-radius: 10px !important;
  overflow: hidden;
  padding: 0;
}

.svl-team-btn-name {
  font-size: 12px; font-weight: 600;
  color: inherit; text-align: center;
  line-height: 1.3; letter-spacing: .2px;
  max-width: 100%; word-break: break-word;
}
.svl-team-btn.selected-a .svl-team-av { background: rgba(16,185,129,0.2); color: #34d399; }
.svl-team-btn.selected-b .svl-team-av { background: rgba(245,158,11,0.2); color: #fbbf24; }
.svl-team-check {
  position: absolute; top: 8px; right: 8px;
  width: 18px; height: 18px; border-radius: 50%;
  background: #10b981; color: #fff;
  display: none; align-items: center; justify-content: center;
  font-size: 10px; font-weight: 700;
}
.svl-team-btn.selected-a .svl-team-check,
.svl-team-btn.selected-b .svl-team-check { display: flex; }
.svl-team-btn.selected-b .svl-team-check { background: #f59e0b; }

.svl-role-badge {
  font-size: 9px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
  padding: 2px 8px; border-radius: 20px; margin-bottom: 4px;
}
.badge-a { background: rgba(16,185,129,0.15); color: #34d399; }
.badge-b { background: rgba(245,158,11,0.15); color: #fbbf24; }

.svl-divider-vs {
  text-align: center;
  font-family: 'Rajdhani', sans-serif; font-size: 22px; font-weight: 700;
  color: #475569;
  display: flex; align-items: center; gap: 10px;
}
.svl-divider-vs::before, .svl-divider-vs::after {
  content: ''; flex: 1; height: 1px; background: rgba(255,255,255,0.07);
}
/* ── Match type selector ── */
.svl-match-type-wrap {
  display: flex; flex-direction: column; gap: 8px;
}
.svl-match-type-label {
  font-size: 11px; font-weight: 700; color: #64748b;
  letter-spacing: 1.5px; text-transform: uppercase;
}
.svl-match-type-grid {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px;
}
.svl-type-btn {
  display: flex; flex-direction: column; align-items: center; gap: 4px;
  padding: 12px 8px;
  background: rgba(255,255,255,0.04);
  border: 2px solid rgba(255,255,255,0.08);
  border-radius: 12px; cursor: pointer;
  transition: all .18s; text-align: center;
}
.svl-type-btn:active { transform: scale(.97); }
.svl-type-btn.active {
  background: rgba(245,158,11,0.12);
  border-color: #f59e0b;
}
.svl-type-icon { font-size: 20px; line-height: 1; }
.svl-type-name {
  font-family: 'Rajdhani', sans-serif; font-size: 13px; font-weight: 700;
  color: #94a3b8; letter-spacing: .3px;
}
.svl-type-btn.active .svl-type-name { color: #fbbf24; }
.svl-type-sub { font-size: 9px; color: #475569; letter-spacing: .5px; }
.svl-type-btn.active .svl-type-sub { color: rgba(245,158,11,0.6); }

/* Knockout badge on scorer screen */
.svl-knockout-badge {
  display: none; align-items: center; gap: 6px;
  padding: 6px 14px;
  background: linear-gradient(135deg, rgba(239,68,68,0.12), rgba(185,28,28,0.08));
  border-bottom: 1px solid rgba(239,68,68,0.2);
  font-family: 'Rajdhani', sans-serif; font-size: 11px; font-weight: 700;
  color: #f87171; letter-spacing: 1.5px; text-transform: uppercase;
  flex-shrink: 0;
}
.svl-knockout-badge.show { display: flex; }
.svl-knockout-dot {
  width: 6px; height: 6px; border-radius: 50%; background: #f87171;
  animation: setpulse 1s infinite;
}
.svl-start-btn {
  width: 100%; padding: 16px;
  background: linear-gradient(135deg, #10b981, #059669);
  color: #fff; font-family: 'Rajdhani', sans-serif;
  font-size: 17px; font-weight: 700; letter-spacing: .5px;
  border: none; border-radius: 14px; cursor: pointer;
  transition: all .15s; margin-top: auto;
  box-shadow: 0 4px 20px rgba(16,185,129,0.3);
  opacity: .4; pointer-events: none;
}
.svl-start-btn.ready { opacity: 1; pointer-events: all; }
.svl-start-btn.ready:active { transform: scale(.98); }

/* ════════════════════════
   SCREEN 2 — LIVE SCORER
════════════════════════ */
.svl-scorer-body { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

/* Set progress bar */
.svl-set-bar {
  display: flex; align-items: center; justify-content: center; gap: 6px;
  padding: 10px 16px;
  background: rgba(0,0,0,0.4);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  flex-shrink: 0;
}
.svl-set-pip {
  height: 4px; border-radius: 2px;
  flex: 1; max-width: 60px;
  background: rgba(255,255,255,0.1);
  transition: background .3s;
  position: relative; overflow: hidden;
}
.svl-set-pip.done-a { background: #10b981; }
.svl-set-pip.done-b { background: #f59e0b; }
.svl-set-pip.active {
  background: rgba(255,255,255,0.15);
  animation: setpulse 1.2s ease-in-out infinite;
}
@keyframes setpulse { 0%,100%{opacity:1} 50%{opacity:.5} }
.svl-set-label {
  font-family: 'Rajdhani', sans-serif; font-size: 12px; font-weight: 700;
  color: #64748b; letter-spacing: 1.5px; text-transform: uppercase;
  min-width: 50px; text-align: center;
}

/* Score display */
.svl-score-display {
  display: flex; align-items: stretch;
  flex: 1; position: relative;
  min-height: 0;
}
.svl-score-half {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  gap: 8px; padding: 20px 12px;
  position: relative; cursor: pointer;
  user-select: none; -webkit-user-select: none;
  transition: background .12s;
  -webkit-tap-highlight-color: transparent;
}
.svl-score-half:active { background: rgba(255,255,255,0.03); }

.svl-score-half.team-a { border-right: 1px solid rgba(255,255,255,0.06); }

.svl-team-name-score {
  font-family: 'Rajdhani', sans-serif;
  font-size: 13px; font-weight: 700;
  letter-spacing: 1px; text-transform: uppercase;
  opacity: .6;
}
.team-a .svl-team-name-score { color: #34d399; }
.team-b .svl-team-name-score { color: #fbbf24; }

.svl-big-score {
  font-family: 'Rajdhani', sans-serif;
  font-size: 96px; font-weight: 700;
  line-height: 1; color: #fff;
  transition: transform .1s ease, color .15s;
  will-change: transform;
}
.team-a .svl-big-score { color: #34d399; }
.team-b .svl-big-score { color: #fbbf24; }

.svl-big-score.bump {
  animation: scoreBump .18s cubic-bezier(0.34,1.56,0.64,1);
}
@keyframes scoreBump {
  0%  { transform: scale(1); }
  50% { transform: scale(1.18); }
  100%{ transform: scale(1); }
}

.svl-tap-hint {
  font-size: 10px; color: #475569; letter-spacing: 1px;
  text-transform: uppercase; margin-top: 4px;
}

/* Undo row */
.svl-undo-row {
  display: flex; gap: 10px; padding: 10px 16px;
  border-top: 1px solid rgba(255,255,255,0.06);
  background: rgba(0,0,0,0.3);
  flex-shrink: 0;
}
.svl-undo-btn {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px;
  padding: 10px 12px;
  background: rgba(239,68,68,0.08); border: 1px solid rgba(239,68,68,0.2);
  border-radius: 10px; cursor: pointer; color: #f87171;
  font-family: 'Rajdhani', sans-serif; font-size: 13px; font-weight: 700;
  letter-spacing: .5px; transition: all .15s;
}
.svl-undo-btn:active { background: rgba(239,68,68,0.15); transform: scale(.98); }
.svl-undo-btn:disabled { opacity: .3; pointer-events: none; }

/* Live set scoreboard */
.svl-set-scores {
  display: flex; gap: 6px; padding: 10px 16px;
  background: rgba(0,0,0,0.25);
  border-top: 1px solid rgba(255,255,255,0.05);
  overflow-x: auto; scrollbar-width: none;
  flex-shrink: 0;
}
.svl-set-scores::-webkit-scrollbar { display: none; }
.svl-set-score-chip {
  display: flex; flex-direction: column; align-items: center;
  background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08);
  border-radius: 10px; padding: 8px 14px; flex-shrink: 0; min-width: 64px;
}
.svl-set-score-chip.won-a { border-color: rgba(16,185,129,0.4); background: rgba(16,185,129,0.07); }
.svl-set-score-chip.won-b { border-color: rgba(245,158,11,0.4); background: rgba(245,158,11,0.07); }
.svl-set-chip-label { font-size: 9px; color: #64748b; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 4px; }
.svl-set-chip-score { font-family: 'Rajdhani', sans-serif; font-size: 18px; font-weight: 700; color: #f1f5f9; }
.svl-set-chip-score span:first-child { color: #34d399; }
.svl-set-chip-score .sep { color: #475569; margin: 0 2px; font-size: 14px; }
.svl-set-chip-score span:last-child { color: #fbbf24; }

/* Action buttons */
.svl-actions {
  display: flex; gap: 10px; padding: 12px 16px;
  padding-bottom: calc(12px + env(safe-area-inset-bottom, 0px));
  background: rgba(10,15,26,0.9); border-top: 1px solid rgba(255,255,255,0.07);
  flex-shrink: 0;
}
.svl-end-set-btn {
  flex: 1; padding: 14px;
  background: rgba(59,130,246,0.12); border: 1px solid rgba(59,130,246,0.3);
  color: #60a5fa; font-family: 'Rajdhani', sans-serif;
  font-size: 15px; font-weight: 700; letter-spacing: .5px;
  border-radius: 12px; cursor: pointer; transition: all .15s;
}
.svl-end-set-btn:active { background: rgba(59,130,246,0.2); transform: scale(.98); }
.svl-end-match-btn {
  flex: 1; padding: 14px;
  background: linear-gradient(135deg, rgba(239,68,68,0.15), rgba(185,28,28,0.1));
  border: 1px solid rgba(239,68,68,0.3);
  color: #f87171; font-family: 'Rajdhani', sans-serif;
  font-size: 15px; font-weight: 700; letter-spacing: .5px;
  border-radius: 12px; cursor: pointer; transition: all .15s;
}
.svl-end-match-btn:active { background: rgba(239,68,68,0.25); transform: scale(.98); }

/* ════════════════════════
   SCREEN 3 — MATCH RESULT
════════════════════════ */
.svl-result-body {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; padding: 24px 20px;
  overflow-y: auto; gap: 20px;
}
.svl-result-trophy {
  font-size: 64px; line-height: 1;
  animation: trophySpin .6s cubic-bezier(0.34,1.56,0.64,1);
}
@keyframes trophySpin {
  0% { transform: scale(0) rotate(-20deg); opacity: 0; }
  100% { transform: scale(1) rotate(0); opacity: 1; }
}
.svl-result-winner {
  font-family: 'Rajdhani', sans-serif;
  font-size: 28px; font-weight: 700; color: #f59e0b;
  text-align: center; letter-spacing: .5px;
}
.svl-result-sub { font-size: 13px; color: #64748b; text-align: center; }

.svl-result-card {
  width: 100%;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 16px; overflow: hidden;
}
.svl-result-card-hdr {
  padding: 12px 16px;
  background: rgba(0,0,0,0.3);
  font-size: 10px; font-weight: 700; color: #64748b;
  letter-spacing: 1.5px; text-transform: uppercase;
}
.svl-result-set-row {
  display: flex; align-items: center;
  padding: 12px 16px; border-top: 1px solid rgba(255,255,255,0.05);
}
.svl-result-set-num {
  font-family: 'Rajdhani', sans-serif; font-size: 12px; font-weight: 700;
  color: #64748b; letter-spacing: 1px; width: 40px; text-transform: uppercase;
}
.svl-result-set-score {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 8px;
}
.svl-rss-a { font-family: 'Rajdhani', sans-serif; font-size: 22px; font-weight: 700; color: #34d399; }
.svl-rss-b { font-family: 'Rajdhani', sans-serif; font-size: 22px; font-weight: 700; color: #fbbf24; }
.svl-rss-sep { font-family: 'Rajdhani', sans-serif; font-size: 16px; color: #475569; }
.svl-result-set-winner { font-size: 10px; color: #64748b; width: 60px; text-align: right; }

.svl-result-totals {
  width: 100%; display: flex; gap: 10px;
}
.svl-result-total-card {
  flex: 1; background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 14px; padding: 16px; text-align: center;
}
.svl-result-total-card.winner {
  background: rgba(245,158,11,0.08);
  border-color: rgba(245,158,11,0.3);
}
.svl-rtc-name {
  font-family: 'Rajdhani', sans-serif; font-size: 13px; font-weight: 700;
  letter-spacing: .5px; color: #94a3b8; margin-bottom: 8px;
  text-transform: uppercase;
}
.svl-result-total-card.winner .svl-rtc-name { color: #fbbf24; }
.svl-rtc-pts { font-family: 'Rajdhani', sans-serif; font-size: 32px; font-weight: 700; color: #f1f5f9; }
.svl-rtc-lbl { font-size: 10px; color: #64748b; letter-spacing: 1px; text-transform: uppercase; margin-top: 2px; }
.svl-rtc-sets { font-size: 12px; color: #64748b; margin-top: 6px; }

.svl-save-btn {
  width: 100%; padding: 16px;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: #0f172a; font-family: 'Rajdhani', sans-serif;
  font-size: 17px; font-weight: 700; letter-spacing: .5px;
  border: none; border-radius: 14px; cursor: pointer;
  transition: all .15s; box-shadow: 0 4px 20px rgba(245,158,11,0.3);
}
.svl-save-btn:active { transform: scale(.98); }
.svl-save-btn:disabled { opacity: .5; pointer-events: none; }

.svl-discard-btn {
  width: 100%; padding: 14px;
  background: transparent; border: 1px solid rgba(255,255,255,0.1);
  color: #64748b; font-size: 14px; border-radius: 12px;
  cursor: pointer; transition: all .15s;
}
.svl-discard-btn:hover { border-color: rgba(255,255,255,0.2); color: #94a3b8; }

/* ── Overlay / sheet ── */
.svl-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,0.7);
  z-index: 200; display: flex; align-items: flex-end;
  justify-content: center;
  opacity: 0; pointer-events: none; transition: opacity .2s;
  backdrop-filter: blur(4px);
}
.svl-overlay.open { opacity: 1; pointer-events: all; }
.svl-sheet {
  width: 100%; max-width: 480px;
  background: #131e2e; border-radius: 24px 24px 0 0;
  border-top: 1px solid rgba(255,255,255,0.1);
  padding: 20px 20px 36px;
  transform: translateY(100%); transition: transform .28s cubic-bezier(0.4,0,0.2,1);
}
.svl-overlay.open .svl-sheet { transform: translateY(0); }
.svl-sheet-handle { width: 36px; height: 4px; background: rgba(255,255,255,0.15); border-radius: 2px; margin: 0 auto 16px; }
.svl-sheet-title { font-family: 'Rajdhani', sans-serif; font-size: 18px; font-weight: 700; color: #f1f5f9; margin-bottom: 6px; }
.svl-sheet-sub { font-size: 13px; color: #64748b; margin-bottom: 20px; }
.svl-sheet-btns { display: flex; flex-direction: column; gap: 8px; }
.svl-sheet-confirm {
  width: 100%; padding: 14px;
  background: linear-gradient(135deg, #ef4444, #b91c1c);
  color: #fff; font-family: 'Rajdhani', sans-serif;
  font-size: 15px; font-weight: 700;
  border: none; border-radius: 12px; cursor: pointer; transition: all .15s;
}
.svl-sheet-confirm.blue {
  background: linear-gradient(135deg, #3b82f6, #1d4ed8);
}
.svl-sheet-confirm:active { transform: scale(.98); }
.svl-sheet-cancel {
  width: 100%; padding: 13px;
  background: transparent; border: 1px solid rgba(255,255,255,0.1);
  color: #64748b; font-size: 14px; border-radius: 12px; cursor: pointer; transition: all .15s;
}
.svl-sheet-cancel:hover { color: #94a3b8; border-color: rgba(255,255,255,0.2); }

/* Floating score ripple */
.svl-score-ripple {
  position: absolute; border-radius: 50%;
  pointer-events: none; z-index: 5;
  animation: ripple .5s ease-out forwards;
}
@keyframes ripple {
  from { transform: scale(0); opacity: .4; }
  to   { transform: scale(3); opacity: 0; }
}

/* Floating +1 animation */
.svl-plus-float {
  position: absolute; pointer-events: none; z-index: 10;
  font-family: 'Rajdhani', sans-serif; font-size: 28px; font-weight: 700;
  animation: floatUp .7s ease-out forwards;
}
@keyframes floatUp {
  0%   { transform: translateY(0) scale(.8); opacity: 1; }
  100% { transform: translateY(-60px) scale(1.1); opacity: 0; }
}

/* Toast */
.svl-toast {
  position: fixed; bottom: 90px; left: 50%;
  transform: translateX(-50%) translateY(20px);
  background: rgba(15,23,42,0.95); border: 1px solid #10b981;
  color: #34d399; font-family: 'Rajdhani', sans-serif;
  font-size: 14px; font-weight: 600;
  padding: 10px 20px; border-radius: 24px; z-index: 999;
  white-space: nowrap; transition: all .25s ease;
  opacity: 0; pointer-events: none;
}
.svl-toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }
.svl-toast.err { border-color: #ef4444; color: #f87171; }
</style>

