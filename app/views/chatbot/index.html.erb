  }

  /* Tablet Responsiveness */
  @media (max-width: 768px) {
    .chatbot-container {
      margin-left: 0;
    }

    .dashboard-header {
      padding: 1.75rem 1rem 1.25rem;
    }

    .bot-avatar-large {
      width: 65px;
