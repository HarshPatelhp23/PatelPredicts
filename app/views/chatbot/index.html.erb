</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const startChatBtn = document.getElementById('startChatBtn');
  const chatInterface = document.getElementById('chatInterface');
  const messageInput = document.getElementById('messageInput');
  const sendButton = document.getElementById('sendButton');
  const chatMessages = document.getElementById('chatMessages');
  const typingIndicator = document.getElementById('typingIndicator');
  const quickButtons = document.querySelectorAll('.quick-btn');
  const backButton = document.getElementById('backToHome');
  let isTyping = false;

  // Show chat interface
  startChatBtn.addEventListener('click', function() {
    chatInterface.style.display = 'flex';
    document.body.classList.add('chat-open');
    setTimeout(() => {
      messageInput.focus();
      scrollToBottom();
    }, 300);
  });

  // Back button
  if (backButton) {
    backButton.addEventListener('click', function() {
      chatInterface.style.display = 'none';
      document.body.classList.remove('chat-open');
      window.scrollTo(0, 0);
    });
  }

  // Send message function
  async function sendMessage(message) {
    if (!message.trim()) return;

    addMessage(message, 'user');
    messageInput.value = '';
    showTypingIndicator();
    setInputState(false);

    try {
      await delay(300);
      
      const response = await fetch('/chatbot/chat', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({ message: message })
      });
      
      const data = await response.json();
      hideTypingIndicator();
      await delay(500);
      
      if (data.success) {
        if (data.formatted_message) {
          addFormattedMessage(data.formatted_message, 'bot');
        } else if (data.message) {
          // Check if message contains HTML tags
          if (data.message.includes('<') && data.message.includes('>')) {
            addFormattedMessage(data.message, 'bot');
          } else {
            addMessage(data.message, 'bot');
          }
        }
      } else {
        addErrorMessage(data.message || 'Sorry, I encountered an error.');
      }
    } catch (error) {
      hideTypingIndicator();
      await delay(500);
      addErrorMessage('Sorry, I\'m having trouble connecting. Please check your internet connection and try again.');
      console.error('Error:', error);
    } finally {
      setInputState(true);
      messageInput.focus();
    }
  }

  function addMessage(message, sender) {
    const messageDiv = document.createElement('div');
    messageDiv.className = `message ${sender}-message`;
    
    const avatarContent = sender === 'bot' 
      ? '<span class="pp-logo-small">PP</span>' 
      : '<i class="fas fa-user"></i>';
    const formattedMessage = formatMessage(message);
    
    messageDiv.innerHTML = `
      <div class="message-avatar">
        ${avatarContent}
      </div>
      <div class="message-content">
        <div class="message-bubble">
          ${formattedMessage}
        </div>
      </div>
    `;
    
    chatMessages.appendChild(messageDiv);
    scrollToBottom();
  }

  function addFormattedMessage(formattedHtml, sender) {
    const messageDiv = document.createElement('div');
    messageDiv.className = `message ${sender}-message`;
    
    const avatarContent = sender === 'bot' 
      ? '<span class="pp-logo-small">PP</span>' 
      : '<i class="fas fa-user"></i>';
        
    // Unescape HTML entities if they're escaped
    let cleanedHtml = formattedHtml.trim();
    
    // Check if HTML is escaped (contains &lt; or &gt;)
    if (cleanedHtml.includes('&lt;') || cleanedHtml.includes('&gt;')) {
      const tempDiv = document.createElement('div');
      tempDiv.innerHTML = cleanedHtml;
      cleanedHtml = tempDiv.textContent || tempDiv.innerText || '';
    }
    
    // Remove outer wrapper div if it exists
    if (cleanedHtml.startsWith("<div class='chat-message'>")) {
      cleanedHtml = cleanedHtml.replace(/^<div class='chat-message'>/, '').replace(/<\/div>$/, '');
    }
    
    // Convert markdown headings to HTML
    cleanedHtml = cleanedHtml.replace(/###\s*(.+?)(<br>|$)/g, '<h3 class="chat-heading">$1</h3>');
    
    // Convert horizontal rules
    cleanedHtml = cleanedHtml.replace(/---<br>/g, '<hr>');
    
    // Clean up extra <br> tags that come before and after HTML elements
    cleanedHtml = cleanedHtml
      .replace(/<br><br><br>/g, '<br><br>')
      .replace(/<br><ul/g, '<ul')
      .replace(/<\/ul><br><br>/g, '</ul><br>')
      .replace(/<\/ul><br>/g, '</ul>')
      .replace(/<br><li>/g, '<li>')
      .replace(/<\/li><br>/g, '</li>')
      .replace(/<h3/g, '<br><h3')
      .replace(/<br><br><h3/g, '<br><h3')
      .trim();
    
    messageDiv.innerHTML = `
      <div class="message-avatar">
        ${avatarContent}
      </div>
      <div class="message-content">
        <div class="message-bubble formatted-content">
          ${cleanedHtml}
        </div>
      </div>
    `;
    
    chatMessages.appendChild(messageDiv);
    scrollToBottom();
  }

  function addErrorMessage(message) {
    const messageDiv = document.createElement('div');
    messageDiv.className = 'message bot-message';
    
    messageDiv.innerHTML = `
      <div class="message-avatar">
        <span class="pp-logo-small">PP</span>
      </div>
      <div class="message-content">
        <div class="message-bubble" style="background: linear-gradient(135deg, #ff6b6b, #ee5a52) !important; color: white !important;">
          <i class="fas fa-exclamation-circle" style="margin-right: 8px;"></i>
          ${escapeHtml(message)}
        </div>
      </div>
    `;
    
    chatMessages.appendChild(messageDiv);
    scrollToBottom();
  }

  function formatMessage(message) {
    return escapeHtml(message)
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(?!\*)(.*?)\*/g, '<em>$1</em>')
      .replace(/\n/g, '<br>');
  }

  function showTypingIndicator() {
    if (isTyping) return;
    isTyping = true;
    typingIndicator.style.display = 'block';
    scrollToBottom();
  }

  function hideTypingIndicator() {
    isTyping = false;
    typingIndicator.style.display = 'none';
  }

  function setInputState(enabled) {
    messageInput.disabled = !enabled;
    sendButton.disabled = !enabled;
    
    if (enabled) {
      sendButton.innerHTML = '<i class="fas fa-paper-plane"></i>';
      sendButton.style.opacity = '1';
    } else {
      sendButton.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
      sendButton.style.opacity = '0.7';
    }
  }

  function scrollToBottom() {
    setTimeout(() => {
      chatMessages.scrollTop = chatMessages.scrollHeight;
    }, 100);
  }

  function delay(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  // Event listeners
  if (sendButton) {
    sendButton.addEventListener('click', () => {
      const message = messageInput.value.trim();
      if (message) {
        sendMessage(message);
      }
    });
  }

  if (messageInput) {
    messageInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        const message = messageInput.value.trim();
        if (message) {
          sendMessage(message);
        }
      }
    });
    
    messageInput.addEventListener('input', () => {
      sendButton.disabled = messageInput.value.trim() === '';
    });
  }

  quickButtons.forEach(button => {
    button.addEventListener('click', () => {
      const message = button.getAttribute('data-message');
      if (message) {
        sendMessage(message);
      }
    });
  });

  // Prevent zoom on iOS
  if (/iPad|iPhone|iPod/.test(navigator.userAgent)) {
    document.addEventListener('gesturestart', function(e) {
      e.preventDefault();
    });
  }

  setInputState(true);
});
</script>
