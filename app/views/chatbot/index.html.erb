  }

  /* Extra Small Mobile (< 375px) */
  @media (max-width: 374px) {
    .bot-title {
      font-size: 1.15rem;
    }

    .stat-value {
      font-size: 1.7rem;
    }

    .team-name {
      font-size: 1.25rem;
    }

    .features-title {
