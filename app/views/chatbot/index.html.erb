    }

    .bot-description {
      font-size: 0.9rem;
    }

    .user-greeting {
      font-size: 0.85rem;
      padding: 0.55rem 1rem;
    }
    
    .stats-grid {
      grid-template-columns: 1fr;
    }
    
    .stat-card {
      padding: 1.15rem;
    }

    .stat-value {
      font-size: 2rem;
    }

    .team-name {
      font-size: 1.5rem;
    }
    
    .features-grid {
      grid-template-columns: 1fr;
    }

    .feature-card {
      padding: 1.35rem 1.15rem;
    }
    
    .start-chat-btn {
      padding: 1.15rem 2.25rem;
      font-size: 1.05rem;
    }
    
    .message-content {
      max-width: 85%;
    }
  }

  /* Mobile Optimization */
  @media (max-width: 480px) {
    .dashboard-header {
      padding: 1.5rem 0.85rem 1rem;
