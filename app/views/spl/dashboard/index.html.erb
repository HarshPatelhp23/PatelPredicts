<!-- ══════════════════════════════════
     JAVASCRIPT
══════════════════════════════════ -->
<script>
/* ─── Time greeting helper ─── */
/* (handled server-side via helper) */

/* ─── Page navigation ─── */
function openPage(name) {
  document.querySelectorAll('.app-page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-' + name).classList.add('active');
 
  /* Mobile bottom nav */
  document.querySelectorAll('.bn-item').forEach(b => b.classList.remove('active'));
  const navMap = { home: 'bn-home', leaderboard: 'bn-lb' };
  if (navMap[name]) document.getElementById(navMap[name])?.classList.add('active');
 
  /* Desktop sidebar nav */
  document.querySelectorAll('.sidebar-nav-item').forEach(i => {
    if (!i.classList.contains('team-item')) i.classList.remove('active');
  });
  const sideMap = { home: 'snav-home', leaderboard: 'snav-lb' };
  if (sideMap[name]) document.getElementById(sideMap[name])?.classList.add('active');
 
  if (name === 'leaderboard') renderLeaderboard();
  closeSplMenu();
  document.querySelector('.page-container').scrollTo(0, 0);
}

/* ── Keep desktop player count label in sync ── */
const _origSubmitTeam = submitTeam;

/* ─── More sheet ─── */
function toggleSplMenu() {
  const sheet   = document.getElementById('more-sheet');
  const overlay = document.getElementById('more-overlay');
  const isOpen  = sheet.classList.contains('open');
  sheet.classList.toggle('open', !isOpen);
  overlay.classList.toggle('open', !isOpen);
  document.getElementById('bn-spl').classList.toggle('active', !isOpen);
}
function closeSplMenu() {
  document.getElementById('more-sheet').classList.remove('open');
  document.getElementById('more-overlay').classList.remove('open');
  document.getElementById('bn-spl').classList.remove('active');
}

/* ─── Team Modal ─── */
function openTeamModal() {
  closeSplMenu();
  document.getElementById('team-modal').classList.add('open');
  document.body.style.overflow = 'hidden';
  renderPips(); renderBench(); renderCategories();
}
function closeModal(id) {
  document.getElementById(id).classList.remove('open');
  if (!document.querySelector('.spl-modal-overlay.open')) document.body.style.overflow = '';
}
function handleOverlayClick(e, id) { if (e.target.id === id) closeModal(id); }

/* ─── Toast ─── */
function splToast(msg, type) {
  const t = document.getElementById('spl-toast');
  t.textContent = msg;
  t.className = 'spl-toast show' + (type ? ' ' + type : '');
  clearTimeout(t._t);
  t._t = setTimeout(() => t.classList.remove('show'), 2400);
}

/* ─── Player data ─── */
const CAT_STYLES = {
  legend:        { iconBg:'rgba(240,192,64,0.2)',   iconColor:'#f0c040', avBg:'rgba(240,192,64,0.18)',  avColor:'#f0c040', border:'rgba(240,192,64,0.5)'  },
  power_batter:  { iconBg:'rgba(29,158,117,0.2)',   iconColor:'#5DCAA5', avBg:'rgba(29,158,117,0.15)', avColor:'#5DCAA5', border:'rgba(29,158,117,0.4)'  },
  strike_bowler: { iconBg:'rgba(232,64,64,0.15)',   iconColor:'#f08080', avBg:'rgba(232,64,64,0.12)',  avColor:'#f08080', border:'rgba(232,64,64,0.35)'  },
  all_rounder:   { iconBg:'rgba(55,138,221,0.2)',   iconColor:'#85B7EB', avBg:'rgba(55,138,221,0.12)', avColor:'#85B7EB', border:'rgba(55,138,221,0.4)'  },
  rising_star:   { iconBg:'rgba(255,255,255,0.08)', iconColor:'rgba(255,255,255,0.5)', avBg:'rgba(255,255,255,0.07)', avColor:'rgba(255,255,255,0.6)', border:'rgba(255,255,255,0.2)' }
};
const AV_COLORS = ['#7F77DD','#1D9E75','#D85A30','#EF9F27','#378ADD','#639922','#D4537E','#888780'];

const ALL_PLAYERS = {}, PLAYER_CATEGORY = {};
Object.entries(SPL_PLAYERS_BY_CAT).forEach(([cat, players]) => {
  players.forEach(p => { ALL_PLAYERS[p.id] = p; PLAYER_CATEGORY[p.id] = cat; });
});

let selected  = new Set((SPL_EXISTING_11 || []).map(Number));
let deselected = [];
let captainId  = SPL_CAPTAIN_ID ? Number(SPL_CAPTAIN_ID) : null;
let vcId       = SPL_VC_ID      ? Number(SPL_VC_ID)      : null;
let collapsed  = {};
if (captainId && !selected.has(captainId)) captainId = null;
if (vcId      && !selected.has(vcId))      vcId      = null;

function initials(n) { return n.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase(); }

/* ─── Pips ─── */
function renderPips() {
  const bar = document.getElementById('pip-bar');
  bar.innerHTML = '';
  for (let i = 0; i < 11; i++) {
    const d = document.createElement('div');
    d.className = 'pip' + (i < selected.size ? ' filled' : '');
    bar.appendChild(d);
  }
  document.getElementById('sel-count').textContent = selected.size;
  document.getElementById('save-btn').disabled = selected.size !== 11;
}

/* ─── Bench ─── */
function renderBench() {
  const scr = document.getElementById('bench-scroll');
  if (!deselected.length) { scr.innerHTML = '<span class="bench-empty">Your bench is empty</span>'; return; }
  scr.innerHTML = '';
  deselected.forEach(p => {
    const st = CAT_STYLES[PLAYER_CATEGORY[p.id]] || CAT_STYLES.rising_star;
    const chip = document.createElement('div');
    chip.className = 'bench-chip';
    chip.onclick = () => addBack(p);
    chip.innerHTML = `<div class="bench-av" style="background:${st.avBg};color:${st.avColor}">${initials(p.name)}</div><span class="bench-chip-name">${p.name.split(' ')[0]}</span>`;
    scr.appendChild(chip);
  });
}

/* ─── Categories ─── */
function renderCategories() {
  const el = document.getElementById('categories');
  el.innerHTML = '';
  SPL_CATEGORY_META.forEach(catMeta => {
    const key = catMeta.key, players = SPL_PLAYERS_BY_CAT[key] || [];
    if (!players.length) return;
    const st = CAT_STYLES[key] || CAT_STYLES.rising_star;
    const selInCat = players.filter(p => selected.has(p.id)).length;
    const isOpen = !collapsed[key];
    let limitWarning = '';
    if (key === 'legend' && selInCat > 2) {
      limitWarning = `<span class="cat-warn-badge" style="background:#ef4444;color:white;">MAX 2</span>`;
    } else if (key === 'legend' && selInCat === 2) {
      limitWarning = `<span class="cat-sel-badge" style="background:#f59e0b;">MAX REACHED</span>`;
    }
    const block = document.createElement('div');
    block.className = 'cat-block';
    const hdr = document.createElement('div');
    hdr.className = 'cat-hdr';
    hdr.onclick = () => { collapsed[key] = !collapsed[key]; renderCategories(); };
    hdr.innerHTML = `
      <div class="cat-left">
        <div class="cat-ico" style="background:${st.iconBg};color:${st.iconColor}">${catMeta.icon}</div>
        <div>
          <div class="cat-ttl">${catMeta.label}</div>
          <div class="cat-stl">${catMeta.sub}</div>
          ${selInCat > 0 ? `<span class="cat-sel-badge">${selInCat} selected</span>` : ''}
          ${selInCat === 1 ? `<span class="cat-warn-badge">need 1 more</span>` : ''}
        </div>
      </div>
      <div class="cat-tog ${isOpen ? 'open' : ''}">▾</div>`;
    block.appendChild(hdr);
    if (isOpen) {
      players.forEach(p => {
        const isSel = selected.has(p.id), isFull = selected.size >= 11 && !isSel;
        const isCap = captainId === p.id, isVC = vcId === p.id;
        const card = document.createElement('div');
        card.className = 'player-card' + (isCap?' is-cap':isVC?' is-vc':isSel?' selected':'');
        card.onclick = () => togglePlayer(p);
        const badge = isCap ? `<div class="p-av-badge c">C</div>` : isVC ? `<div class="p-av-badge v">VC</div>` : '';
        const stats = [];
        if (p.runs > 0) stats.push(`Runs: ${p.runs}`);
        if (p.wickets && p.wickets !== '0') stats.push(`Wkts: ${p.wickets}`);
        if (p.fifties && p.fifties !== '0') stats.push(`50s: ${p.fifties}`);
        if (p.hundreds && p.hundreds !== '0') stats.push(`100s: ${p.hundreds}`);
        if (p.trophies > 0) stats.push(`🏆 ${p.trophies}`);
        if (p.points > 0) stats.push(`Pts: ${p.points}`);
        const capBtns = isSel ? `
          <div class="p-actions" onclick="event.stopPropagation()">
            <button class="cap-action-btn cb ${isCap?'active':''}" onclick="setCaptain(${p.id})">${isCap?'✓ C':'C'}</button>
            <button class="cap-action-btn vb ${isVC?'active':''}" onclick="setVC(${p.id})">${isVC?'✓ VC':'VC'}</button>
          </div>` : '';
        card.innerHTML = `
          <div class="p-av" style="background:${st.avBg};color:${st.avColor};border-color:${isSel?'var(--gld)':st.border}">${initials(p.name)}${badge}</div>
          <div class="p-info">
            <div class="p-name">${p.name}</div>
            <div class="p-team-name">${p.ipl_team}</div>
            <div class="p-stats">${stats.map(s=>`<span class="stat-tg">${s}</span>`).join('')}</div>
          </div>
          ${capBtns}
          <div class="sel-circle ${isSel?'on':isFull?'locked':''}">${isSel?'✓':'+'}</div>`;
        block.appendChild(card);
      });
    }
    el.appendChild(block);
  });
}

function togglePlayer(p) {
  if (selected.has(p.id)) {
    selected.delete(p.id); 
    deselected.push(p);
    if (captainId === p.id) captainId = null;
    if (vcId === p.id) vcId = null;
  } else {
    // Check legend limit before adding
    const legendKey = 'legend';
    const legendPlayers = SPL_PLAYERS_BY_CAT[legendKey] || [];
    const selectedLegends = legendPlayers.filter(player => selected.has(player.id)).length;
    
    // If trying to add a legend player and already have 2 selected
    if (PLAYER_CATEGORY[p.id] === 'legend' && selectedLegends >= 2) {
      splToast('Cannot select more than 2 Legend players', 'err');
      return;
    }
    
    if (selected.size >= 11) { 
      splToast('11 players already selected', 'err'); 
      return; 
    }
    
    selected.add(p.id);
    deselected = deselected.filter(d => d.id !== p.id);
  }
  renderPips(); 
  renderBench(); 
  renderCategories();
}

function addBack(p) {
  if (selected.size>=11) { splToast('Remove a player first','err'); return; }
  selected.add(p.id); deselected=deselected.filter(d=>d.id!==p.id);
  renderPips(); renderBench(); renderCategories();
}

function setCaptain(id) {
  if (vcId===id) { splToast('Already set as VC','err'); return; }
  captainId = (captainId===id)?null:id; renderCategories();
}

function setVC(id) {
  if (captainId===id) { splToast('Already set as Captain','err'); return; }
  vcId = (vcId===id)?null:id; renderCategories();
}

function validate() {
  const errors = [];
  if (selected.size !== 11) errors.push(`Select exactly 11 players (have ${selected.size}).`);
  if (!captainId) errors.push('Select a Captain (C) from your 11.');
  if (!vcId)      errors.push('Select a Vice-Captain (VC) from your 11.');
  if (captainId && vcId && captainId === vcId) errors.push('Captain and Vice-Captain must be different.');
  
  // Legend limit validation
  const legendError = validateLegendLimit();
  if (legendError) errors.push(legendError);
  
  SPL_CATEGORY_META.forEach(m => {
    const count = (SPL_PLAYERS_BY_CAT[m.key] || []).filter(p => selected.has(p.id)).length;
    if (count === 1) errors.push(`Need at least 2 from "${m.label}" (have 1).`);
  });
  
  if (captainId && vcId && captainId !== vcId) {
    const cc = PLAYER_CATEGORY[captainId], vcCat = PLAYER_CATEGORY[vcId];
    if (cc && vcCat && cc === vcCat) errors.push(`C & VC can't both be from "${SPL_CATEGORY_META.find(m => m.key === cc)?.label}".`);
  }
  
  return errors;
}

function openConfirmModal() {
  const errors=validate();
  const errDiv=document.getElementById('confirm-errors');
  const sub=document.getElementById('confirm-sub');
  const goBtn=document.getElementById('confirm-go-btn');
  errDiv.innerHTML='';
  if (errors.length) {
    errors.forEach(e=>{const d=document.createElement('div');d.className='confirm-err';d.textContent=e;errDiv.appendChild(d);});
    sub.textContent='Fix these issues before saving:'; goBtn.style.display='none';
  } else {
    sub.textContent=`Captain: ${ALL_PLAYERS[captainId]?.name||'—'} · VC: ${ALL_PLAYERS[vcId]?.name||'—'}`;
    goBtn.style.display='block';
  }
  document.getElementById('confirm-modal').classList.add('open');
}

function submitTeam() {
   // _origSubmitTeam.call(this);
  const errors=validate();
  if (errors.length) { splToast('Fix errors first','err'); return; }
  fetch(SPL_SAVE_URL, {
    method:'POST',
    headers:{'Content-Type':'application/json','X-CSRF-Token':SPL_CSRF},
    body:JSON.stringify({playing11:[...selected],captain_id:captainId,vc_id:vcId})
  })
  .then(r=>r.json())
  .then(data=>{
    closeModal('confirm-modal');
    if (data.success) {
      closeModal('team-modal');
      splToast('✓ Team saved!');
      document.getElementById('dash-player-count').textContent=selected.size;
    } else {
      const errDiv=document.getElementById('confirm-errors');
      errDiv.innerHTML='';
      (data.errors||[]).forEach(e=>{const d=document.createElement('div');d.className='confirm-err';d.textContent=e;errDiv.appendChild(d);});
      document.getElementById('confirm-sub').textContent='Server returned errors:';
      document.getElementById('confirm-go-btn').style.display='none';
      document.getElementById('confirm-modal').classList.add('open');
    }
  })
  .catch(()=>{closeModal('confirm-modal');splToast('Network error','err');});
}

document.addEventListener('DOMContentLoaded', function() {
  const dashCount = document.getElementById('dash-player-count');
  const desktopLabel = document.getElementById('desktop-player-count-label');
  if (dashCount && desktopLabel) {
    new MutationObserver(() => {
      desktopLabel.textContent = dashCount.textContent + '/11 players selected';
    }).observe(dashCount, { childList: true, characterData: true, subtree: true });
  }
});

/* ─── Leaderboard ─── */
function renderLeaderboard() {
  const data=SPL_LEADERBOARD;
  if (!data||!data.length) {
    document.getElementById('lb-rows').innerHTML='<p style="padding:24px;text-align:center;color:var(--text3);font-size:13px">No entries yet</p>';
    document.getElementById('lb-podium').innerHTML=''; return;
  }
  const avColors=['#FFD700','#C0C0C0','#CD7F32'];
  const order=[{i:1,sz:52,h:56},{i:0,sz:64,h:76},{i:2,sz:46,h:40}];
  const pod=document.getElementById('lb-podium');
  pod.innerHTML='';
  order.forEach(o=>{
    const u=data[o.i]; if(!u) return;
    pod.innerHTML+=`<div class="pod-item">
      <div class="pod-av" style="width:${o.sz}px;height:${o.sz}px;font-size:${Math.floor(o.sz/3.8)}px;background:${AV_COLORS[o.i]};border-color:${avColors[o.i]}">${initials(u.name)}</div>
      <div class="pod-name">${u.name.split(' ')[0]}</div>
      <div class="pod-pts">${u.points}pts</div>
      <div class="pod-block" style="width:${o.sz+14}px;height:${o.h}px;background:${avColors[o.i]}">${o.i+1}</div>
    </div>`;
  });
  const rows=document.getElementById('lb-rows');
  rows.innerHTML='';
  data.forEach((u,i)=>{
    const rc=i===0?'gold':i===1?'silver':i===2?'bronze':'';
    const row = document.createElement('div');
    row.className = 'lb-row' + (u.me ? ' me' : '');
    row.style.cursor = 'pointer';
    row.onclick = () => openViewTeamModal(u);
    row.innerHTML=`
      <div class="lb-rank ${rc}">${u.rank}</div>
      <div class="lb-av" style="background:${AV_COLORS[i%AV_COLORS.length]}">${initials(u.name)}</div>
      <div class="lb-info"><div class="lb-uname">${u.name}${u.me?'<span class="me-bdg">YOU</span>':''}</div></div>
      <div style="text-align:right;flex-shrink:0"><div class="lb-pts">${u.points}</div><div class="lb-pts-lbl">pts</div></div>`;
    rows.appendChild(row);
  });
}

document.addEventListener('keydown', e => {
  if (e.key==='Escape') {
    ['confirm-modal','team-modal'].forEach(id=>{
      if(document.getElementById(id).classList.contains('open')) closeModal(id);
    });
    closeSplMenu();
  }
});

/* ─── View Team Modal ─── */
// Cricket field positions by category
// Each entry: [leftPercent, topPercent]
// Layout: Wicket-keeper behind stumps top, batters in middle, 
//         all-rounders in ring, bowlers at boundary
const VT_POSITIONS_BY_CAT = {
  legend:        [[50,14],[30,20],[70,20],[50,30],[50,50]],
  power_batter:  [[50,14],[30,20],[70,20],[50,30],[50,50]],
  all_rounder:   [[20,42],[80,42],[15,60],[85,60],[50,65]],
  strike_bowler: [[20,75],[80,75],[50,82],[35,88],[65,88]],
  rising_star:   [[15,50],[85,50],[50,20],[35,70],[65,70]],
};

// Fallback positions for a full 11 (spread around the field)
const VT_FALLBACK_POSITIONS = [
  [50,12],[28,18],[72,18],[50,28],[22,38],[78,38],
  [50,50],[18,58],[82,58],[35,75],[65,75]
];

function initials(n) {
  return n.split(' ').map(w => w[0]).join('').slice(0, 2).toUpperCase();
}

const VT_CAT_CLASS = {
  legend: 'vt-legend', power_batter: 'vt-batter',
  strike_bowler: 'vt-bowler', all_rounder: 'vt-allr', rising_star: 'vt-rising'
};
const VT_CAT_LABEL = {
  legend: 'Legend', power_batter: 'Batter',
  strike_bowler: 'Bowler', all_rounder: 'All-rounder', rising_star: 'Rising Star'
};
function assignRows(players) {
  const ORDER   = ['legend','power_batter','all_rounder','strike_bowler','rising_star'];
  const sorted  = [...players].sort((a,b) => ORDER.indexOf(a.cat) - ORDER.indexOf(b.cat));

  // Row budgets — max players per row, top to bottom
  const ROWS    = [1, 3, 3, 2, 2]; // 11 total slots across 5 rows
  const result  = [];
  let ri = 0, count = 0;

  sorted.forEach(p => {
    while (ri < ROWS.length && count >= ROWS[ri]) { ri++; count = 0; }
    result.push({ ...p, row: ri + 1 });
    count++;
  });
  return result;
}
function openViewTeamModal(userData) {
  document.getElementById('vt-user-name').textContent = (userData.name || '').toUpperCase();
  document.getElementById('vt-user-meta').textContent = `Rank #${userData.rank} · Playing XI`;
  document.getElementById('vt-pts-badge').textContent = `${userData.points} pts`;

  const field    = document.getElementById('vt-field');
  field.querySelectorAll('.vt-row').forEach(r => r.remove());

  const playerIds = (userData.playing11 || []).map(Number);
  const capId     = Number(userData.captain_id);
  const vcId      = Number(userData.vc_id);

  const playerObjs = playerIds.map(id => ({
    id,
    cat: PLAYER_CATEGORY[id] || 'rising_star',
    cap: id === capId ? 'c' : id === vcId ? 'v' : null
  }));

  const positioned = assignRows(playerObjs);

  // Group into rows
  const byRow = {};
  positioned.forEach(p => { if (!byRow[p.row]) byRow[p.row] = []; byRow[p.row].push(p); });

  const ROW_CLASS = ['','vt-row-1','vt-row-2','vt-row-3','vt-row-4','vt-row-5','vt-row-6'];
  let delay = 0;

  Object.keys(byRow).sort((a,b) => a-b).forEach(rowNum => {
    const rowEl = document.createElement('div');
    rowEl.className = 'vt-row ' + (ROW_CLASS[rowNum] || 'vt-row-3');

    byRow[rowNum].forEach(entry => {
      const p = ALL_PLAYERS[entry.id];
      if (!p) return;
      const capRing  = entry.cap ? `<div class="vt-cap-ring ${entry.cap}"></div>` : '';
      const capBadge = entry.cap ? `<div class="vt-av-badge ${entry.cap}">${entry.cap.toUpperCase()}</div>` : '';
      const token = document.createElement('div');
      const pointsValue = p.points || 0;
      let displayPoints = pointsValue;
      let multiplierText = '';
      if (entry.cap === 'c') {
        displayPoints = pointsValue * 2;
        multiplierText = ' (C)';
      } else if (entry.cap === 'v') {
        displayPoints = pointsValue * 1.5;
        multiplierText = ' (VC)';
      }
      token.className = 'vt-token';
      token.style.animationDelay = delay + 'ms';
      token.innerHTML = `
        <div class="vt-av ${VT_CAT_CLASS[entry.cat] || 'vt-rising'}">
          ${initials(p.name)}${capRing}${capBadge}
        </div>
        <div class="vt-pname">${p.name.split(' ')[0]}</div>
        <div class="vt-pname">${displayPoints}${multiplierText}</div>
        <div class="vt-prole">${VT_CAT_LABEL[entry.cat] || ''}</div>
      `;
      rowEl.appendChild(token);
      delay += 55;
    });

    field.appendChild(rowEl);
  });

  document.getElementById('view-team-modal').classList.add('open');
  document.body.style.overflow = 'hidden';
}
function validateLegendLimit() {
  const legendKey = 'legend';
  const legendPlayers = SPL_PLAYERS_BY_CAT[legendKey] || [];
  const selectedLegends = legendPlayers.filter(p => selected.has(p.id)).length;
  
  if (selectedLegends > 2) {
    return `Cannot select more than 2 Legend players (currently ${selectedLegends} selected).`;
  }
  return null;
}


</script>
