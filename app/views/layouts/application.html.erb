<!DOCTYPE html>
<html>
  <head>
    <title>PatelPredicts</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Stylesheets -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">

    <!-- JavaScript Libraries -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.1/js/bootstrap.min.js"></script>
    
    <!-- IMPORTANT: This line MUST be uncommented and properly configured -->
    <%= javascript_importmap_tags %>
    <%= javascript_include_tag 'application', defer: true %>
    <!-- Other JavaScript includes -->
    <!-- <#%= javascript_include_tag "https://www.google.com/jsapi" %> -->
    <!-- <#%= javascript_include_tag 'https://cdn.jsdelivr.net/npm/chart.js@3', 'chartkick' %> -->

    <meta name="mobile-web-app-capable" content="yes">
    <meta name="turbo-visit-control" content="reload">
  </head>

  <body>
    <%= render 'layouts/flash_messages' %>
    <div class="container-fluid">
      <% if current_user.present? %>
        <%= render 'home/after_login_navbar' %>
        <% unless request.path.include?('/team_score/') %>
          <div class="placeholder-for-navbar"></div>
        <% end %>
      <% end %>
    </div>

    <div class="<%= current_user.present? ? 'container mt-4' : '' %>">
      <div id="notifications" class="notification-container"></div>
      <%= yield %>
    </div>
  </body>
</html>
<script>
  console.log("Importmap tags rendered");
  // Check if importmap is loaded
  if (typeof window.importShim !== 'undefined') {
    console.log("Importmap is loaded");
  } else {
    console.error("Importmap not loaded");
  }
</script>
