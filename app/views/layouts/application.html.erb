<!DOCTYPE html>
<html>
  <head>
    <title>PatelPredicts</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag 'authentication', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= stylesheet_link_tag 'custom', media: 'all', 'data-turbolinks-track': 'reload' %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.1/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.1/js/bootstrap.min.js"></script>
   <!--  <script src="https://www.gstatic.com/firebasejs/9.6.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.6.0/firebase-messaging.js"></script> -->
    <!-- <script src="https://cdn.jsdelivr.net/npm/chart.js"></script> -->
    <!-- <script type="module" src="/assets/application.js"></script> -->


    <%= javascript_importmap_tags %>
    <%= javascript_include_tag "https://www.google.com/jsapi" %>
    <%= javascript_include_tag 'https://cdn.jsdelivr.net/npm/chart.js@3', 'chartkick' %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <#%= javascript_include_tag 'compute_match_team_points', 'data-turbo-track': 'reload' %>
    <%= javascript_include_tag 'loader', 'data-turbo-track': 'reload' %>
    <!-- <#%= javascript_include_tag "auction_room_channel", type: "module" %> -->
    <!-- <#%= action_cable_meta_tag %> -->
    <!-- <#%= javascript_include_tag 'compute_match_team_points', 'data-turbo-track': 'reload' if params[:match_id] && current_page?(one_match_scorecard_path(match_id: params[:match_id])) %> -->



    <meta name="mobile-web-app-capable" content="yes">
    <meta name="turbo-visit-control" content="reload">
  </head>

  <body>
    <%= render 'layouts/flash_messages' %>
    <% unless request.path == '/' %>
      <%= render 'shared/loader' %>
    <% end %>
    <div class="container-fluid">
      <% if current_user.present? %>
        <!-- Fixed-top navbar -->
        <%= render 'home/after_login_navbar' %>
        <!-- Add a placeholder to push content below the fixed-top navbar -->
        <% unless request.path.include?('/team_score/') %>
          <div class="placeholder-for-navbar"></div>
        <% end %>
      <% end %>
    </div>

    <div class="<%= current_user.present? ? 'container mt-4' : '' %>">
      <div id="notifications" class="notification-container"></div>
      <%= yield %>
    </div>
  </body>
</html>
