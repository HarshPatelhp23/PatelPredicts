<!DOCTYPE html>
<html>
<head>
  <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
    }
    .header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 30px;
      border-radius: 10px 10px 0 0;
      text-align: center;
    }
    .header h1 {
      margin: 0;
      font-size: 24px;
    }
    .header p {
      margin: 10px 0 0 0;
      font-size: 14px;
      opacity: 0.9;
    }
    .content {
      background: #f7fafc;
      padding: 30px;
      border-radius: 0 0 10px 10px;
    }
    .greeting {
      font-size: 18px;
      color: #2d3748;
      margin-bottom: 20px;
    }
    .info-box {
      background: white;
      border-left: 4px solid #4299e1;
      padding: 15px;
      margin: 20px 0;
      border-radius: 4px;
    }
    .info-box h3 {
      margin: 0 0 10px 0;
      color: #2c5282;
      font-size: 16px;
    }
    .info-box ul {
      margin: 10px 0;
      padding-left: 20px;
    }
    .info-box li {
      margin: 5px 0;
    }
    .attachment-info {
      background: #edf2f7;
      border: 2px dashed #cbd5e0;
      padding: 15px;
      margin: 20px 0;
      border-radius: 6px;
      text-align: center;
    }
    .attachment-info strong {
      color: #2d3748;
      font-size: 15px;
    }
    .cta-button {
      display: inline-block;
      background: #48bb78;
      color: white;
      padding: 12px 30px;
      text-decoration: none;
      border-radius: 6px;
      margin: 20px 0;
      font-weight: bold;
    }
    .footer {
      text-align: center;
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid #e2e8f0;
      color: #718096;
      font-size: 12px;
    }
    .team-stats {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin: 15px 0;
    }
    .stat-item {
      background: #edf2f7;
      padding: 10px;
      border-radius: 4px;
      text-align: center;
    }
    .stat-label {
      font-size: 11px;
      color: #718096;
      text-transform: uppercase;
    }
    .stat-value {
      font-size: 18px;
      font-weight: bold;
      color: #2d3748;
      margin-top: 5px;
    }
  </style>
</head>
<body>
  <div class="header">
    <h1>🏏 Fantasy Cricket League</h1>
    <p>Weekly Report - <%= @week_start.strftime('%d %b') %> to <%= @week_end.strftime('%d %b, %Y') %></p>
  </div>

  <div class="content">
    <p class="greeting">Hi <%= @user.username %>! 👋</p>

    <p>Your weekly Fantasy Cricket report is ready! Here's what's inside:</p>

    <div class="info-box">
      <h3>📊 This Week's Report Includes:</h3>
      <ul>
        <li><strong>Team Rosters PDF:</strong> View all owners' Playing 11 and Bench players</li>
        <li><strong>Match Schedule PDF:</strong> Complete week's match schedule with your players' participation</li>
      </ul>
    </div>

    <% if @team %>
    <div class="team-stats">
      <div class="stat-item">
        <div class="stat-label">Total Points</div>
        <div class="stat-value"><%= @user.grand_total %></div>
      </div>
      <div class="stat-item">
        <div class="stat-label">Remaining Purse</div>
        <div class="stat-value">₹<%= number_to_human(@user.remaining_purse, precision: 2, format: '%n%u', units: { thousand: 'K', million: 'M', billion: 'B' }) %></div>
      </div>
    </div>
    <% end %>

    <div class="attachment-info">
      <strong>📎 2 PDF files attached to this email</strong>
      <p style="margin: 10px 0 0 0; font-size: 13px; color: #4a5568;">
        Download and review your team's performance for the week
      </p>
    </div>

    <div class="info-box" style="border-left-color: #f59e0b;">
      <h3>💡 Quick Tips:</h3>
      <ul>
        <li>Review your Playing 11 vs Bench composition</li>
        <li>Check which of your players are playing in upcoming matches</li>
        <li>Plan your team changes for maximum points</li>
        <li>Monitor your competitors' teams and strategies</li>
      </ul>
    </div>

    <p style="margin-top: 25px; color: #4a5568;">
      Good luck for the upcoming matches! May your players score big! 🎯
    </p>

    <div class="footer">
      <p>
        <strong>Fantasy Cricket League</strong><br>
        This is an automated weekly report. Check your app for real-time updates.
      </p>
      <p style="margin-top: 10px;">
        Questions? Contact your us on:- noreplyypatelpredicts@gmail.com.
      </p>
    </div>
  </div>
</body>
</html>
