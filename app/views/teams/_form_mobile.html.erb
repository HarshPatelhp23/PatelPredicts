}

.player-role-badge.batsman {
  background: rgba(139, 92, 246, 0.2);
  color: #a78bfa;
}

.player-role-badge.all_rounder {
  background: rgba(245, 158, 11, 0.2);
  color: #fbbf24;
}

.player-role-badge.bowler {
  background: rgba(16, 185, 129, 0.2);
  color: #34d399;
}

.team-name-sm {
  color: rgba(255, 255, 255, 0.6);
  font-size: 12px;
}

.overseas-badge-sm {
  flex-shrink: 0;
}

/* Modal Buttons */
.submit-btn-mobile {
  width: 100%;
  background: linear-gradient(135deg, #10b981, #059669);
  border: none;
  border-radius: 14px;
  padding: 14px 20px;
  color: white;
  font-size: 16px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  box-shadow: 0 4px 16px rgba(16, 185, 129, 0.4);
  transition: all 0.3s ease;
}

.submit-btn-mobile:active {
  transform: scale(0.98);
  background: linear-gradient(135deg, #059669, #047857);
}

.secondary-btn-mobile {
  width: 100%;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 14px;
  padding: 14px 20px;
  color: white;
  font-size: 16px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  backdrop-filter: blur(10px);
  transition: all 0.3s ease;
}

.secondary-btn-mobile:active {
  background: rgba(255, 255, 255, 0.15);
  transform: scale(0.98);
}

/* Empty State */
.empty-state {
  text-align: center;
  padding: 40px 20px;
  color: rgba(255, 255, 255, 0.5);
}

.empty-state i {
  font-size: 48px;
  margin-bottom: 16px;
  opacity: 0.3;
}

.empty-state p {
  font-size: 14px;
  margin: 0;
}

/* Responsive Adjustments */
@media (max-width: 576px) {
  .mobile-title {
    font-size: 18px;
  }
  
  .stat-value {
    font-size: 20px;
  }
  
  .role-chip {
    font-size: 12px;
    padding: 6px 12px;
  }
}

/* iOS Safe Area Support */
@supports (padding: max(0px)) {
  .mobile-header .header-top {
    padding-top: max(16px, env(safe-area-inset-top));
  }
  
  .floating-action-container {
    padding-bottom: max(12px, env(safe-area-inset-bottom));
  }
  
  .mobile-modal-footer {
    padding-bottom: max(16px, env(safe-area-inset-bottom));
  }
}

/* Smooth Scrolling */
html {
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
}

/* Prevent Pull to Refresh on Mobile */
body {
  overscroll-behavior-y: contain;
}
</style>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script>
$(document).ready(function() {
  // Tab Switching
  $('.tab-btn').on('click', function() {
    const tab = $(this).data('tab');
    
    // Update buttons
    $('.tab-btn').removeClass('active');
    $(this).addClass('active');
    
    // Update content
    $('.tab-content-mobile').removeClass('active');
    $(`.tab-content-mobile[data-content="${tab}"]`).addClass('active');
    
    // Update move button text
    updateButtonText();
    
    // Hide floating button if no checkboxes are selected
    updateButtonVisibility();
  });

  // Update button text based on active tab
  function updateButtonText() {
    const activeTab = $('.tab-btn.active').data('tab');
    const buttonText = activeTab === 'playing11' ? 'Move to Bench' : 'Move to Playing 11';
    $('#moveActionText').text(buttonText);
  }

  // Update button visibility and count
  function updateButtonVisibility() {
    const selectedCount = $('.player-checkbox:checked').length;
    $('#selectedCount').text(selectedCount);
    
    if (selectedCount > 0) {
      $('#floatingActionContainer').fadeIn(200);
    } else {
      $('#floatingActionContainer').fadeOut(200);
    }
  }

  // Helper function to show toast
  function showToast(message, type = 'success') {
    const toastEl = document.getElementById('moveSuccessToast');
    const toastMessage = document.getElementById('toastMessage');
    
    // Update message
    toastMessage.textContent = message;
    
    // Update icon based on type
    const icon = toastMessage.previousElementSibling;
    if (type === 'error') {
      icon.className = 'fas fa-exclamation-circle me-2';
      toastEl.classList.add('toast-error');
    } else {
      icon.className = 'fas fa-check-circle me-2';
      toastEl.classList.remove('toast-error');
    }
    
    // Show toast
    const toast = new bootstrap.Toast(toastEl, {
      autohide: true,
      delay: 3000
    });
    toast.show();
  }

  // Helper function to reset move button
  function resetMoveButton() {
    const activeTab = $('.tab-btn.active').data('tab');
    const buttonText = activeTab === 'playing11' ? 'Move to Bench' : 'Move to Playing 11';
    $('#moveSelectedPlayersBtn').html(`<i class="fas fa-exchange-alt"></i> <span id="moveActionText">${buttonText}</span> <span class="selected-count" id="selectedCount">${$('.player-checkbox:checked').length}</span>`);
    $('#moveSelectedPlayersBtn').prop('disabled', false);
  }

  // Check for success/error messages in sessionStorage on page load
  const successMessage = sessionStorage.getItem('moveSuccessMessage');
  const errorMessage = sessionStorage.getItem('moveErrorMessage');
  
  if (successMessage) {
    showToast(successMessage, 'success');
    sessionStorage.removeItem('moveSuccessMessage');
  }
  
  if (errorMessage) {
    showToast(errorMessage, 'error');
    sessionStorage.removeItem('moveErrorMessage');
  }

  // Checkbox change handler
  $(document).on('change', '.player-checkbox', function() {
    updateButtonVisibility();
    
    // Add haptic feedback (vibration) on mobile
    if ('vibrate' in navigator) {
      navigator.vibrate(10);
    }
  });

  // Move selected players
  $('#moveSelectedPlayersBtn').on('click', function() {
    const selectedPlayers = [];
    $('.player-checkbox:checked').each(function() {
      selectedPlayers.push($(this).val());
    });
    
    const activeTab = $('.tab-btn.active').data('tab');
    const actionName = activeTab === 'playing11' ? 'bench' : 'playing_11';
    const actionText = activeTab === 'playing11' ? 'Bench' : 'Playing 11';

    if (selectedPlayers.length > 0) {
      // Show loading state
      $(this).html('<i class="fas fa-spinner fa-spin"></i> Moving...');
      $(this).prop('disabled', true);
      
      $.ajax({
        url: '/teams/move_players',
        method: 'POST',
        headers: {
          'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')
        },
        data: { 
          move_action: actionName, 
          player_ids: selectedPlayers 
        },
        dataType: 'json',
        success: function(response) {
          if (response.success) {
            // Haptic feedback
            if ('vibrate' in navigator) {
              navigator.vibrate([50, 100, 50]);
            }
            
            // Store success message in sessionStorage
            const playerCount = selectedPlayers.length;
            const message = `${playerCount} player${playerCount > 1 ? 's' : ''} moved to ${actionText} successfully!`;
            sessionStorage.setItem('moveSuccessMessage', message);
            
            // Reload page - toast will show after reload
            location.reload();
          } else {
            showToast(response.error || 'An error occurred', 'error');
            resetMoveButton();
          }
        },
        error: function(xhr) {
          const errorMsg = xhr.responseJSON?.error || 'An error occurred while moving players';
          showToast(errorMsg, 'error');
          resetMoveButton();
        }
      });
    }
  });

  // Initialize
  updateButtonText();
  updateButtonVisibility();

  // Prevent zoom on double tap (iOS)
  let lastTouchEnd = 0;
  document.addEventListener('touchend', function(event) {
    const now = Date.now();
    if (now - lastTouchEnd <= 300) {
      event.preventDefault();
    }
    lastTouchEnd = now;
  }, false);
});
</script>
