<div class="overview-container">
  <div class="row">
    <div class="col-md-6">
      <div class="card performance-card">
        <div class="card-header">
          <h5>Performance Summary</h5>
        </div>
        <div class="card-body">
          <div class="performance-metric">
            <div class="metric-label">Consistency</div>
            <div class="progress">
              <div class="progress-bar" role="progressbar" style="width: <%= 50 %>%"></div>
            </div>
            <div class="metric-value"><%= 50 %>%</div>
          </div>
          
          <div class="performance-metric">
            <div class="metric-label">Impact</div>
            <div class="progress">
              <div class="progress-bar" role="progressbar" style="width: <%= 22 %>%"></div>
            </div>
            <div class="metric-value"><%= 22 %>%</div>
          </div>
          
          <div class="performance-metric">
            <div class="metric-label">Recent Form</div>
            <div class="recent-form">
              <% Match.last(5).each do |match| %>
                <span class="form-indicator <%= match.points %>"></span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="col-md-6">
      <div class="card highlights-card">
        <div class="card-header">
          <h5>Key Highlights</h5>
        </div>
        <div class="card-body">
          <ul class="highlights-list">
            <li>
              <i class="bi bi-trophy-fill"></i>
              <!-- <span>Top scorer in <#%= best_match[:name] %> with <#%= best_match[:points] %> points</span> -->
                <span>Top scorer in <%= 'MI vs GT' %> with <%= 56 %> points</span>
            </li>
            <li>
              <i class="bi bi-graph-up-arrow"></i>
              <!-- <span><#%= consecutive_performances %> consecutive matches with 15+ points</span> -->
              <span><%= 56 %> consecutive matches with 15+ points</span>
            </li>
            <li>
              <i class="bi bi-lightning-charge-fill"></i>
              <!-- <span>Highest impact player in <#%= highest_impact_match %></span> -->
              <span>Highest impact player in <%= 'MI vs CSK' %></span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>