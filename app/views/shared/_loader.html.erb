<div id="cricketLoader" class="loader-container" data-turbo-permanent>
  <div class="cricket-logo">
    <i class="fas fa-chart-line logo-icon"></i>
  </div>
  
  <div class="cricket-loader">
    <div class="stadium-3d">
      <div class="pitch-circle">
        <div class="pitch-lines">
          <div class="pitch-line"></div>
          <div class="pitch-line"></div>
        </div>
      </div>
      
      <div class="ball-orbit">
        <div class="cricket-ball"></div>
      </div>
      
      <div class="cricket-elements">
        <div class="flying-ball"></div>
        <div class="flying-ball"></div>
        <div class="flying-ball"></div>
      </div>
      
      <div class="wickets">
        <div class="stump"></div>
        <div class="stump"></div>
        <div class="stump"></div>
        <div class="bail"></div>
      </div>
      
      <div class="bat"></div>
    </div>
  </div>
  
  <div class="loader-content">
    <h2 class="loader-title">Powering Up PatelPredicts</h2>
    <p class="loader-subtitle">Your prediction insights are on the way...
      <span class="pulsing-dot"></span>
      <span class="pulsing-dot"></span>
      <span class="pulsing-dot"></span>
    </p>
    
    <div class="loader-stats">
      <div class="stat-item">
        <div class="stat-value" id="loadingPercent">0%</div>
        <div class="stat-label">Complete</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">IPL</div>
        <div class="stat-label">2025</div>
      </div>
      <div class="stat-item">
        <div class="stat-value" id="timeRemaining">30s</div>
        <div class="stat-label">Remaining</div>
      </div>
    </div>
    
    <div class="loader-progress">
      <div class="progress-bar"></div>
    </div>
  </div>
</div>