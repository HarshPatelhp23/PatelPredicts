<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Format tabs switching (e.g., Batting / Bowling)
    const formatTabs = document.querySelectorAll('.format-tab');
    const formatSections = document.querySelectorAll('.format-section');

    formatTabs.forEach(tab => {
      tab.addEventListener('click', function() {
        // Remove 'active' class from all tabs
        formatTabs.forEach(t => t.classList.remove('active'));
        this.classList.add('active');

        const selectedFormat = this.dataset.format; // e.g., 'batting' or 'bowling'

        // Show/hide format sections
        formatSections.forEach(section => {
          if (section.dataset.format === selectedFormat) {
            section.style.display = 'block';
          } else {
            section.style.display = 'none';
          }
        });
      });
    });

    // Chart type selector (e.g., bar, line)
    const chartTypeBtns = document.querySelectorAll('.chart-type-btn');
    const charts = document.querySelectorAll('.chart-canvas');

    chartTypeBtns.forEach(btn => {
      btn.addEventListener('click', function() {
        chartTypeBtns.forEach(b => b.classList.remove('active'));
        this.classList.add('active');

        const selectedType = this.dataset.chartType; // e.g., 'bar', 'line'

        // Show only the selected chart type
        charts.forEach(chart => {
          if (chart.dataset.chartType === selectedType) {
            chart.style.display = 'block';
          } else {
            chart.style.display = 'none';
          }
        });
      });
    });

    // Player select dropdowns
    const playerSelects = document.querySelectorAll('.player-select');
    playerSelects.forEach(select => {
      select.addEventListener('change', function() {
        // Optional: auto-submit parent form
        const form = this.closest('form');
        if (form) {
          form.submit();
        }
      });
    });
  });
  document.addEventListener('DOMContentLoaded', function () {
    const tabs = document.querySelectorAll('.format-tab');
    const contents = {
      batting: document.getElementById('batting-content'),
      bowling: document.getElementById('bowling-content')
    };

    tabs.forEach(tab => {
      tab.addEventListener('click', function () {
        tabs.forEach(t => t.classList.remove('active'));
        this.classList.add('active');

        const selected = this.dataset.tab;
        Object.keys(contents).forEach(key => {
          contents[key].classList.toggle('hidden', key !== selected);
        });
      });
    });
  });
</script>
