<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leaderboard - SPL</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
      body {
          background-color: #f4f4f4;
          font-family: Arial, sans-serif;
      }

      .leaderboard {
          background: white;
          border-radius: 10px;
          box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
          overflow: hidden;
      }

      .table {
          margin: 0;
          border-collapse: collapse;
      }

      .table th {
          background-color: #007bff;
          color: white;
          text-align: center;
      }

      .table td, .table th {
          text-align: center;
          vertical-align: middle;
      }

      .player-name {
          font-weight: bold;
      }

      .profile-pic {
          width: 50px;
          height: 50px;
          border-radius: 50%;
          border: 2px solid #ddd;
      }
  </style>
</head>
<body>
  <div class="container my-5">
    <div class="text-center mt-3">
      <%= link_to 'Back', root_path, class:'btn btn-primary back-button theme-btn-back' %>
    </div>
    <h1 class="text-center mb-4"><%= image_tag('purple_cap.jpeg', alt: 'Orange Cap', style: 'max-height: 70px;') %> Leaderboard</h1>
    <div class="leaderboard">
      <table class="table table-striped table-hover">
          <thead>
            <tr>
                <th>Rank</th>
                <th>Player</th>
                <th>Wickets</th>
                <th>E/C</th>
                <th>Overs</th>
                <th>Runs</th>
            </tr>
          </thead>
          <tbody>
            <% @records.each_with_index do |record, i| %>
            	<tr>
                <% if i == 0 %>
                	<td><span class="player-name"><%= i+1 %> <%= image_tag('purple_cap.jpeg', alt: 'Purple Cap', style: 'max-height: 20px;') %></span></td>
              	<% else %>
              		<td><span class="player-name"><%= i+1 %></span></td>
              	<% end %>
                <td>
                  <span class="player-name"><%= record[:player_name] %></span>
                </td>
                <td><%= record[:wickets] %></td>
                <td><%= record[:econ] %></td>
                <td><%= record[:overs] %></td>
                <td><%= record[:runs_given] %></td>
            	</tr>
             <% end %>
          </tbody>
      </table>
     </div>
  </div>
</body>
</html>
