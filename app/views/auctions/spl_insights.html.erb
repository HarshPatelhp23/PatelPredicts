<%# app/views/spl/insights.html.erb — Responsive desktop + mobile %>

<style>
@import url('https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #0f172a; --bg2: #1e293b; --bg3: #334155;
  --surface: #1e293b; --surface2: #243044;
  --gold: #f59e0b; --gold2: #fbbf24; --gold-dim: rgba(245,158,11,0.15);
  --green: #10b981; --green2: #34d399; --green-dim: rgba(16,185,129,0.15);
  --red: #ef4444; --red-dim: rgba(239,68,68,0.12);
  --blue: #3b82f6; --blue-dim: rgba(59,130,246,0.15);
  --orange: #f97316; --orange-dim: rgba(249,115,22,0.14);
  --purple: #a855f7; --purple-dark: #7c3aed; --purple-dim: rgba(168,85,247,0.14);
  --text: #f1f5f9; --text2: #94a3b8; --text3: #64748b;
  --border: rgba(255,255,255,0.07); --border2: rgba(255,255,255,0.12);
  --radius: 16px; --radius-sm: 10px;
  --top-h: 58px;
  --fd: 'Rajdhani', sans-serif; --fb: 'Nunito', sans-serif;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }
html { scroll-behavior: smooth; }
body { background: var(--bg); font-family: var(--fb); color: var(--text); overflow-x: hidden; }

.si-shell { max-width: 1280px; margin: 0 auto; min-height: 100dvh; display: flex; flex-direction: column; background: var(--bg); }

/* TOP BAR */
.si-topbar {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 20px; height: var(--top-h);
  background: var(--bg); border-bottom: 1px solid var(--border);
  position: sticky; top: 0; z-index: 50; backdrop-filter: blur(12px); flex-shrink: 0;
}
.si-back-btn {
  width: 36px; height: 36px; border-radius: 50%;
  background: var(--surface); border: 1px solid var(--border2);
  display: flex; align-items: center; justify-content: center;
  color: var(--text2); text-decoration: none; flex-shrink: 0; transition: background 0.15s;
}
.si-back-btn:active { background: var(--bg3); }
.si-topbar-center { flex: 1; }
.si-brand { font-family: var(--fd); font-size: 20px; font-weight: 700; color: var(--green2); letter-spacing: 0.5px; }
.si-sub { font-size: 10px; color: var(--text3); letter-spacing: 1px; text-transform: uppercase; }
.si-topbar-icon {
  width: 36px; height: 36px; border-radius: 50%;
  background: var(--green-dim); border: 1px solid rgba(16,185,129,0.3);
  display: flex; align-items: center; justify-content: center; font-size: 18px;
  animation: iconpulse 3s ease-in-out infinite alternate;
}
@keyframes iconpulse { from { box-shadow: 0 0 0 rgba(16,185,129,0); } to { box-shadow: 0 0 16px rgba(16,185,129,0.4); } }

/* SEARCH BAR */
.si-search-wrap { padding: 12px 20px 0; flex-shrink: 0; }
@media (min-width: 960px) { .si-search-wrap { padding: 16px 32px 0; } }

.si-search-inner {
  display: flex; align-items: center; gap: 10px;
  background: var(--surface); border: 1px solid var(--border2);
  border-radius: 28px; padding: 10px 16px;
  transition: border-color 0.2s; max-width: 560px;
}
.si-search-inner:focus-within { border-color: rgba(16,185,129,0.5); box-shadow: 0 0 0 3px rgba(16,185,129,0.1); }
.si-search-inner svg { color: var(--text3); flex-shrink: 0; }
.si-search-input { flex: 1; background: none; border: none; outline: none; color: var(--text); font-family: var(--fb); font-size: 14px; }
.si-search-input::placeholder { color: var(--text3); }
.si-clear-btn { width: 22px; height: 22px; border-radius: 50%; background: var(--bg3); border: none; color: var(--text2); display: none; align-items: center; justify-content: center; cursor: pointer; font-size: 12px; flex-shrink: 0; }
.si-clear-btn.visible { display: flex; }

/* SCROLL BODY */
.si-scroll { flex: 1; overflow-y: auto; overflow-x: hidden; padding: 14px 20px 40px; scrollbar-width: thin; scrollbar-color: var(--border2) transparent; }
.si-scroll::-webkit-scrollbar { width: 4px; }
.si-scroll::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 4px; }
@media (min-width: 960px) { .si-scroll { padding: 20px 32px 48px; } }

/* SECTION LABEL */
.section-label {
  font-size: 11px; font-weight: 700; color: var(--text3);
  letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 10px; margin-top: 6px;
  display: flex; align-items: center; gap: 8px;
}
.section-label::after { content: ''; flex: 1; height: 1px; background: var(--border); }

/* HERO */
.si-hero {
  background: linear-gradient(135deg, #0c2340 0%, #0d3321 50%, #0f2d1a 100%);
  border-radius: var(--radius); padding: 20px; margin-bottom: 16px;
  position: relative; overflow: hidden; border: 1px solid rgba(16,185,129,0.2);
}
@media (min-width: 960px) { .si-hero { padding: 28px 32px; margin-bottom: 20px; } }
.si-hero::before {
  content: ''; position: absolute; inset: 0;
  background: repeating-linear-gradient(45deg, rgba(16,185,129,0.03) 0, rgba(16,185,129,0.03) 1px, transparent 1px, transparent 24px);
  pointer-events: none;
}
.si-hero-glow { position: absolute; right: -20px; top: -20px; width: 120px; height: 120px; border-radius: 50%; background: radial-gradient(circle, rgba(16,185,129,0.25), transparent 70%); pointer-events: none; }
.si-hero-label { font-size: 10px; color: rgba(255,255,255,0.45); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 4px; }
.si-hero-title { font-family: var(--fd); font-size: 26px; font-weight: 700; color: #fff; line-height: 1.1; display: flex; align-items: center; gap: 10px; }
@media (min-width: 960px) { .si-hero-title { font-size: 32px; } }
.si-hero-sub { font-size: 12px; color: var(--green2); margin-top: 6px; font-weight: 600; letter-spacing: 0.3px; }

/* DESKTOP PLAYER GRID */
@media (min-width: 960px) {
  #si-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(480px, 1fr));
    gap: 16px;
  }
  .si-player-card { margin-bottom: 0; }
}

/* EMPTY STATE */
.si-empty { text-align: center; padding: 40px 20px; display: none; }
.si-empty.visible { display: block; }
.si-empty-icon { font-size: 48px; margin-bottom: 12px; }
.si-empty-title { font-family: var(--fd); font-size: 18px; font-weight: 700; color: var(--text2); margin-bottom: 6px; }
.si-empty-sub { font-size: 13px; color: var(--text3); }

/* PLAYER CARD */
.si-player-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); margin-bottom: 14px; overflow: hidden;
  transition: border-color 0.2s;
}
.si-player-card.search-hidden { display: none; }
.si-player-card:hover { border-color: rgba(16,185,129,0.25); }

.si-card-header {
  display: flex; align-items: center; gap: 12px;
  padding: 14px 16px;
  background: linear-gradient(135deg, rgba(16,185,129,0.1) 0%, rgba(5,150,105,0.05) 100%);
  border-bottom: 1px solid var(--border);
  cursor: pointer; user-select: none;
}
.si-card-av {
  width: 46px; height: 46px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--fd); font-size: 15px; font-weight: 700;
  flex-shrink: 0; border: 2px solid;
}
.si-card-info { flex: 1; min-width: 0; }
.si-card-name { font-family: var(--fd); font-size: 18px; font-weight: 700; color: var(--text); line-height: 1; }
.si-card-sub { font-size: 10px; color: var(--text3); margin-top: 3px; letter-spacing: 0.5px; text-transform: uppercase; }
.si-chevron { font-size: 20px; color: var(--text3); transition: transform 0.25s; flex-shrink: 0; }
.si-chevron.open { transform: rotate(180deg); }

/* Season tabs */
.si-season-tabs { display: flex; overflow-x: auto; scrollbar-width: none; border-bottom: 1px solid var(--border); background: rgba(0,0,0,0.18); }
.si-season-tabs::-webkit-scrollbar { display: none; }
.si-stab {
  flex-shrink: 0; padding: 9px 14px;
  font-family: var(--fd); font-size: 12px; font-weight: 700;
  color: var(--text3); cursor: pointer;
  border-bottom: 2px solid transparent; letter-spacing: 0.5px;
  transition: all 0.15s; white-space: nowrap; user-select: none;
}
.si-stab.active { color: var(--green2); border-bottom-color: var(--green); background: rgba(16,185,129,0.06); }
.si-stab:hover { background: rgba(16,185,129,0.04); }

/* Stats pane */
.si-stats-pane { display: none; padding: 14px; }
.si-stats-pane.active { display: block; }

/* Section hdr */
.si-section-hdr { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; margin-top: 4px; }
.si-section-icon { width: 28px; height: 28px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0; }
.si-section-title { font-family: var(--fd); font-size: 13px; font-weight: 700; color: var(--text2); letter-spacing: 0.5px; text-transform: uppercase; }

/* 2x2 stat grid */
.si-stat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; }
.si-stat-box { background: rgba(0,0,0,0.22); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px; transition: background 0.15s; position: relative; overflow: hidden; }
.si-stat-box:hover { background: rgba(255,255,255,0.03); }
.si-stat-val { font-family: var(--fd); font-size: 22px; font-weight: 700; color: var(--green2); line-height: 1; margin-bottom: 2px; }
.si-stat-lbl { font-size: 10px; color: var(--text3); font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; }
.si-stat-accent { position: absolute; bottom: 0; right: 0; width: 36px; height: 36px; border-radius: 50% 0 0 0; opacity: 0.08; }

.si-divider { height: 1px; background: var(--border); margin: 10px 0; }

/* Career section */
.si-career-section { background: linear-gradient(135deg, rgba(245,158,11,0.08), rgba(251,191,36,0.04)); border: 1px solid rgba(245,158,11,0.22); border-radius: var(--radius-sm); padding: 12px; margin-top: 4px; }
.si-career-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; }
.si-career-box { background: rgba(245,158,11,0.06); border: 1px solid rgba(245,158,11,0.15); border-radius: 8px; padding: 10px 8px; text-align: center; }
.si-career-val { font-family: var(--fd); font-size: 19px; font-weight: 700; color: var(--gold2); }
.si-career-lbl { font-size: 9px; color: var(--text3); font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase; margin-top: 2px; }

/* Rating meter */
.si-meter { background: rgba(0,0,0,0.22); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 14px; margin-top: 12px; }
.si-meter-title { font-family: var(--fd); font-size: 12px; font-weight: 700; color: var(--text3); letter-spacing: 1px; text-transform: uppercase; text-align: center; margin-bottom: 12px; }
.si-meter-bars { display: flex; align-items: flex-end; gap: 8px; height: 80px; justify-content: center; }
.si-mbar-wrap { display: flex; flex-direction: column; align-items: center; gap: 4px; flex: 1; }
.si-mbar-val { font-family: var(--fd); font-size: 11px; font-weight: 700; color: var(--text2); }
.si-mbar { width: 100%; border-radius: 6px 6px 0 0; background: linear-gradient(to top, var(--green), var(--gold2), var(--green)); min-height: 4px; transition: height 0.8s cubic-bezier(0.34,1.56,0.64,1); }
.si-mbar-lbl { font-size: 9px; color: var(--text3); text-align: center; letter-spacing: 0.3px; font-weight: 600; }
</style>

<div class="si-shell">

  <div class="si-topbar">
    <a href="<%= spl_dashboard_path %>" class="si-back-btn">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15,18 9,12 15,6"/></svg>
    </a>
    <div class="si-topbar-center">
      <div class="si-brand">SPL Insights</div>
      <div class="si-sub">Player Stats · All Seasons</div>
    </div>
    <div class="si-topbar-icon">📊</div>
  </div>

  <div class="si-search-wrap">
    <div class="si-search-inner">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input class="si-search-input" id="si-search" type="text" placeholder="Search players…" autocomplete="off">
      <button class="si-clear-btn" id="si-clear">✕</button>
    </div>
  </div>

  <div class="si-scroll">

    <div class="si-hero" style="margin-top:12px">
      <div class="si-hero-glow"></div>
      <div style="position:relative;z-index:1">
        <div class="si-hero-label">Sugam Premier League</div>
        <div class="si-hero-title">📊 Player Insights</div>
        <div class="si-hero-sub">Advanced Cricket Analytics &amp; Performance Metrics</div>
      </div>
    </div>

    <div class="si-empty" id="si-empty">
      <div class="si-empty-icon">🏏</div>
      <div class="si-empty-title">No Players Found</div>
      <div class="si-empty-sub">Try a different search term</div>
    </div>

    <div id="si-cards">
      <%
        seasons = ['4','5','6','7','8','9', '10']
        av_colors = ['#10b981','#3b82f6','#f59e0b','#ef4444','#a855f7','#f97316','#06b6d4','#ec4899']
        av_borders = ['rgba(16,185,129,0.5)','rgba(59,130,246,0.5)','rgba(245,158,11,0.5)','rgba(239,68,68,0.5)','rgba(168,85,247,0.5)','rgba(249,115,22,0.5)','rgba(6,182,212,0.5)','rgba(236,72,153,0.5)']
        accent_colors = ['rgba(16,185,129,1)','rgba(59,130,246,1)','rgba(245,158,11,1)','rgba(239,68,68,1)','rgba(168,85,247,1)','rgba(249,115,22,1)','rgba(6,182,212,1)','rgba(236,72,153,1)']
      %>

      <% @auction_players.each_with_index do |player, pi| %>
        <%
          color = av_colors[pi % av_colors.length]
          border_c = av_borders[pi % av_borders.length]
          accent = accent_colors[pi % accent_colors.length]
          initials = player[:name].split(' ').map{|w|w[0]}.join.slice(0,2).upcase
          pid = "p#{pi}"

          total_runs = seasons.sum { |s| player["spl#{s}_run".to_sym].to_i }
          total_wickets = seasons.sum { |s| player["spl#{s}_wickets".to_sym].to_i }
          total_matches = seasons.sum { |s| player["spl#{s}_matches".to_sym].to_i }
          seasons_with_bat = seasons.count { |s| player["spl#{s}_run".to_sym].to_i > 0 }
          seasons_with_bowl = seasons.count { |s| player["spl#{s}_overs".to_sym].to_f > 0 }
          sr_vals = seasons.map { |s| player["spl#{s}_sr".to_sym].to_f }.select { |v| v > 0 }
          avg_sr = sr_vals.any? ? (sr_vals.sum / sr_vals.size).round(1) : 0
          econ_vals = seasons.map { |s| player["spl#{s}_econ".to_sym].to_f }.select { |v| v > 0 }
          avg_econ = econ_vals.any? ? (econ_vals.sum / econ_vals.size).round(2) : 0
          avg_runs_season = seasons_with_bat > 0 ? (total_runs.to_f / seasons_with_bat).round(1) : 0
          avg_wkts_season = seasons_with_bowl > 0 ? (total_wickets.to_f / seasons_with_bowl).round(1) : 0

          bat_h  = [[(total_runs / 8.0), 100].min, 4].max.round
          bowl_h = [[(total_wickets * 4.0), 100].min, 4].max.round
          sr_h   = [[(avg_sr / 2.0), 100].min, 4].max.round
        %>

        <div class="si-player-card" data-name="<%= player[:name].downcase %>" id="card-<%= pid %>">

          <div class="si-card-header" onclick="toggleCard('<%= pid %>')">
            <div class="si-card-av" style="background:rgba(<%= color.gsub('#','').scan(/../).map{|x|x.to_i(16)}.join(',') %>,0.15);color:<%= color %>;border-color:<%= border_c %>">
              <%= initials %>
            </div>
            <div class="si-card-info">
              <div class="si-card-name"><%= player[:name] %></div>
              <div class="si-card-sub">🏏 <%= total_runs %> runs · 🎯 <%= total_wickets %> wkts · <%= total_matches %> matches</div>
            </div>
            <div class="si-chevron" id="chev-<%= pid %>">▾</div>
          </div>

          <div id="body-<%= pid %>">
            <div class="si-season-tabs" id="tabs-<%= pid %>">
              <div class="si-stab active" onclick="switchTab('<%= pid %>','career')">Career</div>
              <% seasons.each do |spl| %>
                <div class="si-stab" onclick="switchTab('<%= pid %>','spl<%= spl %>')">SPL <%= spl %></div>
              <% end %>
            </div>

            <%# Career pane %>
            <div class="si-stats-pane active" id="pane-<%= pid %>-career">
              <div class="si-section-hdr">
                <div class="si-section-icon" style="background:var(--gold-dim);color:var(--gold2)">🏆</div>
                <div class="si-section-title">Career Averages (All Seasons)</div>
              </div>

              <div class="si-career-section">
                <div class="si-career-grid">
                  <div class="si-career-box"><div class="si-career-val"><%= avg_runs_season %></div><div class="si-career-lbl">Avg Runs/Season</div></div>
                  <div class="si-career-box"><div class="si-career-val"><%= avg_sr %></div><div class="si-career-lbl">Avg Strike Rate</div></div>
                  <div class="si-career-box"><div class="si-career-val"><%= avg_wkts_season %></div><div class="si-career-lbl">Avg Wkts/Season</div></div>
                  <div class="si-career-box"><div class="si-career-val"><%= avg_econ %></div><div class="si-career-lbl">Avg Economy</div></div>
                  <div class="si-career-box"><div class="si-career-val"><%= [seasons_with_bat, seasons_with_bowl].max %></div><div class="si-career-lbl">Seasons Played</div></div>
                  <div class="si-career-box"><div class="si-career-val"><%= total_matches %></div><div class="si-career-lbl">Total Matches</div></div>
                </div>
              </div>

              <div class="si-divider" style="margin:14px 0"></div>

              <div class="si-section-hdr">
                <div class="si-section-icon" style="background:var(--blue-dim);color:var(--blue)">📈</div>
                <div class="si-section-title">Season-by-Season Runs</div>
              </div>
              <div style="display:flex;align-items:flex-end;gap:8px;height:80px;margin-bottom:6px">
                <%
                  season_runs = seasons.map { |s| player["spl#{s}_run".to_sym].to_i }
                  max_s_runs = [season_runs.max, 1].max
                %>
                <% seasons.each_with_index do |spl, si| %>
                  <% rh = [(season_runs[si].to_f / max_s_runs * 100), 4].max.round %>
                  <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:4px">
                    <div style="font-family:var(--fd);font-size:10px;font-weight:700;color:var(--text2)"><%= season_runs[si] %></div>
                    <div style="width:100%;height:<%= rh %>%;border-radius:5px 5px 0 0;background:linear-gradient(to top,var(--green),var(--green2));min-height:4px;transition:height .6s cubic-bezier(.34,1.56,.64,1)"></div>
                    <div style="font-size:9px;color:var(--text3);font-weight:700">S<%= spl %></div>
                  </div>
                <% end %>
              </div>

              <div class="si-divider" style="margin:10px 0"></div>

              <div class="si-section-hdr">
                <div class="si-section-icon" style="background:var(--purple-dim);color:var(--purple)">📉</div>
                <div class="si-section-title">Season-by-Season Wickets</div>
              </div>
              <div style="display:flex;align-items:flex-end;gap:8px;height:80px;margin-bottom:14px">
                <%
                  season_wkts = seasons.map { |s| player["spl#{s}_wickets".to_sym].to_i }
                  max_s_wkts = [season_wkts.max, 1].max
                %>
                <% seasons.each_with_index do |spl, si| %>
                  <% wh2 = [(season_wkts[si].to_f / max_s_wkts * 100), 4].max.round %>
                  <div style="flex:1;display:flex;flex-direction:column;align-items:center;gap:4px">
                    <div style="font-family:var(--fd);font-size:10px;font-weight:700;color:var(--text2)"><%= season_wkts[si] %></div>
                    <div style="width:100%;height:<%= wh2 %>%;border-radius:5px 5px 0 0;background:linear-gradient(to top,#7c3aed,var(--purple));min-height:4px;transition:height .6s cubic-bezier(.34,1.56,.64,1)"></div>
                    <div style="font-size:9px;color:var(--text3);font-weight:700">S<%= spl %></div>
                  </div>
                <% end %>
              </div>

              <div class="si-meter">
                <div class="si-meter-title">⚡ All SPL Rating</div>
                <div class="si-meter-bars">
                  <div class="si-mbar-wrap"><div class="si-mbar-val"><%= total_runs %></div><div class="si-mbar" style="height:<%= bat_h %>%"></div><div class="si-mbar-lbl">Total Runs</div></div>
                  <div class="si-mbar-wrap"><div class="si-mbar-val"><%= avg_sr %></div><div class="si-mbar" style="height:<%= sr_h %>%;background:linear-gradient(to top,var(--orange),var(--gold2))"></div><div class="si-mbar-lbl">Avg SR</div></div>
                  <div class="si-mbar-wrap"><div class="si-mbar-val"><%= total_wickets %></div><div class="si-mbar" style="height:<%= bowl_h %>%;background:linear-gradient(to top,var(--purple),#c084fc)"></div><div class="si-mbar-lbl">Total Wkts</div></div>
                </div>
              </div>
            </div>

            <%# Per-Season Panes %>
            <% seasons.each do |spl| %>
              <div class="si-stats-pane" id="pane-<%= pid %>-spl<%= spl %>">
                <div class="si-section-hdr">
                  <div class="si-section-icon" style="background:var(--orange-dim);color:var(--orange)">🏏</div>
                  <div class="si-section-title">Batting</div>
                </div>
                <div class="si-stat-grid">
                  <div class="si-stat-box"><div class="si-stat-val" style="color:<%= color %>"><%= player["spl#{spl}_run".to_sym] || 0 %></div><div class="si-stat-lbl">Runs</div><div class="si-stat-accent" style="background:<%= color %>"></div></div>
                  <div class="si-stat-box"><div class="si-stat-val" style="color:<%= color %>"><%= player["spl#{spl}_matches".to_sym] || 0 %></div><div class="si-stat-lbl">Matches</div></div>
                  <div class="si-stat-box"><div class="si-stat-val" style="color:<%= color %>"><%= player["spl#{spl}_sixes".to_sym] || 0 %></div><div class="si-stat-lbl">Sixes 💥</div></div>
                  <div class="si-stat-box"><div class="si-stat-val" style="color:<%= color %>"><%= player["spl#{spl}_sr".to_sym] || 0 %></div><div class="si-stat-lbl">Strike Rate</div></div>
                </div>

                <div style="display:flex;gap:7px;overflow-x:auto;scrollbar-width:none;padding-bottom:4px;margin-bottom:10px">
                  <% [["High Score","spl#{spl}_highest_score".to_sym],["Fours","spl#{spl}_fours".to_sym], ["Sixes","spl#{spl}_sixes".to_sym], ["50s","spl#{spl}_fifties".to_sym],["100s 💯","spl#{spl}_hundreds".to_sym]].each do |lbl, key| %>
                    <div style="flex-shrink:0;background:var(--bg3);border:1px solid var(--border2);border-radius:20px;padding:5px 12px;text-align:center">
                      <div style="font-family:var(--fd);font-size:14px;font-weight:700;color:var(--text)"><%= player[key] || 0 %></div>
                      <div style="font-size:9px;color:var(--text3);text-transform:uppercase;letter-spacing:0.5px"><%= lbl %></div>
                    </div>
                  <% end %>
                </div>

                <div class="si-divider"></div>

                <div class="si-section-hdr" style="margin-top:8px">
                  <div class="si-section-icon" style="background:var(--purple-dim);color:var(--purple)">🎯</div>
                  <div class="si-section-title">Bowling</div>
                </div>
                <div class="si-stat-grid">
                  <div class="si-stat-box"><div class="si-stat-val" style="color:var(--purple)"><%= player["spl#{spl}_wickets".to_sym] || 0 %></div><div class="si-stat-lbl">Wickets</div></div>
                  <div class="si-stat-box"><div class="si-stat-val" style="color:var(--purple)"><%= player["spl#{spl}_overs".to_sym] || 0 %></div><div class="si-stat-lbl">Overs</div></div>
                  <div class="si-stat-box"><div class="si-stat-val" style="color:var(--purple)"><%= player["spl#{spl}_econ".to_sym] || 0 %></div><div class="si-stat-lbl">Economy</div></div>
                  <div class="si-stat-box"><div class="si-stat-val" style="color:var(--purple)"><%= player["spl#{spl}_maidens".to_sym] || 0 %></div><div class="si-stat-lbl">Maidens</div></div>
                </div>

                <% runs_given = player["spl#{spl}_runs_given".to_sym] %>
                <% if runs_given.present? && runs_given.to_i > 0 %>
                  <div style="display:inline-flex;background:var(--bg3);border:1px solid var(--border2);border-radius:20px;padding:5px 12px;gap:6px;align-items:center;margin-bottom:10px">
                    <span style="font-family:var(--fd);font-size:14px;font-weight:700;color:var(--text)"><%= runs_given %></span>
                    <span style="font-size:9px;color:var(--text3);text-transform:uppercase;letter-spacing:0.5px">Runs Given</span>
                  </div>
                <% end %>

                <div class="si-meter">
                  <div class="si-meter-title">⚡ Season Snapshot</div>
                  <div class="si-meter-bars">
                    <%
                      s_runs = player["spl#{spl}_run".to_sym].to_i
                      s_wkts = player["spl#{spl}_wickets".to_sym].to_i
                      s_sr   = player["spl#{spl}_sr".to_sym].to_f
                      bh = [[(s_runs / 8.0),100].min, 4].max.round
                      wh = [[(s_wkts * 5.0),100].min, 4].max.round
                      sh = [[(s_sr / 2.0),100].min, 4].max.round
                    %>
                    <div class="si-mbar-wrap"><div class="si-mbar-val"><%= s_runs %></div><div class="si-mbar" style="height:<%= bh %>%"></div><div class="si-mbar-lbl">Runs</div></div>
                    <div class="si-mbar-wrap"><div class="si-mbar-val"><%= s_sr.round(1) %></div><div class="si-mbar" style="height:<%= sh %>%;background:linear-gradient(to top,var(--orange),var(--gold2))"></div><div class="si-mbar-lbl">Avg SR</div></div>
                    <div class="si-mbar-wrap"><div class="si-mbar-val"><%= s_wkts %></div><div class="si-mbar" style="height:<%= wh %>%;background:linear-gradient(to top,var(--purple),#c084fc)"></div><div class="si-mbar-lbl">Wickets</div></div>
                  </div>
                </div>
              </div>
            <% end %>

          </div>
        </div>
      <% end %>
    </div>

    <div style="height:8px"></div>
  </div>
</div>

<script>
const collapsed = new Set();

function toggleCard(pid) {
  const body = document.getElementById('body-' + pid);
  const chev = document.getElementById('chev-' + pid);
  if (!body) return;
  if (collapsed.has(pid)) {
    collapsed.delete(pid);
    body.style.display = '';
    chev.classList.remove('open');
  } else {
    collapsed.add(pid);
    body.style.display = 'none';
    chev.classList.add('open');
  }
}

function switchTab(pid, season) {
  const tabsEl = document.getElementById('tabs-' + pid);
  if (!tabsEl) return;
  tabsEl.querySelectorAll('.si-stab').forEach(t => t.classList.remove('active'));
  const tabs = [...tabsEl.querySelectorAll('.si-stab')];
  const clickedTab = tabs.find(t => {
    const text = t.textContent.trim().toLowerCase().replace(/\s/g,'');
    const target = season.toLowerCase().replace(/\s/g,'');
    return text === target || (target.startsWith('spl') && text === 'spl' + target.replace('spl',''));
  });
  if (clickedTab) clickedTab.classList.add('active');

  const card = document.getElementById('card-' + pid);
  if (!card) return;
  card.querySelectorAll('.si-stats-pane').forEach(p => p.classList.remove('active'));
  const pane = document.getElementById('pane-' + pid + '-' + season);
  if (pane) pane.classList.add('active');
}

const searchInput = document.getElementById('si-search');
const clearBtn = document.getElementById('si-clear');
const emptyState = document.getElementById('si-empty');

function performSearch() {
  const q = searchInput.value.trim().toLowerCase();
  clearBtn.classList.toggle('visible', q.length > 0);
  let visibleCount = 0;
  document.querySelectorAll('.si-player-card').forEach(card => {
    const match = (card.getAttribute('data-name') || '').includes(q);
    card.classList.toggle('search-hidden', !match);
    if (match) visibleCount++;
  });
  emptyState.classList.toggle('visible', q.length > 0 && visibleCount === 0);
}

searchInput.addEventListener('input', performSearch);
clearBtn.addEventListener('click', () => { searchInput.value = ''; performSearch(); searchInput.focus(); });

document.querySelectorAll('.si-player-card').forEach((card, i) => {
  card.style.opacity = '0';
  card.style.transform = 'translateY(20px)';
  setTimeout(() => {
    card.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
    card.style.opacity = '1';
    card.style.transform = 'translateY(0)';
  }, 60 + i * 50);
});
</script>