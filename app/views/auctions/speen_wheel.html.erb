                </div>
                <div class="stat-item">
                  <div class="stat-label">50s</div>
                  <div class="stat-value">${stats.fifties || 0}</div>
                </div>
                <div class="stat-item">
                  <div class="stat-label">100s</div>
                  <div class="stat-value highlight">${stats.hundreds || 0}</div>
                </div>
              </div>
            </div>
          ` : ''}
          
          ${hasBowling ? `
            <div class="stat-category">
              <div class="stat-category-title">
