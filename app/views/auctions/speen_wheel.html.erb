<%= stylesheet_link_tag "https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" %>

<div class="premium-spin-container">
  <!-- Animated Background -->
  <div class="animated-background">
    <div class="gradient-orb orb-1"></div>
    <div class="gradient-orb orb-2"></div>
    <div class="gradient-orb orb-3"></div>
  </div>

  <!-- Top Header with Enhanced Design -->
  <div class="premium-header">
    <div class="header-content">
      <div class="trophy-animation">
        <i class="fas fa-trophy"></i>
      </div>
      <div class="header-text">
        <h1 class="main-title">
          <span class="title-word">IPL</span>
          <span class="title-word">AUCTION</span>
          <span class="title-word">WHEEL</span>
        </h1>
        <p class="header-subtitle">
          <i class="fas fa-cricket-ball"></i>
          Spin the wheel to discover your next cricket superstar!
        </p>
      </div>
      <div class="trophy-animation">
        <i class="fas fa-trophy"></i>
      </div>
    </div>
    
    <!-- Live Stats Bar -->
    <div class="live-stats-bar">
      <div class="stat-badge">
        <i class="fas fa-users"></i>
        <div class="stat-info">
          <span class="stat-value" id="totalPlayers">300</span>
          <span class="stat-label">Total Players</span>
        </div>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-badge">
        <i class="fas fa-user-check"></i>
        <div class="stat-info">
          <span class="stat-value" id="remainingPlayers">300</span>
          <span class="stat-label">Available</span>
        </div>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-badge">
        <i class="fas fa-star"></i>
        <div class="stat-info">
          <span class="stat-value" id="selectedCount">0</span>
          <span class="stat-label">Selected</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="main-content-grid">
    <!-- Left Panel: Wheel Section -->
    <div class="wheel-panel">
      <!-- Control Panel -->
      <div class="control-panel">
        <button id="spinBtn" class="premium-spin-btn">
          <span class="btn-content">
            <i class="fas fa-play-circle"></i>
            <span class="btn-text">SPIN THE WHEEL</span>
          </span>
          <span class="btn-glow"></span>
        </button>
        
        <div class="volume-panel">
          <div class="volume-header">
            <i class="fas fa-volume-up volume-icon"></i>
            <span class="volume-text">Audio Control</span>
          </div>
          <div class="volume-slider-container">
            <input type="range" id="volumeSlider" class="premium-volume-slider" min="0" max="100" value="70">
            <div class="volume-track-fill" id="volumeTrackFill"></div>
          </div>
          <span class="volume-percentage" id="volumeLabel">70%</span>
        </div>
      </div>

      <!-- Enhanced Wheel Container -->
      <div class="wheel-showcase" style="margin-top: 110px;">
        <div class="wheel-frame">
          <!-- Animated Ring -->
          <div class="rotating-ring"></div>
          
          <!-- Cricket Field Elements -->
          <div class="cricket-field">
            <div class="boundary-rope"></div>
            <div class="pitch-marker"></div>
          </div>
          
          <!-- The Wheel Canvas -->
          <div class="canvas-wrapper">
            <canvas id="wheelCanvas" width="800" height="800"></canvas>
          </div>
          
          <!-- Premium Pointer -->
          <div class="premium-pointer">
            <div class="pointer-arrow">
              <i class="fas fa-location-arrow"></i>
            </div>
            <div class="pointer-pulse"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Panel: Results & Info -->
    <div class="info-panel" style="margin-bottom: 50px;">
      <!-- Selected Player Showcase -->
      <div class="player-showcase">
        <div class="showcase-header">
          <div class="header-decoration"></div>
          <h2 class="showcase-title">
            <i class="fas fa-star"></i>
            PLAYER SPOTLIGHT
          </h2>
          <div class="header-decoration"></div>
        </div>
        
        <div id="selectedPlayerDisplay" class="player-display-area">
          <div class="default-state">
            <div class="animated-cricket-ball">
              <i class="fas fa-baseball-ball"></i>
            </div>
            <h3 class="default-title">Ready to Spin?</h3>
            <p class="default-message">Click the spin button to select your next cricket star!</p>
            <div class="default-stats">
              <div class="mini-stat">
                <i class="fas fa-fire"></i>
                <span>Exciting Players</span>
              </div>
              <div class="mini-stat">
                <i class="fas fa-bolt"></i>
                <span>Random Selection</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
          <button id="resetWheelBtn" class="action-btn reset-btn" disabled>
            <i class="fas fa-redo-alt"></i>
            <span>Reset All</span>
          </button>
        </div>
      </div>

      <!-- Recent Selections Timeline -->
      <div class="timeline-container">
        <div class="timeline-header">
          <i class="fas fa-history"></i>
          <h3>Selection History</h3>
          <span class="timeline-badge" id="historyCount">0</span>
        </div>
        <div id="recentPlayers" class="timeline-content">
          <div class="empty-timeline">
            <i class="fas fa-clipboard-list"></i>
            <p>No selections yet</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Hidden Player Data -->
  <div id="playersData" style="display: none;">
    <% @players.each do |player| %>
    <% p = Player.find(player[:id]) %>
      <div class="player-data" 
           data-id="<%= player[:id] %>" 
           data-name="<%= player[:name] %>"
           data-role="<%= player[:role] %>"
           data-batting_style="<%= player[:batting_style] %>"
           data-bowling_style="<%= player[:bowling_style] %>"
           data-team_name="<%= player[:team_name] %>"
           data-team_logo="<%= team_logo_url(player[:team_name]) %>"
           data-image="<%= player_image_url(p) %>"
           data-stats="<%= player[:stats].to_json if player[:stats] %>">
      </div>
    <% end %>
  </div>
  
  <!-- Audio Status Indicator -->
  <div id="audioStatus" class="audio-toast">
    <i class="fas fa-volume-up"></i>
    <span id="audioStatusText">Audio Ready</span>
  </div>

  <!-- Success Toast Notification -->
  <div id="successToast" class="success-toast">
    <i class="fas fa-check-circle"></i>
    <span id="toastMessage"></span>
  </div>
</div>

<!-- Confetti Effect -->
<div id="confetti-container"></div>

<%= javascript_include_tag "https://cdn.jsdelivr.net/npm/canvas-confetti@1.5.1/dist/confetti.browser.min.js" %>

<style>
/* ===== CSS VARIABLES ===== */
:root {
  --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  --secondary-gradient: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  --success-gradient: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  --gold-gradient: linear-gradient(135deg, #ffd89b 0%, #19547b 100%);
  --dark-bg: #0a0e27;
  --card-bg: rgba(255, 255, 255, 0.05);
  --card-border: rgba(255, 255, 255, 0.1);
  --text-primary: #ffffff;
  --text-secondary: rgba(255, 255, 255, 0.7);
  --accent-color: #ffd700;
  --shadow-lg: 0 20px 60px rgba(0, 0, 0, 0.3);
  --shadow-xl: 0 30px 80px rgba(0, 0, 0, 0.4);
}

/* ===== GLOBAL STYLES ===== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.premium-spin-container {
  font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
  background: var(--dark-bg);
  min-height: 100vh;
  color: var(--text-primary);
  padding: 20px;
  margin-left: 50px;
  width: 110%;
  position: relative;
  overflow-x: hidden;
}

/* ===== ANIMATED BACKGROUND ===== */
.animated-background {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  overflow: hidden;
}

.gradient-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
  opacity: 0.3;
  animation: float 20s infinite ease-in-out;
}

.orb-1 {
  width: 500px;
  height: 500px;
  background: radial-gradient(circle, #667eea 0%, transparent 70%);
  top: -200px;
  left: -200px;
  animation-delay: 0s;
}

.orb-2 {
  width: 400px;
  height: 400px;
  background: radial-gradient(circle, #f5576c 0%, transparent 70%);
  top: 50%;
  right: -150px;
  animation-delay: 7s;
}

.orb-3 {
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, #4facfe 0%, transparent 70%);
  bottom: -250px;
  left: 30%;
  animation-delay: 14s;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(100px, -100px) scale(1.1); }
  66% { transform: translate(-50px, 100px) scale(0.9); }
}

/* ===== PREMIUM HEADER ===== */
.premium-header {
  position: relative;
  z-index: 1;
  background: var(--card-bg);
  backdrop-filter: blur(20px);
  border-radius: 24px;
  padding: 30px;
  margin-bottom: 30px;
  border: 1px solid var(--card-border);
  box-shadow: var(--shadow-lg);
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 30px;
  margin-bottom: 25px;
}

.trophy-animation {
  font-size: 3.5rem;
  color: var(--accent-color);
  animation: trophy-bounce 2s infinite ease-in-out;
  filter: drop-shadow(0 0 20px rgba(255, 215, 0, 0.5));
}

@keyframes trophy-bounce {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  25% { transform: translateY(-10px) rotate(-5deg); }
  75% { transform: translateY(-10px) rotate(5deg); }
}

.header-text {
  text-align: center;
}

.main-title {
  font-size: 3.5rem;
  font-weight: 900;
  display: flex;
  gap: 20px;
  margin-bottom: 10px;
  letter-spacing: 2px;
}

.title-word {
  background: linear-gradient(135deg, #ffd700 0%, #ff8c00 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: title-glow 3s infinite alternate;
  text-shadow: 0 0 30px rgba(255, 215, 0, 0.3);
}

@keyframes title-glow {
  0% { filter: brightness(1); }
  100% { filter: brightness(1.3); }
}

.header-subtitle {
  font-size: 1.3rem;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
}

.header-subtitle i {
  color: var(--accent-color);
  animation: spin 4s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* ===== LIVE STATS BAR ===== */
.live-stats-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20px;
  padding: 20px;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 16px;
  border: 1px solid rgba(255, 255, 255, 0.05);
}

.stat-badge {
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 15px 25px;
  background: var(--card-bg);
  border-radius: 12px;
  border: 1px solid var(--card-border);
  transition: all 0.3s ease;
}

.stat-badge:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
  border-color: rgba(102, 126, 234, 0.5);
}

.stat-badge i {
  font-size: 2rem;
  color: var(--accent-color);
}

.stat-info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.stat-value {
  font-size: 2rem;
  font-weight: 800;
  color: var(--text-primary);
  line-height: 1;
}

.stat-label {
  font-size: 0.85rem;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-top: 4px;
}

.stat-divider {
  width: 2px;
  height: 40px;
  background: linear-gradient(to bottom, transparent, var(--card-border), transparent);
}

/* ===== MAIN CONTENT GRID ===== */
.main-content-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: 30px;
  max-width: 1800px;
  margin: 0 auto;
}

/* ===== WHEEL PANEL ===== */
.wheel-panel {
  display: flex;
  flex-direction: column;
  gap: 25px;
}

/* ===== CONTROL PANEL ===== */
.control-panel {
  background: var(--card-bg);
  backdrop-filter: blur(20px);
  border-radius: 20px;
  padding: 25px;
  border: 1px solid var(--card-border);
  box-shadow: var(--shadow-lg);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
}

.premium-spin-btn {
  position: relative;
  padding: 20px 50px;
  font-size: 1.4rem;
  font-weight: 800;
  color: white;
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  border: none;
  border-radius: 50px;
  cursor: pointer;
  overflow: hidden;
  transition: all 0.3s ease;
  box-shadow: 0 10px 30px rgba(245, 87, 108, 0.4);
}

.premium-spin-btn:hover:not(:disabled) {
  transform: translateY(-3px) scale(1.02);
  box-shadow: 0 15px 40px rgba(245, 87, 108, 0.6);
}

.premium-spin-btn:active:not(:disabled) {
  transform: translateY(-1px) scale(0.98);
}

.premium-spin-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

.btn-content {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 12px;
}

.btn-glow {
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  transition: left 0.5s;
}

.premium-spin-btn:hover:not(:disabled) .btn-glow {
  left: 100%;
}

/* ===== VOLUME PANEL ===== */
.volume-panel {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 20px;
  background: rgba(0, 0, 0, 0.2);
  border-radius: 16px;
  border: 1px solid var(--card-border);
  min-width: 250px;
}

.volume-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 8px;
}

.volume-icon {
  font-size: 1.3rem;
  color: var(--accent-color);
}

.volume-text {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text-secondary);
  text-transform: uppercase;
  letter-spacing: 1px;
}

.volume-slider-container {
  position: relative;
  height: 8px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  overflow: hidden;
}

.volume-track-fill {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 70%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  border-radius: 10px;
  transition: width 0.1s ease;
}

.premium-volume-slider {
  position: absolute;
  top: 50%;
  left: 0;
  transform: translateY(-50%);
  width: 100%;
  height: 8px;
  background: transparent;
  outline: none;
  cursor: pointer;
  -webkit-appearance: none;
  z-index: 2;
}

.premium-volume-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 20px;
  height: 20px;
  background: linear-gradient(135deg, #ffd700, #ff8c00);
  border-radius: 50%;
  cursor: pointer;
  box-shadow: 0 2px 10px rgba(255, 215, 0, 0.5);
  transition: all 0.2s ease;
}

.premium-volume-slider::-webkit-slider-thumb:hover {
  transform: scale(1.2);
  box-shadow: 0 4px 15px rgba(255, 215, 0, 0.8);
}

.premium-volume-slider::-moz-range-thumb {
  width: 20px;
  height: 20px;
  background: linear-gradient(135deg, #ffd700, #ff8c00);
  border-radius: 50%;
  border: none;
  cursor: pointer;
  box-shadow: 0 2px 10px rgba(255, 215, 0, 0.5);
  transition: all 0.2s ease;
}

.premium-volume-slider::-moz-range-thumb:hover {
  transform: scale(1.2);
  box-shadow: 0 4px 15px rgba(255, 215, 0, 0.8);
}

.volume-percentage {
  text-align: center;
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--accent-color);
  margin-top: 5px;
}

/* ===== WHEEL SHOWCASE ===== */
.wheel-showcase {
  background: var(--card-bg);
  backdrop-filter: blur(20px);
  border-radius: 24px;
  padding: 40px;
  border: 1px solid var(--card-border);
  box-shadow: var(--shadow-xl);
  position: relative;
}

.wheel-frame {
  position: relative;
  max-width: 700px;
  margin: 0 auto;
}

.rotating-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 110%;
  height: 110%;
  border: 3px solid transparent;
  border-radius: 50%;
  border-top-color: var(--accent-color);
  border-right-color: var(--accent-color);
  animation: ring-rotate 4s linear infinite;
  opacity: 0.3;
}

@keyframes ring-rotate {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

.cricket-field {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.boundary-rope {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 95%;
  height: 95%;
  border: 2px dashed rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.pitch-marker {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 30%;
  height: 3px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
}

.canvas-wrapper {
  position: relative;
  width: 100%;
}

#wheelCanvas {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 50%;
  filter: drop-shadow(0 0 30px rgba(102, 126, 234, 0.3));
  transition: filter 0.3s ease;
  cursor: pointer;
}

#wheelCanvas:hover {
  filter: drop-shadow(0 0 40px rgba(102, 126, 234, 0.5));
}

#wheelCanvas.disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

/* ===== PREMIUM POINTER ===== */
.premium-pointer {
  position: absolute;
  top: 50%;
  right: 5%;
  transform: translateY(-50%);
  z-index: 10;
}

.pointer-arrow {
  font-size: 3.5rem;
  color: #f5576c;
  filter: drop-shadow(0 0 15px rgba(245, 87, 108, 0.8));
  animation: pointer-pulse 1.5s infinite ease-in-out;
}

@keyframes pointer-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.15); }
}

.pointer-pulse {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 60px;
  height: 60px;
  border: 3px solid #f5576c;
  border-radius: 50%;
  animation: pulse-ring 2s infinite;
}

@keyframes pulse-ring {
  0% {
    transform: translate(-50%, -50%) scale(0.8);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -50%) scale(1.5);
    opacity: 0;
  }
}

/* ===== INFO PANEL ===== */
.info-panel {
  display: flex;
  flex-direction: column;
  gap: 25px;
}

/* ===== PLAYER SHOWCASE ===== */
.player-showcase {
  background: var(--card-bg);
  backdrop-filter: blur(20px);
  border-radius: 24px;
  padding: 30px;
  border: 1px solid var(--card-border);
  box-shadow: var(--shadow-lg);
}

.showcase-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  margin-bottom: 25px;
}

.header-decoration {
  flex-grow: 1;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--accent-color), transparent);
}

.showcase-title {
  font-size: 1.6rem;
  font-weight: 800;
  color: var(--accent-color);
  text-align: center;
  letter-spacing: 2px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.player-display-area {
  background: rgba(0, 0, 0, 0.3);
  border-radius: 20px;
  padding: 40px;
  min-height: 400px;
  border: 2px dashed rgba(255, 255, 255, 0.1);
  position: relative;
  overflow: hidden;
}

.default-state {
  text-align: center;
  animation: fade-in 0.5s ease;
}

@keyframes fade-in {
  from { opacity: 0; transform: translateY(20px); }
  to { opacity: 1; transform: translateY(0); }
}

.animated-cricket-ball {
  font-size: 5rem;
  color: rgba(255, 255, 255, 0.2);
  margin-bottom: 20px;
  animation: ball-spin 3s linear infinite;
}

@keyframes ball-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.default-title {
  font-size: 1.8rem;
  font-weight: 700;
  margin-bottom: 10px;
  color: var(--text-primary);
}

.default-message {
  font-size: 1.1rem;
  color: var(--text-secondary);
  margin-bottom: 25px;
}

.default-stats {
  display: flex;
  justify-content: center;
  gap: 30px;
  margin-top: 20px;
}

.mini-stat {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 20px;
  background: var(--card-bg);
  border-radius: 10px;
  font-size: 0.95rem;
  color: var(--text-secondary);
}

.mini-stat i {
  color: var(--accent-color);
}

/* ===== SELECTED PLAYER STYLES ===== */
.selected-player {
  animation: player-reveal 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
}

@keyframes player-reveal {
  0% { opacity: 0; transform: scale(0.5) rotate(-10deg); }
