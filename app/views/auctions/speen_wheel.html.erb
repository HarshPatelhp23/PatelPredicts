</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // ===== AUDIO SYSTEM =====
  let audioContext = null;
  let masterVolume = 0.7;
  const volumeSlider = document.getElementById('volumeSlider');
  const volumeLabel = document.getElementById('volumeLabel');
  const volumeTrackFill = document.getElementById('volumeTrackFill');
  const audioStatus = document.getElementById('audioStatus');
  const audioStatusText = document.getElementById('audioStatusText');
  
  function initAudioContext() {
    if (!audioContext) {
      try {
        audioContext = new (window.AudioContext || window.webkitAudioContext)();
        showAudioStatus('🔊 Audio System Active', 2000);
        return true;
      } catch (e) {
        console.error('Web Audio API not supported:', e);
        showAudioStatus('❌ Audio not available', 3000);
        return false;
      }
    }
    return true;
  }
  
  function showAudioStatus(message, duration = 2000) {
    audioStatusText.textContent = message;
    audioStatus.style.display = 'flex';
    audioStatus.style.alignItems = 'center';
    audioStatus.style.gap = '10px';
    setTimeout(() => {
      audioStatus.style.display = 'none';
    }, duration);
  }
  
  function playTickSound() {
    if (!initAudioContext()) return;
    
    try {
      const bufferSize = audioContext.sampleRate * 0.03;
      const buffer = audioContext.createBuffer(1, bufferSize, audioContext.sampleRate);
      const data = buffer.getChannelData(0);
      
      for (let i = 0; i < bufferSize; i++) {
        data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufferSize * 0.1));
      }
      
      const noise = audioContext.createBufferSource();
      const filter = audioContext.createBiquadFilter();
      const gainNode = audioContext.createGain();
      
      noise.buffer = buffer;
      filter.type = 'bandpass';
      filter.frequency.value = 1200;
      filter.Q.value = 2;
      
      noise.connect(filter);
      filter.connect(gainNode);
      gainNode.connect(audioContext.destination);
      
      gainNode.gain.setValueAtTime(masterVolume * 0.4, audioContext.currentTime);
      gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.03);
      
      noise.start(audioContext.currentTime);
      noise.stop(audioContext.currentTime + 0.03);
    } catch (e) {
      console.error('Tick sound error:', e);
    }
  }
  
  function playSpinSound() {
    if (!initAudioContext()) return;
    
    try {
      const bufferSize = audioContext.sampleRate * 1.5;
      const buffer = audioContext.createBuffer(1, bufferSize, audioContext.sampleRate);
      const data = buffer.getChannelData(0);
      
      for (let i = 0; i < bufferSize; i++) {
        data[i] = (Math.random() * 2 - 1) * (1 - i / bufferSize);
      }
      
      const noise = audioContext.createBufferSource();
      const filter = audioContext.createBiquadFilter();
      const gainNode = audioContext.createGain();
      
      noise.buffer = buffer;
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(2000, audioContext.currentTime);
      filter.frequency.exponentialRampToValueAtTime(400, audioContext.currentTime + 1.5);
      
      noise.connect(filter);
      filter.connect(gainNode);
      gainNode.connect(audioContext.destination);
      
      gainNode.gain.setValueAtTime(masterVolume * 0.3, audioContext.currentTime);
      gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 1.5);
      
      noise.start(audioContext.currentTime);
      noise.stop(audioContext.currentTime + 1.5);
      
      showAudioStatus('🎵 Spinning...', 1000);
    } catch (e) {
      console.error('Spin sound error:', e);
    }
  }
  
  function playWinSound() {
    if (!initAudioContext()) return;
    
    try {
      const bassOsc = audioContext.createOscillator();
      const bassGain = audioContext.createGain();
      
      bassOsc.type = 'sine';
      bassOsc.frequency.setValueAtTime(80, audioContext.currentTime);
      bassOsc.frequency.exponentialRampToValueAtTime(20, audioContext.currentTime + 0.4);
      
      bassOsc.connect(bassGain);
      bassGain.connect(audioContext.destination);
      
      bassGain.gain.setValueAtTime(masterVolume * 1.3, audioContext.currentTime);
      bassGain.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.4);
      
      bassOsc.start(audioContext.currentTime);
      bassOsc.stop(audioContext.currentTime + 0.4);
      
      showAudioStatus('💥 BOOM! Player Selected! 💥', 1500);
    } catch (e) {
      console.error('Win sound error:', e);
    }
  }
  
  // Volume control handlers
  volumeSlider.addEventListener('input', function(e) {
    masterVolume = e.target.value / 100;
    volumeLabel.textContent = e.target.value + '%';
    volumeTrackFill.style.width = e.target.value + '%';
    showAudioStatus(`🔊 Volume: ${e.target.value}%`, 1000);
  });
  
  volumeSlider.addEventListener('click', function() {
    playTickSound();
  });
  
  document.body.addEventListener('click', function() {
    initAudioContext();
  }, { once: true });
  
  // ===== PLAYER DATA LOADING =====
  const playerElements = document.querySelectorAll('.player-data');
  let players = Array.from(playerElements).map(el => {
    let stats = null;
    if (el.dataset.stats && el.dataset.stats !== 'null') {
      try {
        stats = JSON.parse(el.dataset.stats);
      } catch(e) {
        console.error('Error parsing stats:', e);
      }
    }
    
    return {
      id: el.dataset.id,
      name: el.dataset.name,
      role: el.dataset.role,
      batting_style: el.dataset.batting_style,
      bowling_style: el.dataset.bowling_style,
      team_name: el.dataset.team_name,
      team_logo: el.dataset.team_logo,
      image: el.dataset.image,
      stats: stats,
      selected: false
    };
  });

  let remainingPlayers = players.filter(p => !p.selected);
  let selectedPlayers = [];
  let isSpinning = false;
  let currentRotation = 0;
  let segmentAngles = [];
  
  updateCounts();
  
  // ===== CANVAS SETUP =====
  const canvas = document.getElementById('wheelCanvas');
  const ctx = canvas.getContext('2d');
  const centerX = canvas.width / 2;
  const centerY = canvas.height / 2;
  const radius = Math.min(centerX, centerY) - 50;
  
  const POINTER_ANGLE = 0;
  
  drawWheel();
  
  // ===== EVENT LISTENERS =====
  const spinBtn = document.getElementById('spinBtn');
  const resetBtn = document.getElementById('resetWheelBtn');
  const selectedPlayerDisplay = document.getElementById('selectedPlayerDisplay');
  const recentPlayersList = document.getElementById('recentPlayers');
  
  spinBtn.addEventListener('click', spinWheel);
  resetBtn.addEventListener('click', resetWheel);
  
  // Canvas click for center circle
  canvas.addEventListener('click', function(event) {
    const rect = canvas.getBoundingClientRect();
    const scaleX = canvas.width / rect.width;
    const scaleY = canvas.height / rect.height;
    const x = (event.clientX - rect.left) * scaleX;
    const y = (event.clientY - rect.top) * scaleY;
    
    const dx = x - centerX;
    const dy = y - centerY;
    const distance = Math.sqrt(dx * dx + dy * dy);
    
    if (distance <= 40) {
      spinWheel();
    }
  });
  
  // Canvas hover effect
  canvas.addEventListener('mousemove', function(event) {
    const rect = canvas.getBoundingClientRect();
    const scaleX = canvas.width / rect.width;
    const scaleY = canvas.height / rect.height;
    const x = (event.clientX - rect.left) * scaleX;
    const y = (event.clientY - rect.top) * scaleY;
    
    const dx = x - centerX;
    const dy = y - centerY;
    const distance = Math.sqrt(dx * dx + dy * dy);
    
    if (distance <= 40) {
      canvas.style.cursor = isSpinning || remainingPlayers.length === 0 ? 'not-allowed' : 'pointer';
    } else {
      canvas.style.cursor = 'default';
    }
  });
  
  // ===== WHEEL DRAWING =====
  function drawWheel(rotation = 0) {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    const availablePlayers = remainingPlayers;
    const total = availablePlayers.length;
    
    if (total === 0) {
      drawEmptyWheel();
      segmentAngles = [];
      return;
    }
    
    const anglePerSegment = (2 * Math.PI) / total;
    segmentAngles = [];
    
    ctx.save();
    ctx.translate(centerX, centerY);
    ctx.rotate(rotation);
    ctx.translate(-centerX, -centerY);
    
    for (let i = 0; i < total; i++) {
      const startAngle = i * anglePerSegment;
      const endAngle = startAngle + anglePerSegment;
      const middleAngle = startAngle + anglePerSegment / 2;
      
      segmentAngles.push({
        player: availablePlayers[i],
        startAngle: (startAngle + rotation) % (2 * Math.PI),
        endAngle: (endAngle + rotation) % (2 * Math.PI),
        middleAngle: (middleAngle + rotation) % (2 * Math.PI),
        index: i
      });
      
      // Enhanced gradient colors
      const hue = (i * 360 / total) % 360;
      const gradient = ctx.createRadialGradient(centerX, centerY, 0, centerX, centerY, radius);
      
      if (i % 2 === 0) {
        gradient.addColorStop(0, `hsla(${hue}, 80%, 65%, 1)`);
        gradient.addColorStop(1, `hsla(${hue}, 80%, 50%, 1)`);
      } else {
        gradient.addColorStop(0, `hsla(${hue}, 85%, 60%, 1)`);
        gradient.addColorStop(1, `hsla(${hue}, 85%, 45%, 1)`);
      }
      
      ctx.beginPath();
      ctx.moveTo(centerX, centerY);
      ctx.arc(centerX, centerY, radius, startAngle, endAngle);
      ctx.closePath();
      ctx.fillStyle = gradient;
      ctx.fill();
      ctx.strokeStyle = 'rgba(255, 255, 255, 0.3)';
      ctx.lineWidth = 3;
      ctx.stroke();
      
      // Player name
      ctx.save();
      ctx.translate(centerX, centerY);
      ctx.rotate(startAngle + anglePerSegment / 2);
      
      const player = availablePlayers[i];
      let displayName = player.name;
      const maxChars = 15;
      if (displayName.length > maxChars) {
        displayName = displayName.substring(0, maxChars) + '...';
      }
      
      ctx.fillStyle = 'white';
      ctx.font = 'bold 16px Inter, sans-serif';
      ctx.textAlign = 'right';
      ctx.shadowColor = 'rgba(0, 0, 0, 0.5)';
      ctx.shadowBlur = 4;
      ctx.fillText(displayName, radius - 25, 6);
      ctx.shadowBlur = 0;
      ctx.restore();
    }
    
    drawCenterCircle();
    ctx.restore();
  }
  
  function drawEmptyWheel() {
    ctx.beginPath();
    ctx.arc(centerX, centerY, radius, 0, 2 * Math.PI);
    const gradient = ctx.createRadialGradient(centerX, centerY, 0, centerX, centerY, radius);
    gradient.addColorStop(0, 'rgba(102, 126, 234, 0.2)');
    gradient.addColorStop(1, 'rgba(118, 75, 162, 0.2)');
    ctx.fillStyle = gradient;
    ctx.fill();
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
    ctx.lineWidth = 3;
    ctx.stroke();
    
    ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';
    ctx.font = 'bold 28px Inter, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('All Players Selected!', centerX, centerY);
  }
  
  function drawCenterCircle() {
    ctx.beginPath();
    ctx.arc(centerX, centerY, 45, 0, 2 * Math.PI);
    const gradient = ctx.createRadialGradient(centerX, centerY, 0, centerX, centerY, 45);
    gradient.addColorStop(0, '#FFD700');
    gradient.addColorStop(0.5, '#FFA500');
    gradient.addColorStop(1, '#FF8C00');
    ctx.fillStyle = gradient;
    ctx.fill();
    ctx.strokeStyle = 'white';
    ctx.lineWidth = 4;
    ctx.stroke();
    
    ctx.shadowColor = 'rgba(255, 215, 0, 0.5)';
    ctx.shadowBlur = 15;
    ctx.shadowOffsetX = 0;
    ctx.shadowOffsetY = 3;
    
    ctx.fillStyle = 'white';
    ctx.font = 'bold 20px Inter, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('SPIN', centerX, centerY);
    
    ctx.shadowColor = 'transparent';
    ctx.shadowBlur = 0;
  }
  
  // ===== SPIN WHEEL FUNCTION =====
  function spinWheel() {
    if (isSpinning || remainingPlayers.length === 0) return;
    
    isSpinning = true;
    spinBtn.disabled = true;
    canvas.classList.add('disabled');
    
    playSpinSound();
    
    const fullRotations = 5 + Math.floor(Math.random() * 5);
    const extraRotation = Math.random() * 2 * Math.PI;
    const totalRotation = fullRotations * 2 * Math.PI + extraRotation;
    
    const spinDuration = 5000;
    let startTime = null;
    const startRotation = currentRotation;
    
    let lastTickTime = 0;
    const tickInterval = 100;
    
    function animate(time) {
      if (!startTime) startTime = time;
      const elapsed = time - startTime;
      const progress = Math.min(elapsed / spinDuration, 1);
      
      const easeOut = 1 - Math.pow(1 - progress, 3);
      currentRotation = startRotation + easeOut * totalRotation;
      
      drawWheel(currentRotation);
      
      if (time - lastTickTime > tickInterval && progress < 0.85 && progress > 0.1) {
        playTickSound();
        lastTickTime = time;
      }
      
      if (progress < 1) {
        requestAnimationFrame(animate);
      } else {
        setTimeout(() => {
          detectPlayerAtPointer();
        }, 500);
      }
    }
    
    requestAnimationFrame(animate);
  }
  
  // ===== DETECT SELECTED PLAYER =====
  function detectPlayerAtPointer() {
    if (segmentAngles.length === 0) {
      isSpinning = false;
      canvas.classList.remove('disabled');
      return;
    }
    
    let normalizedRotation = currentRotation % (2 * Math.PI);
    if (normalizedRotation < 0) normalizedRotation += 2 * Math.PI;
    
    let selectedPlayer = null;
    
    for (let i = 0; i < segmentAngles.length; i++) {
      const segment = segmentAngles[i];
      let segmentStart = segment.startAngle;
      let segmentEnd = segment.endAngle;
      
      if (segmentStart > segmentEnd) {
        if (POINTER_ANGLE >= segmentStart || POINTER_ANGLE <= segmentEnd) {
          selectedPlayer = segment.player;
          break;
        }
      } else {
        if (POINTER_ANGLE >= segmentStart && POINTER_ANGLE <= segmentEnd) {
          selectedPlayer = segment.player;
          break;
        }
      }
    }
    
    if (!selectedPlayer) {
      let closestDistance = Infinity;
      let closestSegment = null;
      
      for (let segment of segmentAngles) {
        let distance = Math.abs(segment.middleAngle - POINTER_ANGLE);
        if (distance > Math.PI) distance = 2 * Math.PI - distance;
        
        if (distance < closestDistance) {
          closestDistance = distance;
          closestSegment = segment;
        }
      }
      
      if (closestSegment) {
        selectedPlayer = closestSegment.player;
      }
    }
    
    if (selectedPlayer) {
      playWinSound();
      
      displaySelectedPlayer(selectedPlayer);
      addToRecentSelections(selectedPlayer);
      triggerConfetti();
      
      setTimeout(() => {
        autoRemoveSelectedPlayer(selectedPlayer);
      }, 2000);
    }
    
    isSpinning = false;
    spinBtn.disabled = remainingPlayers.length === 0;
    canvas.classList.remove('disabled');
  }
  
  // ===== AUTO REMOVE SELECTED PLAYER =====
  function autoRemoveSelectedPlayer(player) {
    const playerIndex = players.findIndex(p => p.id === player.id);
    
    if (playerIndex !== -1) {
      players[playerIndex].selected = true;
      remainingPlayers = players.filter(p => !p.selected);
      
      updateCounts();
      drawWheel(currentRotation);
      
      spinBtn.disabled = remainingPlayers.length === 0;
      
      showSuccessToast(`${player.name} removed from wheel!`);
    }
  }
  
  // ===== DISPLAY SELECTED PLAYER =====
  function displaySelectedPlayer(player) {
    const statsHTML = player.stats ? generateStatsHTML(player.stats) : '<div class="no-stats-message"><i class="fas fa-info-circle"></i> No T20 statistics available for this player</div>';
    
    selectedPlayerDisplay.innerHTML = `
      <div class="selected-player">
        <img src="${player.image}" alt="${player.name}" class="player-image" 
             onerror="this.onerror=null; this.src='/assets/default_player_image.jpeg'">
        <h2 class="player-name">${player.name}</h2>
        <p class="player-id">Player ID: ${player.id}</p>
        <div class="team-display">
          ${player.team_logo ? `
            <img src="${player.team_logo}" alt="${player.team_name || 'No Team'}" class="team-logo"
                 onerror="this.onerror=null; this.src='/assets/default_player_image.png'">
          ` : ''}
          <div class="team-info">
            <p class="team-name">${player.team_name || 'No Team'}</p>
            <p><i class="fas fa-user-tag"></i> ${player.role}</p>
            <p><i class="fas fa-baseball-ball"></i> ${player.batting_style}</p>
            <p><i class="fas fa-bowling-ball"></i> ${player.bowling_style}</p>
          </div>
        </div>
        ${statsHTML}
      </div>
    `;
  }

  // ===== GENERATE STATS HTML =====
  function generateStatsHTML(stats) {
