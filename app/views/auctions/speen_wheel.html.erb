          ` : ''}
        </div>
      </div>
    `;
  }

  // ===== ADD TO RECENT SELECTIONS =====
  function addToRecentSelections(player) {
    const now = new Date();
    const timeString = now.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
    
    // Remove empty timeline message if exists
    const emptyTimeline = recentPlayersList.querySelector('.empty-timeline');
    if (emptyTimeline) {
      emptyTimeline.remove();
    }
    
    const recentItem = document.createElement('div');
    recentItem.className = 'recent-item';
    recentItem.innerHTML = `
      <img src="${player.image}" alt="${player.name}" 
           onerror="this.onerror=null; this.src='/assets/default_player_image.jpeg'">
      <span class="recent-name">${player.name}</span>
      ${player.team_logo ? `
        <img src="${player.team_logo}" alt="${player.team_name || 'No Team'}" class="recent-team-logo"
             onerror="this.onerror=null; this.src='/assets/default_team_logo.png'">
      ` : '<span class="recent-team-logo-placeholder"></span>'}
      <span class="recent-time">${timeString}</span>
    `;
    
    recentPlayersList.insertBefore(recentItem, recentPlayersList.firstChild);
    
    if (recentPlayersList.children.length > 10) {
      recentPlayersList.removeChild(recentPlayersList.lastChild);
    }
    
    updateHistoryCount();
  }
  
  // ===== RESET WHEEL =====
  function resetWheel() {
    if (confirm("🔄 Reset the wheel? All players will be available again!")) {
      players.forEach(p => p.selected = false);
      remainingPlayers = [...players];
      currentRotation = 0;
      
      updateCounts();
      drawWheel();
      
      selectedPlayerDisplay.innerHTML = `
        <div class="default-state">
          <div class="animated-cricket-ball">
            <i class="fas fa-baseball-ball"></i>
          </div>
          <h3 class="default-title">Ready to Spin?</h3>
          <p class="default-message">Click the spin button to select your next cricket star!</p>
          <div class="default-stats">
            <div class="mini-stat">
              <i class="fas fa-fire"></i>
              <span>Exciting Players</span>
            </div>
            <div class="mini-stat">
              <i class="fas fa-bolt"></i>
              <span>Random Selection</span>
            </div>
          </div>
        </div>
      `;
      
      recentPlayersList.innerHTML = `
        <div class="empty-timeline">
          <i class="fas fa-clipboard-list"></i>
          <p>No selections yet</p>
        </div>
      `;
      
      spinBtn.disabled = false;
      updateHistoryCount();
      
      showSuccessToast("✨ Wheel has been reset successfully!");
    }
  }
  
  // ===== UPDATE COUNTS =====
  function updateCounts() {
    document.getElementById('totalPlayers').textContent = players.length;
    document.getElementById('remainingPlayers').textContent = remainingPlayers.length;
    document.getElementById('selectedCount').textContent = players.length - remainingPlayers.length;
  }
  
  // ===== UPDATE HISTORY COUNT =====
  function updateHistoryCount() {
    const count = recentPlayersList.querySelectorAll('.recent-item').length;
    document.getElementById('historyCount').textContent = count;
  }
  
  // ===== CONFETTI EFFECT =====
  function triggerConfetti() {
    if (typeof confetti === 'function') {
      const duration = 3000;
      const animationEnd = Date.now() + duration;
      const defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 0 };

      function randomInRange(min, max) {
        return Math.random() * (max - min) + min;
      }

      const interval = setInterval(function() {
        const timeLeft = animationEnd - Date.now();

        if (timeLeft <= 0) {
          return clearInterval(interval);
        }

        const particleCount = 50 * (timeLeft / duration);
        
        confetti(Object.assign({}, defaults, {
          particleCount,
          origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 }
        }));
        confetti(Object.assign({}, defaults, {
          particleCount,
          origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 }
        }));
      }, 250);
    }
  }
  
  // ===== SUCCESS TOAST =====
  function showSuccessToast(message) {
    const toast = document.getElementById('successToast');
    const toastMessage = document.getElementById('toastMessage');
    
    toastMessage.textContent = message;
    toast.style.display = 'flex';
    toast.style.alignItems = 'center';
    toast.style.gap = '12px';
    
    setTimeout(() => {
      toast.style.animation = 'toast-slide-out 0.3s ease';
      setTimeout(() => {
        toast.style.display = 'none';
        toast.style.animation = 'toast-slide-in 0.3s ease';
      }, 300);
    }, 3000);
  }
});
</script>
