<%# app/views/auctions/auctions_table.html.erb %>
<% provide(:title, "Auction Room") if respond_to?(:provide) %>

<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<div class="at-shell" id="at-shell">

  <!-- ══ TOP BAR ══ -->
  <div class="at-topbar">
    <div class="at-topbar-left">
      <%= link_to spl_dashboard_path, class: "at-back-btn" do %>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15,18 9,12 15,6"/></svg>
      <% end %>
      <div class="at-brand">
        <div class="at-brand-icon">🏏</div>
        <div>
          <div class="at-brand-name">Auction Room</div>
          <div class="at-brand-sub">SPL · Live Standings</div>
        </div>
      </div>
    </div>
    <div class="at-topbar-right">
      <%= link_to auction_list_path, class: "at-nav-btn blue-btn" do %>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        <span>Lineup</span>
      <% end %>
      <%= link_to hotpicks_path, class: "at-nav-btn red-btn" do %>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2c0 0-4 5-4 9a4 4 0 0 0 8 0c0-4-4-9-4-9z"/><path d="M12 22v-4"/></svg>
        <span>Hotpicks</span>
      <% end %>
    </div>
  </div>

  <!-- ══ LIVE RANKINGS STRIP ══ -->
  <div class="at-rankings-section">
    <div class="at-section-hdr">
      <div class="at-live-badge">
        <span class="at-live-dot"></span>LIVE
      </div>
      <div class="at-section-title">Team Rankings</div>
      <div class="at-section-line"></div>
    </div>

    <div class="at-rankings-scroll">
      <%# data-user-id on each rank card lets JS reorder & update them live %>
      <div class="at-rankings-grid" id="at-rankings-grid">
        <% @users.each_with_index do |user, index| %>
          <% tag = user.username.split.first %>
          <% chance = TeamSkillEvaluator.calculate_winning_chances(user).to_f %>
          <% rank_classes = ["gold-rank","silver-rank","bronze-rank","green-rank"] %>
          <% rank_class = rank_classes[index] || "" %>

          <div class="at-rank-card <%= rank_class %>"
               data-user-id="<%= user.id %>"
               data-rank="<%= index + 1 %>"
               onclick="scrollToTeam(<%= user.id %>)">

            <div class="at-rank-num" data-rank-label>#<%= index + 1 %></div>

            <div class="at-rank-ring">
              <svg viewBox="0 0 36 36" class="at-ring-svg">
                <path class="at-ring-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
                <path class="at-ring-fill"
                      data-ring-fill
                      stroke-dasharray="<%= chance %>, 100"
                      d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"/>
              </svg>
              <div class="at-ring-inner">
                <div class="at-ring-pct">
                  <span data-win-pct><%= chance.round(0) %></span><span>%</span>
                </div>
              </div>
            </div>

            <div class="at-rank-tag"><%= spl_team_name(user.username) %></div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- ══ DESKTOP LAYOUT WRAPPER ══ -->
  <div class="at-main-body">

    <!-- Desktop sidebar: team navigator -->
    <div class="at-sidebar" id="at-sidebar">
      <div class="at-sidebar-hdr">Teams</div>
      <% @users.each_with_index do |user, index| %>
        <% tag = user.username.split.first %>
        <% chance = TeamSkillEvaluator.calculate_winning_chances(user).to_f %>
        <div class="at-sidebar-item"
             onclick="scrollToTeam(<%= user.id %>)"
             id="nav-<%= user.id %>"
             data-user-id="<%= user.id %>">
          <div class="at-sidebar-rank" data-sidebar-rank>#<%= index + 1 %></div>
          <div class="at-sidebar-av"><%= tag.first(2).upcase %></div>
          <div class="at-sidebar-info">
            <div class="at-sidebar-name"><%= spl_team_name(user.username) %></div>
            <div class="at-sidebar-pct" data-sidebar-pct><%= chance.round(1) %>% win</div>
          </div>
          <div class="at-sidebar-bar-wrap">
            <div class="at-sidebar-bar" data-sidebar-bar style="width:<%= chance %>%"></div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- ══ TEAM CARDS ══ -->
    <div class="at-teams-feed" id="at-teams-feed">
      <% @users.each_with_index do |user, index| %>
        <% tag = user.username.split.first %>
        <% chance = TeamSkillEvaluator.calculate_winning_chances(user).to_f %>
        <% batting_str = TeamSkillEvaluator.calculate_strength(user, 'batting') %>
        <% bowling_str = TeamSkillEvaluator.calculate_strength(user, 'bowling') %>
        <% rank_labels = ["🥇 1st Place","🥈 2nd Place","🥉 3rd Place","4th Place"] %>
        <% rank_colors = ["gold-team","silver-team","bronze-team","green-team"] %>

        <div class="at-team-card <%= rank_colors[index] || "" %>"
             id="team-<%= user.id %>"
             data-user-id="<%= user.id %>">

          <!-- Card Header -->
          <div class="at-card-header">
            <div class="at-card-header-bg"></div>
            <div class="at-card-header-content">
              <div class="at-card-avatar-wrap">
                <!-- <#%= image_tag "default_player_image.jpeg", class: "at-card-avatar", alt: tag %> -->
                <%= spl_team_logo(user.username)%>
                <div class="at-card-rank-crown" data-rank-crown><%= rank_labels[index] || "##{index+1}" %></div>
              </div>
              <div class="at-card-meta">
                <div class="at-card-team-name"><%= spl_team_name(user.username) %></div>
                <div class="at-card-username">👑:- <%= user.username %></div>
                <div class="at-card-win-pct">
                  <%# data-win-pct-num → updated live by JS %>
                  <span class="at-win-pct-num" data-win-pct-num><%= chance.round(1) %>%</span>
                  <span class="at-win-pct-lbl">Win Probability</span>
                </div>
              </div>
              <div class="at-card-stats-grid">
                <div class="at-card-stat">
                  <div class="at-stat-icon">💰</div>
                  <div class="at-stat-val"><%= CurrencyFormatter.format(user.total_purse) %></div>
                  <div class="at-stat-lbl">Total Purse</div>
                </div>
                <div class="at-card-stat">
                  <div class="at-stat-icon">💎</div>
                  <%# data-remaining-purse → updated live by JS %>
                  <div class="at-stat-val" data-remaining-purse><%= CurrencyFormatter.format(user.remaining_purse) %></div>
                  <div class="at-stat-lbl">Remaining</div>
                </div>
                <div class="at-card-stat highlight-stat">
                  <div class="at-stat-icon">🏆</div>
                  <%# data-win-chance → updated live by JS %>
                  <div class="at-stat-val" data-win-chance><%= chance.round(1) %>%</div>
                  <div class="at-stat-lbl">Win Chance</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Skill Bars -->
          <div class="at-skills-section">
            <div class="at-skill-row">
              <div class="at-skill-label">
                <span class="at-skill-icon bat-icon">🏏</span>
                Batting
              </div>
              <div class="at-skill-track">
                <%# data-bat-bar → width & text updated live by JS %>
                <div class="at-skill-bar bat-bar" data-bat-bar style="width:<%= batting_str %>%">
                  <span data-bat-bar-label><%= batting_str %>%</span>
                </div>
              </div>
            </div>
            <div class="at-skill-row">
              <div class="at-skill-label">
                <span class="at-skill-icon bowl-icon">🎯</span>
                Bowling
              </div>
              <div class="at-skill-track">
                <%# data-bowl-bar → width & text updated live by JS %>
                <div class="at-skill-bar bowl-bar" data-bowl-bar style="width:<%= bowling_str %>%">
                  <span data-bowl-bar-label><%= bowling_str %>%</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Players Squad -->
          <div class="at-squad-section">
            <div class="at-squad-hdr">
              <div class="at-squad-title">Team Squad</div>
              <% squad_count = @auction_rooms.count { |p| p.user == user } %>
              <%# data-squad-count → incremented live by JS when a player is added %>
              <div class="at-squad-count" data-squad-count><%= squad_count %> Players</div>
            </div>

            <%# data-players-grid is the insertion point for new player cards via JS %>
            <div class="at-players-grid" data-players-grid>
              <% @auction_rooms.each do |player| %>
                <% next if player.user != user %>
                <% buy_suggestion_image = TeamSkillEvaluator.categorize_buy(
                     player.auction_player.base_price,
                     player.auction_player.total_skill,
                     player.current_integer_amount
                   ).presence || 'worst_buy' %>
                <% insight = player.is_a_captain? ? 'captain' : buy_suggestion_image %>
                <% bat_pct = player.auction_player.batting %>
                <% bowl_pct = player.auction_player.bowling %>

                <%# data-player on each card lets JS check for duplicates before inserting %>
                <div class="at-player-card" data-player="<%= player.player_name %>">
                  <!-- Insight strip -->
                  <div class="at-player-insight">
                    <%= image_tag "#{insight}.jpeg", class: "at-insight-img", alt: insight %>
                  </div>

                  <!-- Avatar -->
                  <div class="at-player-av-wrap">
                    <%= image_tag "default_player_image.jpeg", class: "at-player-av", alt: player.player_name %>
                    <% if player.is_a_captain? %>
                      <div class="at-captain-badge">👑</div>
                    <% end %>
                  </div>

                  <!-- Info -->
                  <div class="at-player-info">
                    <div class="at-player-name"><%= player.player_name %></div>
                    <div class="at-player-price">
                      <% if player.is_a_captain? %>
                        <span class="at-captain-pill">Captain</span>
                      <% else %>
                        <%= "₹#{player.amount}#{player.amount_unit == 'crores' ? 'CR' : 'L'}" %>
                      <% end %>
                    </div>
                  </div>

                  <!-- Mini skill bars -->
                  <div class="at-player-skills">
                    <div class="at-mini-skill">
                      <div class="at-mini-track">
                        <div class="at-mini-bar bat-mini" style="width:<%= bat_pct %>%"></div>
                      </div>
                      <div class="at-mini-label">Bat <%= bat_pct %>%</div>
                    </div>
                    <div class="at-mini-skill">
                      <div class="at-mini-track">
                        <div class="at-mini-bar bowl-mini" style="width:<%= bowl_pct %>%"></div>
                      </div>
                      <div class="at-mini-label">Bowl <%= bowl_pct %>%</div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div><!-- /at-main-body -->

  <!-- Notifications -->
  <div id="at-notifications" class="at-notifications"></div>
</div>

<!-- ══════════════════════════════════
     STYLES
══════════════════════════════════ -->
<style>
/* ── TOKENS ── */
:root {
  --bg:     #0f172a;
  --bg2:    #1e293b;
  --bg3:    #243044;
  --bg4:    #2d3f5a;
  --surface: #1e293b;
  --surface2: #243044;
  --gold:   #f59e0b;
  --gold2:  #fbbf24;
  --gold-d: #d97706;
  --gold-dim: rgba(245,158,11,0.15);
  --green:  #10b981;
  --green2: #34d399;
  --green-dim: rgba(16,185,129,0.12);
  --red:    #ef4444;
  --red-dim: rgba(239,68,68,0.12);
  --blue:   #3b82f6;
  --blue-dim: rgba(59,130,246,0.12);
  --text:   #f1f5f9;
  --text2:  #94a3b8;
  --text3:  #64748b;
  --border: rgba(255,255,255,0.07);
  --border2: rgba(255,255,255,0.12);
  --gold-border: rgba(245,158,11,0.3);
  --r:      16px;
  --r-sm:   10px;
  --fd: 'Rajdhani', sans-serif;
  --fb: 'Nunito', sans-serif;
  --top-h: 60px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

body { background: var(--bg); color: var(--text); font-family: var(--fb); }

/* ── SHELL ── */
.at-shell {
  min-height: 100dvh;
  background: var(--bg);
  padding-bottom: 40px;
}

/* ══ TOP BAR ══ */
.at-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  height: var(--top-h);
  background: rgba(15,23,42,0.95);
  border-bottom: 1px solid var(--border2);
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(16px);
  gap: 12px;
}

.at-topbar-left { display: flex; align-items: center; gap: 12px; flex: 1; min-width: 0; }

.at-back-btn {
  width: 36px; height: 36px; border-radius: 50%;
  background: var(--surface);
  border: 1px solid var(--border2);
  display: flex; align-items: center; justify-content: center;
  color: var(--text2);
  text-decoration: none;
  flex-shrink: 0;
  transition: all 0.15s;
}
.at-back-btn:hover { background: var(--bg3); color: var(--text); }

.at-brand { display: flex; align-items: center; gap: 10px; min-width: 0; }
.at-brand-icon { font-size: 22px; flex-shrink: 0; }
.at-brand-name {
  font-family: var(--fd);
  font-size: 18px; font-weight: 700;
  color: var(--gold);
  letter-spacing: 0.5px;
  white-space: nowrap;
}
.at-brand-sub { font-size: 10px; color: var(--text3); letter-spacing: 1px; text-transform: uppercase; }

.at-topbar-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

.at-nav-btn {
  display: flex; align-items: center; gap: 6px;
  padding: 7px 13px;
  border-radius: 8px;
  font-family: var(--fb);
  font-size: 12px; font-weight: 700;
  text-decoration: none;
  transition: all 0.15s;
  letter-spacing: 0.3px;
  border: 1px solid transparent;
  white-space: nowrap;
}
.at-nav-btn.blue-btn {
  background: var(--blue-dim);
  border-color: rgba(59,130,246,0.25);
  color: #93c5fd;
}
.at-nav-btn.blue-btn:hover { background: rgba(59,130,246,0.2); border-color: var(--blue); color: #fff; }
.at-nav-btn.red-btn {
  background: var(--red-dim);
  border-color: rgba(239,68,68,0.25);
  color: #fca5a5;
}
.at-nav-btn.red-btn:hover { background: rgba(239,68,68,0.2); border-color: var(--red); color: #fff; }

@media (max-width: 480px) {
  .at-nav-btn span { display: none; }
  .at-nav-btn { padding: 8px; border-radius: 8px; }
  .at-brand-sub { display: none; }
}

/* ══ RANKINGS SECTION ══ */
.at-rankings-section {
  padding: 20px 16px 16px;
  background: linear-gradient(180deg, rgba(15,23,42,0.8) 0%, transparent 100%);
}

.at-section-hdr {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}
.at-live-badge {
  display: flex; align-items: center; gap: 5px;
  background: rgba(239,68,68,0.12);
  border: 1px solid rgba(239,68,68,0.3);
  border-radius: 20px;
  padding: 4px 10px;
  font-family: var(--fd);
  font-size: 11px; font-weight: 700;
  color: var(--red);
  letter-spacing: 1.5px;
  flex-shrink: 0;
}
.at-live-dot {
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--red);
  animation: at-pulse 1.2s infinite;
}
@keyframes at-pulse { 0%,100%{opacity:1;} 50%{opacity:0.3;} }

.at-section-title {
  font-family: var(--fd);
  font-size: 16px; font-weight: 700;
  color: var(--text);
  letter-spacing: 0.3px;
}
.at-section-line { flex: 1; height: 1px; background: var(--border2); }

.at-rankings-scroll { overflow-x: auto; scrollbar-width: none; }
.at-rankings-scroll::-webkit-scrollbar { display: none; }

.at-rankings-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 12px;
  min-width: 0;
}

@media (max-width: 600px) {
  .at-rankings-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Rank card */
.at-rank-card {
  background: var(--surface);
  border: 1px solid var(--border2);
  border-radius: 14px;
  padding: 16px 12px 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
}
.at-rank-card::before {
  content: '';
  position: absolute; inset: 0;
  background: radial-gradient(circle at 50% 0%, rgba(255,255,255,0.04), transparent 70%);
  pointer-events: none;
}
.at-rank-card:hover {
  transform: translateY(-4px);
  border-color: var(--border2);
  box-shadow: 0 12px 28px rgba(0,0,0,0.3);
}
.at-rank-card:active { transform: scale(0.98); }

.at-rank-card.gold-rank   { border-color: rgba(245,158,11,0.4); background: linear-gradient(145deg, rgba(245,158,11,0.1), rgba(30,41,59,1)); }
.at-rank-card.silver-rank { border-color: rgba(148,163,184,0.4); background: linear-gradient(145deg, rgba(148,163,184,0.1), rgba(30,41,59,1)); }
.at-rank-card.bronze-rank { border-color: rgba(205,127,50,0.4);  background: linear-gradient(145deg, rgba(205,127,50,0.1),  rgba(30,41,59,1)); }
.at-rank-card.green-rank  { border-color: rgba(16,185,129,0.4);  background: linear-gradient(145deg, rgba(16,185,129,0.1),  rgba(30,41,59,1)); }

.at-rank-num {
  font-family: var(--fd);
  font-size: 11px; font-weight: 700;
  color: var(--text3);
  letter-spacing: 1px;
  text-transform: uppercase;
}
.gold-rank   .at-rank-num { color: var(--gold2); }
.silver-rank .at-rank-num { color: #cbd5e1; }
.bronze-rank .at-rank-num { color: #cd7f32; }
.green-rank  .at-rank-num { color: var(--green2); }

/* Ring */
.at-rank-ring {
  position: relative;
  width: 72px; height: 72px;
  flex-shrink: 0;
}
.at-ring-svg { width: 100%; height: 100%; transform: rotate(-90deg); }
.at-ring-bg  { fill: none; stroke: rgba(255,255,255,0.06); stroke-width: 3; }
.at-ring-fill {
  fill: none; stroke-width: 3; stroke-linecap: round;
  animation: at-ring-grow 1s ease-out both;
  stroke: var(--green);
}
@keyframes at-ring-grow { from { stroke-dasharray: 0,100; } }
.gold-rank   .at-ring-fill { stroke: var(--gold2); }
.silver-rank .at-ring-fill { stroke: #94a3b8; }
.bronze-rank .at-ring-fill { stroke: #cd7f32; }
.green-rank  .at-ring-fill { stroke: var(--green2); }

.at-ring-inner {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
}
.at-ring-pct {
  font-family: var(--fd);
  font-size: 16px; font-weight: 700;
  color: var(--text);
  line-height: 1;
}
.at-ring-pct span { font-size: 10px; color: var(--text3); }

.at-rank-tag {
  font-family: var(--fd);
  font-size: 13px; font-weight: 700;
  color: var(--text);
  letter-spacing: 1px;
  text-transform: uppercase;
  text-align: center;
}

/* ══ MAIN BODY (desktop splits into sidebar + feed) ══ */
.at-main-body {
  display: flex;
  gap: 0;
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 16px;
  align-items: flex-start;
}

/* ── SIDEBAR ── (desktop only) */
.at-sidebar {
  display: none; /* hidden on mobile */
}

@media (min-width: 1024px) {
  .at-main-body { padding: 0 24px; gap: 24px; }

  .at-sidebar {
    display: flex;
    flex-direction: column;
    width: 220px;
    flex-shrink: 0;
    background: var(--surface);
    border: 1px solid var(--border2);
    border-radius: var(--r);
    overflow: hidden;
    position: sticky;
    top: calc(var(--top-h) + 16px);
    max-height: calc(100dvh - var(--top-h) - 32px);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.06) transparent;
  }

  .at-sidebar-hdr {
    font-family: var(--fd);
    font-size: 11px; font-weight: 700;
    color: var(--text3);
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 14px 14px 8px;
    border-bottom: 1px solid var(--border);
  }

  .at-sidebar-item {
    padding: 11px 14px;
    cursor: pointer;
    transition: background 0.15s;
    border-bottom: 1px solid var(--border);
    display: grid;
    grid-template-columns: 22px 32px 1fr;
    grid-template-rows: auto auto;
    gap: 0 8px;
    align-items: center;
  }
  .at-sidebar-item:last-child { border-bottom: none; }
  .at-sidebar-item:hover { background: rgba(255,255,255,0.03); }
  .at-sidebar-item.active { background: var(--gold-dim); border-left: 2px solid var(--gold); }

  .at-sidebar-rank {
    font-family: var(--fd);
    font-size: 11px; font-weight: 700;
    color: var(--text3);
    grid-row: 1 / 3;
  }
  .at-sidebar-av {
    width: 32px; height: 32px; border-radius: 50%;
    background: var(--bg3);
    display: flex; align-items: center; justify-content: center;
