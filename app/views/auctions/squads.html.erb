<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= @auction.name %></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
            min-height: 100vh;
            padding: 20px;
            color: white;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* Header Section */
        .page-header {
            text-align: center;
            margin-bottom: 40px;
            animation: fadeInDown 0.8s ease-out;
        }

        .page-header h1 {
            font-size: 3rem;
            background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 50%, #fbbf24 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-bottom: 10px;
            text-shadow: 0 0 30px rgba(251, 191, 36, 0.3);
        }

        .page-header p {
            color: rgba(255, 255, 255, 0.7);
            font-size: 1.1rem;
        }

        /* Filter Section */
        .filter-section {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 20px;
            margin-bottom: 40px;
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
        }

        .filter-item {
            flex: 1;
            min-width: 200px;
            max-width: 300px;
        }

        .filter-item label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            color: #fbbf24;
        }

        .filter-item select {
            width: 100%;
            padding: 12px 15px;
            border-radius: 12px;
            border: 2px solid rgba(251, 191, 36, 0.3);
            background: rgba(255, 255, 255, 0.1);
            color: white;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .filter-item select:focus {
            outline: none;
            border-color: #fbbf24;
            background: rgba(255, 255, 255, 0.15);
        }

        .filter-item select option {
            background: #1e293b;
            color: white;
        }

        /* Teams Grid */
        .teams-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 30px;
            margin-bottom: 40px;
        }

        .team-card {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
            backdrop-filter: blur(20px);
            border: 2px solid rgba(251, 191, 36, 0.3);
            border-radius: 24px;
            padding: 25px;
            transition: all 0.4s ease;
            animation: fadeInUp 0.6s ease-out backwards;
            position: relative;
            overflow: hidden;
        }

        .team-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(
                45deg,
                transparent,
                rgba(251, 191, 36, 0.1),
                transparent
            );
            transform: rotate(45deg);
            transition: all 0.6s ease;
        }

        .team-card:hover::before {
            left: 100%;
        }

        .team-card:hover {
            transform: translateY(-10px);
            border-color: #fbbf24;
            box-shadow: 0 20px 60px rgba(251, 191, 36, 0.3);
        }

        .team-card.hidden {
            display: none;
        }

        /* Team Header */
        .team-header {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 25px;
            padding-bottom: 20px;
            border-bottom: 2px solid rgba(251, 191, 36, 0.2);
            position: relative;
            z-index: 1;
        }

        .team-logo {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            border: 3px solid #fbbf24;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
            flex-shrink: 0;
        }

        .team-info {
            flex: 1;
        }

        .team-name {
            font-size: 1.5rem;
            font-weight: bold;
            color: #fbbf24;
            margin-bottom: 5px;
        }

        .owner-name {
            font-size: 0.95rem;
            color: rgba(255, 255, 255, 0.7);
            margin-bottom: 8px;
        }

        .purse-info {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .purse-badge {
            background: rgba(34, 197, 94, 0.2);
            color: #4ade80;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            border: 1px solid rgba(34, 197, 94, 0.4);
        }

        .purse-badge.spent {
            background: rgba(239, 68, 68, 0.2);
            color: #f87171;
            border-color: rgba(239, 68, 68, 0.4);
        }

        /* Squad Stats */
        .squad-stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 20px;
            position: relative;
            z-index: 1;
        }

        .stat-item {
            background: rgba(255, 255, 255, 0.05);
            padding: 15px;
            border-radius: 12px;
            border: 1px solid rgba(251, 191, 36, 0.2);
            transition: all 0.3s ease;
        }

        .stat-item:hover {
            background: rgba(251, 191, 36, 0.1);
            border-color: #fbbf24;
            transform: scale(1.05);
        }

        .stat-label {
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.6);
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .stat-value {
            font-size: 1.8rem;
            font-weight: bold;
            color: #fbbf24;
        }

        /* Role Distribution */
        .role-distribution {
            margin-bottom: 20px;
            position: relative;
            z-index: 1;
        }

        .role-distribution h3 {
            font-size: 1rem;
            color: #fbbf24;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .role-bars {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .role-bar {
            position: relative;
        }

        .role-bar-header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 5px;
            font-size: 0.85rem;
        }

        .role-name {
            color: rgba(255, 255, 255, 0.8);
            font-weight: 600;
        }

        .role-count {
            color: #fbbf24;
            font-weight: bold;
        }

        .role-bar-bg {
            height: 8px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            overflow: hidden;
        }

        .role-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, #fbbf24 0%, #f59e0b 100%);
            border-radius: 10px;
            transition: width 0.8s ease;
            box-shadow: 0 0 10px rgba(251, 191, 36, 0.5);
        }

        /* Players List */
        .players-section {
            position: relative;
            z-index: 1;
        }

        .players-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .players-header h3 {
            font-size: 1rem;
            color: #fbbf24;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .view-toggle {
            background: rgba(251, 191, 36, 0.2);
            border: 1px solid rgba(251, 191, 36, 0.4);
            color: white;
            padding: 8px 16px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.85rem;
            transition: all 0.3s ease;
        }

        .view-toggle:hover {
            background: rgba(251, 191, 36, 0.3);
            transform: scale(1.05);
        }

        .players-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-height: 300px;
            overflow-y: auto;
            padding-right: 10px;
        }

        .players-list.expanded {
            max-height: none;
        }

        .players-list::-webkit-scrollbar {
            width: 6px;
        }

        .players-list::-webkit-scrollbar-track {
            background: rgba(255, 255, 255, 0.05);
            border-radius: 10px;
        }

        .players-list::-webkit-scrollbar-thumb {
            background: rgba(251, 191, 36, 0.5);
            border-radius: 10px;
        }

        .player-item {
            background: rgba(255, 255, 255, 0.05);
            padding: 12px;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
        }

        .player-item:hover {
            background: rgba(251, 191, 36, 0.1);
            border-color: rgba(251, 191, 36, 0.5);
            transform: translateX(5px);
        }

        .player-item.hidden {
            display: none;
        }

        .player-info {
            flex: 1;
        }

        .player-name {
            font-weight: 600;
            color: white;
            margin-bottom: 3px;
        }

        .player-role {
            font-size: 0.75rem;
            color: rgba(255, 255, 255, 0.6);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .player-price {
            background: rgba(34, 197, 94, 0.2);
            color: #4ade80;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            border: 1px solid rgba(34, 197, 94, 0.4);
            white-space: nowrap;
        }

        /* Animations */
        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: rgba(255, 255, 255, 0.6);
            grid-column: 1 / -1;
        }

        .empty-state-icon {
            font-size: 4rem;
            margin-bottom: 20px;
            opacity: 0.5;
        }

        .empty-state-text {
            font-size: 1.2rem;
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .page-header h1 {
                font-size: 2rem;
            }

            .page-header p {
                font-size: 0.95rem;
            }

            .filter-section {
                flex-direction: column;
            }

            .filter-item {
                max-width: 100%;
            }

            .teams-grid {
                grid-template-columns: 1fr;
                gap: 20px;
            }

            .team-card {
                padding: 20px;
            }

            .team-header {
                flex-direction: column;
                text-align: center;
            }

            .team-logo {
                width: 70px;
                height: 70px;
                font-size: 2rem;
            }

            .team-name {
                font-size: 1.3rem;
            }

            .squad-stats {
                grid-template-columns: repeat(2, 1fr);
                gap: 10px;
            }

            .stat-value {
                font-size: 1.5rem;
            }

            .players-list {
                max-height: 250px;
            }

            .purse-info {
                justify-content: center;
            }
        }

        @media (max-width: 480px) {
            body {
                padding: 10px;
            }

            .page-header h1 {
                font-size: 1.5rem;
            }

            .filter-section {
                padding: 15px;
            }

            .team-card {
                padding: 15px;
            }

            .squad-stats {
                grid-template-columns: 1fr;
            }
        }
    /* Add this to your existing CSS */
    .foreigner-icon {
        margin-left: 8px;
        font-size: 0.9rem;
        opacity: 0.8;
        filter: drop-shadow(0 0 4px rgba(59, 130, 246, 0.5));
        transition: all 0.3s ease;
    }

    .player-item:hover .foreigner-icon {
        opacity: 1;
        transform: scale(1.2);
        filter: drop-shadow(0 0 8px rgba(59, 130, 246, 0.8));
    }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="page-header">
            <h1>🏆 <%= @auction.name %> 🏆</h1>
            <p>Complete Squad Analysis & Player Distribution</p>
        </div>

        <!-- Filters -->
        <div class="filter-section">
            <div class="filter-item">
                <label for="teamFilter">Filter by Team</label>
                <select id="teamFilter">
                    <option value="">All Teams</option>
                </select>
            </div>
            <div class="filter-item">
                <label for="roleFilter">Filter by Role</label>
                <select id="roleFilter">
                    <option value="">All Roles</option>
                    <option value="batsman">Batsman</option>
                    <option value="bowler">Bowler</option>
                    <option value="all_rounder">All-Rounder</option>
                    <option value="wicket_keeper">Wicket-Keeper</option>
                </select>
            </div>
        </div>

        <!-- Teams Grid -->
        <div class="teams-grid" id="teamsGrid">
            <!-- Teams will be rendered here -->
        </div>
    </div>

    <script>
        const teamsData = <%= raw @teams.map { |team| 
            {
                id: team.id,
                teamName: team.team_name,
                ownerName: team.user&.username || 'Owner',
                totalPurse: team.total_purse || 0,
                remainingPurse: team.remaining_purse || 0,
                players: team.players.map { |p|
                    {
                        id: p.id,
                        name: p.name,
                        role: p.role,
                        team_name: p.team_name,
                        price: p.players_teams.where(team:)&.first.sold_price || 0,
                        bench: p.players_teams.where(team:)&.first&.bench || false,
                        foreigner: p.foreigner
                    }
                }
            }
        }.to_json %>;

        let allTeamsData = [...teamsData];

        function formatCurrency(amount) {
            if (amount === 0 || !amount) return '₹0';
            return `₹${(amount / 10000000).toFixed(2)} Cr`;
        }

        function formatRoleName(role) {
            if (!role) return 'Unknown';
            return role.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        }

        function getRoleDistribution(players) {
            const distribution = {
                batsman: 0,
                bowler: 0,
                all_rounder: 0,
                wicket_keeper: 0
            };

            players.forEach(player => {
                const role = player.role ? player.role.toLowerCase() : 'unknown';
                if (distribution.hasOwnProperty(role)) {
                    distribution[role]++;
                }
            });

            return distribution;
        }

        function calculateTotalSpent(players) {
            return players.reduce((sum, player) => sum + (player.price || 0), 0);
        }

        function renderTeamCard(team, index) {
            const roleDistribution = getRoleDistribution(team.players);
            const totalPlayers = team.players.length;
            const totalSpent = calculateTotalSpent(team.players);
            const spentPurse = team.totalPurse - team.remainingPurse;

            return `
                <div class="team-card" data-team-id="${team.id}" style="animation-delay: ${index * 0.1}s">
                    <div class="team-header">
                        <div class="team-logo">${team.teamName.charAt(0).toUpperCase()}</div>
                        <div class="team-info">
                            <div class="team-name">${team.teamName}</div>
                            <div class="owner-name">Owner: ${team.ownerName}</div>
                            <div class="purse-info">
                                <span class="purse-badge">${formatCurrency(team.remainingPurse)} Left</span>
                                <span class="purse-badge spent">${formatCurrency(spentPurse)} Spent</span>
                            </div>
                        </div>
                    </div>

                    <div class="squad-stats">
                        <div class="stat-item">
                            <div class="stat-label">Total Players</div>
                            <div class="stat-value">${totalPlayers}</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">Total Spent</div>
                            <div class="stat-value">${formatCurrency(totalSpent)}</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">Avg Price</div>
                            <div class="stat-value">${totalPlayers > 0 ? formatCurrency(totalSpent / totalPlayers) : '₹0'}</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">Squad Balance</div>
                            <div class="stat-value">${Math.min(100, Math.round((totalPlayers / 25) * 100))}%</div>
                        </div>
                    </div>

                    <div class="role-distribution">
                        <h3>Role Distribution</h3>
                        <div class="role-bars">
                            ${Object.entries(roleDistribution).map(([role, count]) => `
                                <div class="role-bar">
                                    <div class="role-bar-header">
                                        <span class="role-name">${formatRoleName(role)}</span>
                                        <span class="role-count">${count}</span>
                                    </div>
                                    <div class="role-bar-bg">
                                        <div class="role-bar-fill" style="width: ${totalPlayers > 0 ? (count / totalPlayers * 100) : 0}%"></div>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>

                    <div class="players-section">
                        <div class="players-header">
                            <h3>Squad (${totalPlayers})</h3>
                            ${totalPlayers > 5 ? `<button class="view-toggle" onclick="togglePlayers(${team.id})">Expand</button>` : ''}
                        </div>
                        <div class="players-list" id="players-${team.id}">
                            ${team.players.length > 0 ? team.players.map(player => `
                                <div class="player-item" data-role="${player.role}">
                                    <div class="player-info">
                                        <div class="player-name">${player.name}</div>
                                        ${player.foreigner ? '<span class="foreigner-icon" title="Overseas Player">✈️</span>' : ''}
                                        <div class="player-role ml-3">${formatRoleName(player.role)}</div>
                                        <div class="player-role ml-3">${player.team_name}</div>
                                    </div>
                                    <div class="player-price">${formatCurrency(player.price)}</div>
                                </div>
                            `).join('') : '<div class="empty-state"><div class="empty-state-icon">🏏</div><div class="empty-state-text">No players yet</div></div>'}
                        </div>
                    </div>
                </div>
            `;
        }

        function renderTeams() {
            const teamsGrid = document.getElementById('teamsGrid');
            
            if (allTeamsData.length === 0) {
                teamsGrid.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-state-icon">🏏</div>
                        <div class="empty-state-text">No teams found. Start building your squads!</div>
                    </div>
                `;
                return;
            }

            teamsGrid.innerHTML = allTeamsData.map((team, index) => renderTeamCard(team, index)).join('');
            populateTeamFilter();
        }

        function populateTeamFilter() {
            const teamFilter = document.getElementById('teamFilter');
            const currentValue = teamFilter.value;
            
            teamFilter.innerHTML = '<option value="">All Teams</option>';
            allTeamsData.forEach(team => {
                const option = document.createElement('option');
                option.value = team.id;
                option.textContent = team.teamName;
                teamFilter.appendChild(option);
            });
            
            teamFilter.value = currentValue;
        }

        function togglePlayers(teamId) {
            const playersList = document.getElementById(`players-${teamId}`);
            const button = event.target;
            
            if (playersList.classList.contains('expanded')) {
                playersList.classList.remove('expanded');
                button.textContent = 'Expand';
            } else {
                playersList.classList.add('expanded');
                button.textContent = 'Collapse';
            }
        }

        function applyFilters() {
            const teamFilter = document.getElementById('teamFilter').value;
            const roleFilter = document.getElementById('roleFilter').value;

            document.querySelectorAll('.team-card').forEach(card => {
                const teamId = card.getAttribute('data-team-id');
                let showTeam = true;

                // Team filter
                if (teamFilter && teamId !== teamFilter) {
                    showTeam = false;
                }

                if (showTeam) {
                    card.classList.remove('hidden');

                    // Role filter
                    if (roleFilter) {
                        const players = card.querySelectorAll('.player-item');
                        let hasVisiblePlayer = false;

                        players.forEach(playerItem => {
                            const playerRole = playerItem.getAttribute('data-role');
                            if (playerRole === roleFilter) {
                                playerItem.classList.remove('hidden');
                                hasVisiblePlayer = true;
                            } else {
                                playerItem.classList.add('hidden');
                            }
                        });

                        // Hide team if no players match role filter
                        if (!hasVisiblePlayer && roleFilter) {
                            card.classList.add('hidden');
                        }
                    } else {
                        // Show all players if no role filter
                        card.querySelectorAll('.player-item').forEach(p => p.classList.remove('hidden'));
                    }
                } else {
                    card.classList.add('hidden');
                }
            });
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', function() {
            renderTeams();
        });

        // Filters
        document.getElementById('teamFilter').addEventListener('change', applyFilters);
        document.getElementById('roleFilter').addEventListener('change', applyFilters);
    </script>
</body>
</html>
