<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fantasy Sports Contests</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .contest-card {
            margin-bottom: 15px;
        }
        .prize-breakup {
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <div class="container mt-4">
        <h1 class="mb-4 d-flex justify-content-center">Available Contests</h1>
        
        <div class="row" id="contests-container">
            <!-- Contests will be dynamically loaded here -->
        </div>
    </div>

    <script>
        const contests = [
            {
                id: 1,
                name: "Cricket Premier League",
                entryFee: 100,
                totalPrize: 10000,
                spots: 1000,
                spotsLeft: 750,
                prizes: [
                    { rank: 1, amount: 5000 },
                    { rank: 2, amount: 2000 },
                    { rank: 3, amount: 1000 }
                ]
            },
            {
                id: 2,
                name: "Football Challenge",
                entryFee: 50,
                totalPrize: 5000,
                spots: 500,
                spotsLeft: 250,
                prizes: [
                    { rank: 1, amount: 2500 },
                    { rank: 2, amount: 1500 },
                    { rank: 3, amount: 1000 }
                ]
            }
        ];

        function renderContests() {
            const container = document.getElementById('contests-container');
            container.innerHTML = contests.map(contest => `
                <div class="col-12 col-md-6 col-lg-4 mb-3">
                    <div class="card contest-card">
                        <div class="card-header">
                            <h5 class="card-title">${contest.name}</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Entry Fee:</span>
                                <span>₹${contest.entryFee}</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Total Prize Pool:</span>
                                <span>₹${contest.totalPrize}</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span>Spots Left:</span>
                                <span>${contest.spotsLeft} / ${contest.spots}</span>
                            </div>
                            
                            <div class="mt-3 prize-breakup">
                                <h6 class="fw-bold mb-2">Prize Breakup</h6>
                                ${contest.prizes.map(prize => `
                                    <div class="d-flex justify-content-between">
                                        <span>Rank ${prize.rank}</span>
                                        <span>₹${prize.amount}</span>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                        <div class="card-footer">
                            <button 
                                onclick="joinContest(${contest.id})" 
                                class="btn btn-primary w-100 ${contest.spotsLeft === 0 ? 'disabled' : ''}"
                            >
                                ${contest.spotsLeft === 0 ? 'Contest Full' : 'Join Contest'}
                            </button>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function joinContest(contestId) {
            // Placeholder for join contest logic
            alert(`Joining contest ${contestId}`);
        }

        // Render contests on page load
        renderContests();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>