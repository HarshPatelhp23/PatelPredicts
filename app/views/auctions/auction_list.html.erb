<div class="text-center mt-3">
  <%= link_to 'Back To AuctionRoom', auction_table_path, class:'btn btn-success back-button theme-btn-back' %>
</div>
<div class="container mt-4">
  <!-- Tab Navigation -->
  <ul class="nav nav-tabs justify-content-center" id="auctionTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="sold-tab" data-bs-toggle="tab" data-bs-target="#sold" type="button" role="tab" aria-controls="sold" aria-selected="true">Sold Players</button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="upcoming-tab" data-bs-toggle="tab" data-bs-target="#upcoming" type="button" role="tab" aria-controls="upcoming" aria-selected="false">Upcoming Players</button>
    </li>
  </ul>

  <div class="tab-content mt-3" id="auctionTabsContent">
    <!-- Sold Players Tab -->
    <div class="tab-pane fade show active" id="sold" role="tabpanel" aria-labelledby="sold-tab">
      <div class="table-responsive">
        <table class="table table-striped table-bordered text-center">
          <thead class="table-primary sticky-top">
            <tr>
              <th>Player Name</th>
              <th>Sold Price</th>
              <th>Sold To Team</th>
            </tr>
          </thead>
          <tbody>
            <% @sold_players.each do |player| %>
              <tr>
                <td><%= player.name %></td>
                <% if @captains.include?(player.name) %>
                  <td>
                    <%= image_tag 'captain.jpeg', class: "object-fit", alt: 'Batting', style: "width: 30px; height: 30px;" %>
                  </td>
                <% else %>
                <td>₹<%= CurrencyFormatter.format(player&.auction_room&.current_integer_amount) %></td>
                <% end %>
                <td><%= player.auction_room&.user&.username %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Upcoming Players Tab -->
    <div class="tab-pane fade" id="upcoming" role="tabpanel" aria-labelledby="upcoming-tab">
      <div class="table-responsive">
        <table class="table table-bordered text-center">
          <thead class="table-warning sticky-top">
            <tr>
              <th>Player Name</th>
              <th>
                <%= image_tag 'bat.png', class: "object-fit", alt: 'Batting', style: "width: 30px; height: 30px;" %>
              </th>
              <th>
                <%= image_tag 'bowler.png', class: "object-fit", alt: 'Bowling', style: "width: 30px; height: 30px;" %>
              </th>
            </tr>
          </thead>
          <tbody>
            <% @upcoming_players.each do |player| %>
              <tr>
                <td>
                  <% if @captains.include?(player.name) %>
                  <p>
                    <p class="fw-bold"><%= player.name %><%= image_tag 'captain.jpeg', class: "object-fit", alt: 'Batting', style: "width: 60px; height: 60px;" %></p>
                  </p>
                <% else %>
                  <p class="fw-bold"><%= player.name %></p><p><%= CurrencyFormatter.format(player.base_price) %><p>
                <% end %>
                </td>
                <td>
                  <div class="progress" style="height: 15px; width: 55px;">
                    <div
                      class="progress-bar bg-success justify-content-center"
                      role="progressbar"
                      style="width: <%= player.batting %>%"
                      aria-valuenow="<%= player.batting %>"
                      aria-valuemin="0"
                      aria-valuemax="100"
                    >
                      <%= player.batting %>%
                    </div>
                  </div>
                </td>
                <td>
                  <div class="progress" style="height: 15px; width: 55px;">
                    <div
                      class="progress-bar bg-primary"
                      role="progressbar"
                      style="width: <%= player.bowling %>%"
                      aria-valuenow="<%= player.bowling %>"
                      aria-valuemin="0"
                      aria-valuemax="100"
                    >
                      <%= player.bowling %>%
                    </div>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<style>
  .table-responsive {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .table th,
  .table td {
    white-space: nowrap;
    padding: 0.5rem;
    vertical-align: middle;
  }

  .sticky-top {
    position: sticky;
    top: 0;
    z-index: 1020;
  }

  .progress-bar {
    font-size: 12px;
    line-height: 15px;
  }
</style>
